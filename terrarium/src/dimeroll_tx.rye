//! terrarium/src/dimeroll_tx.rye -- Orbit 30: transaction language
//! integration witness
//!
//! Quest 2.1 closing gate. Proves all five verbs (plant, harvest,
//! sell, compost, note), both balance types (inventory and cash
//! flow), Mantra replay identity, and Aurora display -- a formatted
//! UART ledger report a grower could read.
//!
//! Nine transactions tell a farm story:
//!   plant tomatoes 200, plant peppers 50, harvest tomatoes 60,
//!   sell tomatoes 30 at 250, harvest peppers 25, sell peppers
//!   10 at 375, compost leaves 30, sell tomatoes 15 at 300,
//!   note rainfall 25 mm.
//!
//! Final state:
//!   Inventory: tomatoes 95, peppers 15, leaves 30
//!   Cash flow: tomatoes 12000, peppers 3750, total 15750
//!
//! SLC gate: dimeroll_tx_witness.rish runs GREEN on RV64G.

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

// =============================================================
// UART / control
// =============================================================

const uart_tx: *volatile u8 = @ptrFromInt(0x1000_0000);
const test_finisher: *volatile u32 = @ptrFromInt(
    0x0010_0000,
);
const finisher_pass: u32 = 0x5555;
const finisher_fail: u32 = 0x3333;

fn uart_putc(c: u8) void {
    uart_tx.* = c;
}

fn uart_print(s: []const u8) void {
    for (s) |c| uart_putc(c);
}

fn print_u32(v: u32) void {
    if (v == 0) {
        uart_putc('0');
        return;
    }
    var buf: [10]u8 = undefined;
    var n: u32 = v;
    var i: u32 = 0;
    while (n > 0) : (i += 1) {
        buf[i] = @intCast(n % 10 + '0');
        n /= 10;
    }
    while (i > 0) {
        i -= 1;
        uart_putc(buf[i]);
    }
}

fn print_hex(v: u32) void {
    const hex = "0123456789abcdef";
    uart_print("0x");
    var shift: u5 = 28;
    while (true) {
        const nib: u4 = @intCast(
            (v >> shift) & 0xf,
        );
        uart_putc(hex[nib]);
        if (shift == 0) break;
        shift -= 4;
    }
}

fn halt_pass() noreturn {
    test_finisher.* = finisher_pass;
    while (true) {}
}

fn halt_error(msg: []const u8) noreturn {
    uart_print("ERROR: ");
    uart_print(msg);
    test_finisher.* = finisher_fail;
    while (true) {}
}

// -- Freestanding bootstrap --
comptime {
    asm (
        \\.section .text.init,"ax"
        \\.globl _start
        \\_start:
        \\  li sp, 0x80100000
        \\  j kmain
    );
}

// =============================================================
// Region (Tally bump allocator)
// =============================================================

const Region = struct {
    buf: [*]u8,
    cap: u32,
    pos: u32,

    fn init(ptr: [*]u8, size: u32) Region {
        // invariant: region over real memory
        assert(size > 0);
        return .{
            .buf = ptr,
            .cap = size,
            .pos = 0,
        };
    }
};

// =============================================================
// Djb2 hash
// =============================================================

fn djb2(data: []const u8) u32 {
    var h: u32 = 5381;
    for (data) |c| {
        h = h *% 33 +% c;
    }
    return h;
}

// =============================================================
// Identity (Kumara signing)
// =============================================================

const seed_length: u32 = 32;

const Identity = struct {
    seed: [seed_length]u8,

    fn init(s: [seed_length]u8) Identity {
        return .{ .seed = s };
    }

    fn sign(self: *const Identity, msg: []const u8) u32 {
        var h: u32 = djb2(&self.seed);
        for (msg) |c| {
            h = h *% 33 +% c;
        }
        return h;
    }
};

// =============================================================
// MantraLog (append-only signed fact log)
// =============================================================

const max_facts: u32 = 32;

const MantraLog = struct {
    region: *Region,
    identity: *const Identity,
    count: u32,
    state_hash: u32,

    fn init(
        r: *Region,
        id: *const Identity,
    ) MantraLog {
        return .{
            .region = r,
            .identity = id,
            .count = 0,
            .state_hash = 0,
        };
    }

    fn append(self: *MantraLog, fact: []const u8) void {
        // invariant: log not full
        assert(self.count < max_facts);
        // invariant: fact fits in region
        assert(
            fact.len <= self.region.cap - self.region.pos,
        );

        const sig = self.identity.sign(fact);
        self.state_hash = self.state_hash *% 31 +% sig;
        self.region.pos += @intCast(fact.len);
        self.count += 1;
    }
};

// =============================================================
// GlowVerb enum and TransactionRecord
// =============================================================

const GlowVerb = enum(u8) {
    plant = 0,
    harvest = 1,
    sell = 2,
    compost = 3,
    note = 4,
};

fn verb_name(v: GlowVerb) []const u8 {
    return switch (v) {
        .plant => "plant",
        .harvest => "harvest",
        .sell => "sell",
        .compost => "compost",
        .note => "note",
    };
}

const TransactionRecord = struct {
    verb: GlowVerb,
    subject: []const u8,
    qty: u32,
    unit: []const u8,
    price_cents: u32,
    has_unit: bool,
    has_price: bool,
};

// =============================================================
// Fact builder
// =============================================================

const fact_buf_size: u32 = 128;
var fact_buf: [fact_buf_size]u8 = undefined;

fn buf_append_str(pos: *u32, s: []const u8) void {
    for (s) |c| {
        // invariant: buffer not full
        assert(pos.* < fact_buf_size);
        fact_buf[pos.*] = c;
        pos.* += 1;
    }
}

fn buf_append_u32(pos: *u32, v: u32) void {
    if (v == 0) {
        assert(pos.* < fact_buf_size);
        fact_buf[pos.*] = '0';
        pos.* += 1;
        return;
    }
    var tmp: [10]u8 = undefined;
    var n: u32 = v;
    var i: u32 = 0;
    while (n > 0) : (i += 1) {
        tmp[i] = @intCast(n % 10 + '0');
        n /= 10;
    }
    while (i > 0) {
        i -= 1;
        assert(pos.* < fact_buf_size);
        fact_buf[pos.*] = tmp[i];
        pos.* += 1;
    }
}

fn build_fact(
    txn: *const TransactionRecord,
) []const u8 {
    var pos: u32 = 0;

    buf_append_str(&pos, verb_name(txn.verb));
    buf_append_str(&pos, ":");
    buf_append_str(&pos, txn.subject);
    buf_append_str(&pos, "=qty=");
    buf_append_u32(&pos, txn.qty);

    if (txn.has_unit) {
        buf_append_str(&pos, ",unit=");
        buf_append_str(&pos, txn.unit);
    }

    if (txn.has_price) {
        buf_append_str(&pos, ",price=");
        buf_append_u32(&pos, txn.price_cents);
    }

    // invariant: message fits in buffer
    assert(pos <= fact_buf_size);
    return fact_buf[0..pos];
}

// =============================================================
// InventoryTable
// =============================================================

const max_subjects: u32 = 8;
const max_name_len: u32 = 16;

const InventoryEntry = struct {
    name_buf: [max_name_len]u8,
    name_len: u32,
    balance: u32,
    active: bool,
};

fn entry_matches(
    e: *const InventoryEntry,
    name: []const u8,
) bool {
    if (!e.active) return false;
    // invariant: stored name within buffer
    assert(e.name_len <= max_name_len);
    const nlen: u32 = @intCast(name.len);
    if (e.name_len != nlen) return false;
    var j: u32 = 0;
    while (j < e.name_len) : (j += 1) {
        if (e.name_buf[j] != name[j]) return false;
    }
    return true;
}

const InventoryTable = struct {
    entries: [max_subjects]InventoryEntry,
    count: u32,

    fn init() InventoryTable {
        var t: InventoryTable = undefined;
        t.count = 0;
        var i: u32 = 0;
        while (i < max_subjects) : (i += 1) {
            t.entries[i].active = false;
            t.entries[i].balance = 0;
            t.entries[i].name_len = 0;
        }
        return t;
    }

    fn find_or_create(
        self: *InventoryTable,
        name: []const u8,
    ) *InventoryEntry {
        // invariant: name fits in entry buffer
        assert(name.len <= max_name_len);
        // invariant: name is non-empty
        assert(name.len > 0);

        var i: u32 = 0;
        while (i < self.count) : (i += 1) {
            if (entry_matches(
                &self.entries[i],
                name,
            )) return &self.entries[i];
        }

        // invariant: table has capacity
        assert(self.count < max_subjects);
        const slot = &self.entries[self.count];
        slot.active = true;
        slot.name_len = @intCast(name.len);
        var k: u32 = 0;
        while (k < name.len) : (k += 1) {
            slot.name_buf[k] = name[k];
        }
        slot.balance = 0;
        self.count += 1;
        return slot;
    }

    fn apply(
        self: *InventoryTable,
        txn: *const TransactionRecord,
    ) void {
        switch (txn.verb) {
            .plant, .compost => {
                const e = self.find_or_create(
                    txn.subject,
                );
                e.balance += txn.qty;
            },
            .harvest, .sell => {
                const e = self.find_or_create(
                    txn.subject,
                );
                // invariant: no underflow
                assert(e.balance >= txn.qty);
                e.balance -= txn.qty;
            },
            .note => {},
        }
    }

    fn balance_of(
        self: *const InventoryTable,
        name: []const u8,
    ) u32 {
        var i: u32 = 0;
        while (i < self.count) : (i += 1) {
            if (entry_matches(
                &self.entries[i],
                name,
            )) return self.entries[i].balance;
        }
        return 0;
    }

    fn entry_name(
        self: *const InventoryTable,
        idx: u32,
    ) []const u8 {
        // invariant: valid index
        assert(idx < self.count);
        const e = &self.entries[idx];
        return e.name_buf[0..e.name_len];
    }
};

// =============================================================
// CashFlowTable
// =============================================================

const CashFlowEntry = struct {
    name_buf: [max_name_len]u8,
    name_len: u32,
    revenue: u32,
    active: bool,
};

fn cashflow_entry_matches(
    e: *const CashFlowEntry,
    name: []const u8,
) bool {
    if (!e.active) return false;
    // invariant: stored name within buffer
    assert(e.name_len <= max_name_len);
    const nlen: u32 = @intCast(name.len);
    if (e.name_len != nlen) return false;
    var j: u32 = 0;
    while (j < e.name_len) : (j += 1) {
        if (e.name_buf[j] != name[j]) return false;
    }
    return true;
}

const CashFlowTable = struct {
    entries: [max_subjects]CashFlowEntry,
    count: u32,
    total_revenue: u32,

    fn init() CashFlowTable {
        var t: CashFlowTable = undefined;
        t.count = 0;
        t.total_revenue = 0;
        var i: u32 = 0;
        while (i < max_subjects) : (i += 1) {
            t.entries[i].active = false;
            t.entries[i].revenue = 0;
            t.entries[i].name_len = 0;
        }
        return t;
    }

    fn find_or_create(
        self: *CashFlowTable,
        name: []const u8,
    ) *CashFlowEntry {
        // invariant: name fits in entry buffer
        assert(name.len <= max_name_len);
        // invariant: name is non-empty
        assert(name.len > 0);

        var i: u32 = 0;
        while (i < self.count) : (i += 1) {
            if (cashflow_entry_matches(
                &self.entries[i],
                name,
            )) return &self.entries[i];
        }

        // invariant: table has capacity
        assert(self.count < max_subjects);
        const slot = &self.entries[self.count];
        slot.active = true;
        slot.name_len = @intCast(name.len);
        var k: u32 = 0;
        while (k < name.len) : (k += 1) {
            slot.name_buf[k] = name[k];
        }
        slot.revenue = 0;
        self.count += 1;
        return slot;
    }

    fn apply(
        self: *CashFlowTable,
        txn: *const TransactionRecord,
    ) void {
        switch (txn.verb) {
            .sell => {
                const e = self.find_or_create(
                    txn.subject,
                );
                const income = txn.qty *% txn.price_cents;
                e.revenue += income;
                self.total_revenue += income;
            },
            else => {},
        }
    }

    fn revenue_of(
        self: *const CashFlowTable,
        name: []const u8,
    ) u32 {
        var i: u32 = 0;
        while (i < self.count) : (i += 1) {
            if (cashflow_entry_matches(
                &self.entries[i],
                name,
            )) return self.entries[i].revenue;
        }
        return 0;
    }

    fn entry_name(
        self: *const CashFlowTable,
        idx: u32,
    ) []const u8 {
        // invariant: valid index
        assert(idx < self.count);
        const e = &self.entries[idx];
        return e.name_buf[0..e.name_len];
    }
};

