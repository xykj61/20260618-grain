// -- Expected final balances --
const expect_inv_tomatoes: u32 = 95;
const expect_inv_peppers: u32 = 15;
const expect_inv_leaves: u32 = 30;
const expect_inv_subjects: u32 = 3;

const expect_rev_tomatoes: u32 = 12000;
const expect_rev_peppers: u32 = 3750;
const expect_rev_total: u32 = 15750;
const expect_cash_subjects: u32 = 2;

// -- Proof counter --
var proof_count: u32 = 0;
var proof_pass: u32 = 0;

fn check(name: []const u8, ok: bool) void {
    proof_count += 1;
    uart_print("  ");
    uart_print(name);
    if (ok) {
        uart_print(" PASS\n");
        proof_pass += 1;
    } else {
        uart_print(" FAIL\n");
    }
}

fn str_eq(a: []const u8, b: []const u8) bool {
    if (a.len != b.len) return false;
    var i: u32 = 0;
    while (i < a.len) : (i += 1) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

// -- Memory layout --
const log_region_base: u32 = 0x80180000;
const log_region_budget: u32 = 4096;
const replay_region_base: u32 = 0x80190000;
const replay_region_budget: u32 = 4096;

// -- Kumara seed --
const seed: [seed_length]u8 = .{
    0x4B, 0x75, 0x6D, 0x61, 0x72, 0x61, 0x20, 0x73,
    0x65, 0x65, 0x64, 0x20, 0x66, 0x6F, 0x72, 0x20,
    0x66, 0x72, 0x65, 0x65, 0x73, 0x74, 0x61, 0x6E,
    0x64, 0x69, 0x6E, 0x67, 0x20, 0x52, 0x56, 0x49,
};

// =============================================================
// Aurora display -- formatted ledger report
// =============================================================
//
// Prints a human-readable ledger page to UART: a transaction
// journal, an inventory summary, and a cash flow summary.
// This is what a grower sees on their screen.

fn aurora_hr() void {
    uart_print(
        "+-------+----------+-----+------+-------+\n",
    );
}

fn aurora_pad(s: []const u8, width: u32) void {
    uart_print(s);
    if (s.len < width) {
        var rem: u32 = width - @as(u32, @intCast(s.len));
        while (rem > 0) : (rem -= 1) {
            uart_putc(' ');
        }
    }
}

fn aurora_pad_num(v: u32, width: u32) void {
    // right-align number in field
    var tmp: [10]u8 = undefined;
    var n: u32 = v;
    var digits: u32 = 0;
    if (n == 0) {
        digits = 1;
        tmp[0] = '0';
    } else {
        while (n > 0) : (digits += 1) {
            tmp[digits] = @intCast(n % 10 + '0');
            n /= 10;
        }
    }
    if (digits < width) {
        var pad: u32 = width - digits;
        while (pad > 0) : (pad -= 1) {
            uart_putc(' ');
        }
    }
    var i: u32 = digits;
    while (i > 0) {
        i -= 1;
        uart_putc(tmp[i]);
    }
}

fn aurora_display_transactions() void {
    uart_print("\n");
    uart_print(
        "  DIMEROLL FIELD LEDGER\n",
    );
    uart_print(
        "  Transaction Journal\n\n",
    );
    uart_print(
        "| #  | verb    | subject  |  qty | price |\n",
    );
    uart_print(
        "|----|---------|----------|------|-------|\n",
    );

    var i: u32 = 0;
    while (i < txn_count) : (i += 1) {
        const txn = &transactions[i];
        uart_print("| ");
        aurora_pad_num(i + 1, 2);
        uart_print(" | ");
        aurora_pad(verb_name(txn.verb), 7);
        uart_print(" | ");
        aurora_pad(txn.subject, 8);
        uart_print(" | ");
        aurora_pad_num(txn.qty, 4);
        uart_print(" | ");
        if (txn.has_price) {
            aurora_pad_num(txn.price_cents, 5);
        } else {
            uart_print("    -");
        }
        uart_print(" |\n");
    }

    uart_print(
        "|----|---------|----------|------|-------|\n",
    );
    uart_print("  9 transactions, 5 verbs\n");
}

fn aurora_display_inventory(
    inv: *const InventoryTable,
) void {
    uart_print("\n");
    uart_print("  Inventory on Hand\n\n");
    uart_print(
        "| subject  | balance |\n",
    );
    uart_print(
        "|----------|---------|\n",
    );

    var i: u32 = 0;
    while (i < inv.count) : (i += 1) {
        uart_print("| ");
        aurora_pad(inv.entry_name(i), 8);
        uart_print(" | ");
        aurora_pad_num(inv.entries[i].balance, 7);
        uart_print(" |\n");
    }

    uart_print(
        "|----------|---------|\n",
    );
    uart_print("  ");
    print_u32(inv.count);
    uart_print(" subjects\n");
}

fn aurora_display_cashflow(
    cash: *const CashFlowTable,
) void {
    uart_print("\n");
    uart_print("  Cash Flow Summary\n\n");
    uart_print(
        "| subject  | revenue |\n",
    );
    uart_print(
        "|----------|---------|\n",
    );

    var i: u32 = 0;
    while (i < cash.count) : (i += 1) {
        uart_print("| ");
        aurora_pad(cash.entry_name(i), 8);
        uart_print(" | ");
        aurora_pad_num(
            cash.entries[i].revenue,
            7,
        );
        uart_print(" |\n");
    }

    uart_print(
        "|----------|---------|\n",
    );
    uart_print("| TOTAL    | ");
    aurora_pad_num(cash.total_revenue, 7);
    uart_print(" |\n");
    uart_print(
        "|----------|---------|\n",
    );
}

// =============================================================
// Main
// =============================================================

export fn kmain() callconv(.c) noreturn {
    uart_print("DIMEROLL TRANSACTION LANGUAGE");
    uart_print(" -- Orbit 30\n");
    uart_print(
        "Quest 2.1 closing gate, RV64G under Mantra\n\n",
    );

    const identity = Identity.init(seed);

    // Primary Mantra log
    var log_region = Region.init(
        @ptrFromInt(log_region_base),
        log_region_budget,
    );
    var log = MantraLog.init(
        &log_region,
        &identity,
    );

    // Two views of the same log
    var inv = InventoryTable.init();
    var cash = CashFlowTable.init();

    // =========================================================
    // PROOF 1: PROCESS TRANSACTIONS
    // =========================================================
    uart_print(
        "-- PROOF 1: PROCESS TRANSACTIONS --\n\n",
    );

    var facts_logged: u32 = 0;
    var verbs_seen: [5]bool = .{
        false, false, false, false, false,
    };
    var ti: u32 = 0;
    while (ti < txn_count) : (ti += 1) {
        const txn = &transactions[ti];
        const fact = build_fact(txn);

        uart_print("[");
        print_u32(ti + 1);
        uart_print("] (");
        uart_print(verb_name(txn.verb));
        uart_print(" ");
        uart_print(txn.subject);
        uart_print(" ");
        print_u32(txn.qty);
        if (txn.has_unit) {
            uart_print(" ");
            uart_print(txn.unit);
        }
        if (txn.has_price) {
            uart_print(" ");
            print_u32(txn.price_cents);
        }
        uart_print(")\n");

        uart_print("  fact: ");
        uart_print(fact);
        uart_print("\n");

        check(
            "fact_encoding",
            str_eq(fact, expected_facts[ti]),
        );

        log.append(fact);
        facts_logged += 1;

        // Track verb coverage
        verbs_seen[@intFromEnum(txn.verb)] = true;

        inv.apply(txn);
        cash.apply(txn);

        if (txn.verb != .note) {
            uart_print("  inv -> ");
            uart_print(txn.subject);
            uart_print(": ");
            print_u32(
                inv.balance_of(txn.subject),
            );
            uart_print("\n");
        } else {
            uart_print(
                "  (no inventory effect)\n",
            );
        }

        if (txn.verb == .sell) {
            uart_print("  rev -> ");
            uart_print(txn.subject);
            uart_print(": ");
            print_u32(
                cash.revenue_of(txn.subject),
            );
            uart_print(" (total ");
            print_u32(cash.total_revenue);
            uart_print(")\n");
        }

        uart_print("\n");
    }

    // =========================================================
    // PROOF 2: FACT COUNT AND VERB COVERAGE
    // =========================================================
    uart_print(
        "-- PROOF 2: FACTS AND VERB COVERAGE --\n",
    );
    uart_print("facts logged: ");
    print_u32(facts_logged);
    uart_print("/");
    print_u32(txn_count);
    uart_print("\n");
    check(
        "all_facts_logged",
        facts_logged == txn_count,
    );
    check("log_count", log.count == txn_count);

    // All five verbs exercised
    var all_verbs: bool = true;
    var vi: u32 = 0;
    while (vi < 5) : (vi += 1) {
        if (!verbs_seen[vi]) all_verbs = false;
    }
    check("all_five_verbs", all_verbs);
    uart_print("\n");

    // =========================================================
    // PROOF 3: INVENTORY BALANCES
    // =========================================================
    uart_print(
        "-- PROOF 3: INVENTORY BALANCES --\n",
    );

    uart_print("tomatoes: ");
    print_u32(inv.balance_of("tomatoes"));
    uart_print(
        " (4 txns: +200 -60 -30 -15)\n",
    );
    check(
        "inv_tomatoes_95",
        inv.balance_of("tomatoes") ==
            expect_inv_tomatoes,
    );

    uart_print("peppers: ");
    print_u32(inv.balance_of("peppers"));
    uart_print(" (3 txns: +50 -25 -10)\n");
    check(
        "inv_peppers_15",
        inv.balance_of("peppers") ==
            expect_inv_peppers,
    );

    uart_print("leaves: ");
    print_u32(inv.balance_of("leaves"));
    uart_print(" (1 txn: +30)\n");
    check(
        "inv_leaves_30",
        inv.balance_of("leaves") ==
            expect_inv_leaves,
    );

    uart_print(
        "rainfall: (no entry -- note verb)\n",
    );
    check(
        "inv_no_rainfall",
        inv.balance_of("rainfall") == 0,
    );

    uart_print("inv subjects: ");
    print_u32(inv.count);
    uart_print("\n");
    check(
        "inv_subject_count",
        inv.count == expect_inv_subjects,
    );

    uart_print("\n");

    // =========================================================
    // PROOF 4: CASH FLOW BALANCES
    // =========================================================
    uart_print(
        "-- PROOF 4: CASH FLOW BALANCES --\n",
    );

    uart_print("tomatoes revenue: ");
    print_u32(cash.revenue_of("tomatoes"));
    uart_print(
        " (2 sells: 30*250 + 15*300)\n",
    );
    check(
        "rev_tomatoes_12000",
        cash.revenue_of("tomatoes") ==
            expect_rev_tomatoes,
    );

    uart_print("peppers revenue: ");
    print_u32(cash.revenue_of("peppers"));
    uart_print(" (1 sell: 10*375)\n");
    check(
        "rev_peppers_3750",
        cash.revenue_of("peppers") ==
            expect_rev_peppers,
    );

    uart_print("cash subjects: ");
    print_u32(cash.count);
    uart_print("\n");
    check(
        "cash_subject_count",
        cash.count == expect_cash_subjects,
    );

    uart_print("total revenue: ");
    print_u32(cash.total_revenue);
    uart_print("\n");
    check(
        "total_revenue_15750",
        cash.total_revenue == expect_rev_total,
    );

    uart_print("\n");

    // =========================================================
    // PROOF 5: MANTRA STATE
    // =========================================================
    uart_print("-- PROOF 5: MANTRA STATE --\n");
    uart_print("state hash: ");
    print_hex(log.state_hash);
    uart_print("\n");
    uart_print("facts: ");
    print_u32(log.count);
    uart_print("\n");
    uart_print("tally: ");
    print_u32(log_region.pos);
    uart_print(" of ");
    print_u32(log_region_budget);
    uart_print(" bytes\n");
    // invariant: allocation bounded
    assert(log_region.pos <= log_region_budget);
    check(
        "bounded",
        log_region.pos <= log_region_budget,
    );
    uart_print("\n");

    // Capture primary state for replay comparison
    const primary_hash = log.state_hash;
    const primary_count = log.count;
    const primary_tally = log_region.pos;
    const p_inv_tom = inv.balance_of("tomatoes");
    const p_inv_pep = inv.balance_of("peppers");
    const p_inv_lea = inv.balance_of("leaves");
    const p_rev_tom = cash.revenue_of("tomatoes");
    const p_rev_pep = cash.revenue_of("peppers");

    // =========================================================
    // PROOF 6: REPLAY IDENTITY
    // =========================================================
    uart_print(
        "-- PROOF 6: REPLAY IDENTITY --\n",
    );

    var replay_region = Region.init(
        @ptrFromInt(replay_region_base),
        replay_region_budget,
    );
    var replay_log = MantraLog.init(
        &replay_region,
        &identity,
    );
    var replay_inv = InventoryTable.init();
    var replay_cash = CashFlowTable.init();

    var ri: u32 = 0;
    while (ri < txn_count) : (ri += 1) {
        const fact = build_fact(&transactions[ri]);
        replay_log.append(fact);
        replay_inv.apply(&transactions[ri]);
        replay_cash.apply(&transactions[ri]);
    }

    uart_print("primary hash:  ");
    print_hex(primary_hash);
    uart_print("\n");
    uart_print("replay hash:   ");
    print_hex(replay_log.state_hash);
    uart_print("\n");

    const hm = primary_hash ==
        replay_log.state_hash;
    check("replay_hash_match", hm);
    check(
        "replay_count_match",
        primary_count == replay_log.count,
    );
    check(
        "replay_tally_match",
        primary_tally == replay_region.pos,
    );

    check(
        "replay_inv_tomatoes",
        replay_inv.balance_of("tomatoes") ==
            p_inv_tom,
    );
    check(
        "replay_inv_peppers",
        replay_inv.balance_of("peppers") ==
            p_inv_pep,
    );
    check(
        "replay_inv_leaves",
        replay_inv.balance_of("leaves") ==
            p_inv_lea,
    );

    check(
        "replay_rev_tomatoes",
        replay_cash.revenue_of("tomatoes") ==
            p_rev_tom,
    );
    check(
        "replay_rev_peppers",
        replay_cash.revenue_of("peppers") ==
            p_rev_pep,
    );

    if (hm) {
        uart_print(
            "REPLAY MATCHES:" ++
                " identical state proven\n",
        );
    }
    uart_print("\n");

    // =========================================================
    // PROOF 7: AURORA DISPLAY
    // =========================================================
    uart_print(
        "-- PROOF 7: AURORA DISPLAY --\n",
    );

    aurora_display_transactions();
    check(
        "aurora_transactions",
        facts_logged == txn_count,
    );

    aurora_display_inventory(&inv);
    check(
        "aurora_inventory",
        inv.count == expect_inv_subjects,
    );

    aurora_display_cashflow(&cash);
    check(
        "aurora_cashflow",
        cash.total_revenue == expect_rev_total,
    );

    uart_print("\n");

    // =========================================================
    // VERDICT
    // =========================================================
    uart_print("==============================\n");
    uart_print("proofs: ");
    print_u32(proof_pass);
    uart_print("/");
    print_u32(proof_count);
    uart_print("\n");

    if (proof_pass == proof_count) {
        uart_print("ALL PROOFS PASSED\n");
        uart_print(
            "correct: Quest 2.1 complete" ++
                " -- all verbs, both balances," ++
                " replay, Aurora\n",
        );
        uart_print("Orbit 30 complete\n");
    } else {
        halt_error("SOME PROOFS FAILED\n");
    }

    halt_pass();
}
