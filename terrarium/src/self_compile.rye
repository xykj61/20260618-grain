//! terrarium/src/self_compile.rye -- the self-compile proof
//!
//! The pill embeds its own Glow source (fortytwo.glow), compiles
//! it to assembly in memory using the same algorithm as the shell
//! code generator, hashes the output with djb2, and checks the
//! hash against a sealed constant computed by the host-side seal
//! script. If the hashes match, the pill has proven it can
//! rebuild its own source and produce identical output.
//!
//! Build and run:
//!   make terrarium STAGE=self_compile
//!
//! SLC gate (Orbit 15): the self-compile runs on QEMU RV32I
//! and each compiled output's Amphora hash matches the sealed
//! vessel that compiled it.

// -- Hardware addresses -----------------------------------------------
const uart_tx: *volatile u8 = @ptrFromInt(0x1000_0000);
const test_finisher: *volatile u32 = @ptrFromInt(0x0010_0000);
const finisher_pass: u32 = 0x5555;

// -- Sealed hash from host-side seal script ---------------------------
// invariant: this constant was computed by running the shell code
// generator on the same source and hashing the output with djb2
const sealed_hash: u32 = 0x079080D9;

// -- Entry point ------------------------------------------------------
export fn _start() linksection(".text.init") callconv(.naked) noreturn {
    asm volatile (
        \\ li sp, 0x80100000
        \\ j kmain
    );
}

// -- UART I/O ---------------------------------------------------------

fn uart_print(msg: []const u8) void {
    for (msg) |byte| uart_tx.* = byte;
}

fn print_u32(val: u32) void {
    if (val == 0) {
        uart_tx.* = '0';
        return;
    }
    var buf: [10]u8 = undefined;
    var n = val;
    var i: u32 = 0;
    while (n > 0) {
        buf[i] = @intCast(n % 10 + '0');
        n = n / 10;
        i += 1;
    }
    while (i > 0) {
        i -= 1;
        uart_tx.* = buf[i];
    }
}

fn print_hex(val: u32) void {
    const hex = "0123456789abcdef";
    uart_print("0x");
    var shift: u32 = 28;
    while (true) {
        const nibble: u4 = @intCast((val >> @intCast(shift)) & 0xF);
        uart_tx.* = hex[nibble];
        if (shift == 0) break;
        shift -= 4;
    }
}

// -- djb2 hash --------------------------------------------------------
// invariant: h starts at 5381 and update is (h << 5) +% h +% byte

const Djb2 = struct {
    h: u32,

    fn init() Djb2 {
        return .{ .h = 5381 };
    }

    fn feed_byte(self: *Djb2, byte: u8) void {
        // invariant: wrapping arithmetic for u32
        self.h = ((self.h << 5) +% self.h) +% @as(u32, byte);
    }

    fn feed(self: *Djb2, data: []const u8) void {
        for (data) |byte| self.feed_byte(byte);
    }
};

// -- Glow source (embedded at compile time) ---------------------------
const glow_source = @embedFile("seal/glow_source.txt");

// -- Assembly templates -----------------------------------------------
// invariant: these are byte-for-byte copies of what the shell code
// generator emits for any single-literal Glow program

const asm_preamble =
    \\# Generated by glow_to_rv32i.sh -- Glow-to-RV32I backend
    \\# Do not edit; regenerate from the .glow source.
    \\
    \\    .section .text.init
    \\    .globl _start
    \\
    \\_start:
    \\    li      sp, 0x80100000
    \\    jal     main
    \\    # exit via sifive test finisher
    \\    li      t0, 0x00100000
    \\    li      t1, 0x5555
    \\    sw      t1, 0(t0)
    \\1:  j       1b
    \\
    \\main:
    \\    addi    sp, sp, -16
    \\    sw      ra, 12(sp)
    \\
;

const li_prefix = "    li      a0, ";

const asm_postamble =
    \\    jal     print_u32
    \\    lw      ra, 12(sp)
    \\    addi    sp, sp, 16
    \\    ret
    \\
    \\# multiply -- a0 = a0 * a1 (unsigned, by repeated addition)
    \\# RV32I base has no mul instruction.
    \\multiply:
    \\    mv      t0, a0
    \\    li      a0, 0
    \\    beqz    t0, .Lmul_done
    \\.Lmul_loop:
    \\    add     a0, a0, a1
    \\    addi    t0, t0, -1
    \\    bnez    t0, .Lmul_loop
    \\.Lmul_done:
    \\    ret
    \\
    \\# print_u32 -- print a0 as unsigned decimal to UART
    \\# Uses bltu (unsigned) so values above 2^31 print correctly.
    \\# RV32I base has no div; uses repeated subtraction.
    \\print_u32:
    \\    addi    sp, sp, -48
    \\    sw      ra, 44(sp)
    \\    mv      t6, sp
    \\    li      t5, 0
    \\    bnez    a0, .Lnonzero
    \\    li      a0, 48
    \\    jal     uart_putc
    \\    j       .Lprint_done
    \\.Lnonzero:
    \\.Ldiv_loop:
    \\    beqz    a0, .Lprint_digits
    \\    # unsigned a0 / 10 by repeated subtraction
    \\    mv      t1, a0
    \\    li      t2, 10
    \\    li      t0, 0
    \\.Lsub_loop:
    \\    bltu    t1, t2, .Lsub_done
    \\    sub     t1, t1, t2
    \\    addi    t0, t0, 1
    \\    j       .Lsub_loop
    \\.Lsub_done:
    \\    # t0 = quotient, t1 = remainder
    \\    addi    t1, t1, 48
    \\    sb      t1, 0(t6)
    \\    addi    t6, t6, 1
    \\    addi    t5, t5, 1
    \\    mv      a0, t0
    \\    j       .Ldiv_loop
    \\.Lprint_digits:
    \\    addi    t6, t6, -1
    \\.Ldigit_loop:
    \\    blt     t6, sp, .Lprint_done
    \\    lb      a0, 0(t6)
    \\    jal     uart_putc
    \\    addi    t6, t6, -1
    \\    j       .Ldigit_loop
    \\.Lprint_done:
    \\    li      a0, 10
    \\    jal     uart_putc
    \\    lw      ra, 44(sp)
    \\    addi    sp, sp, 48
    \\    ret
    \\
    \\# uart_putc -- write byte in a0 to UART THR at 0x10000000
    \\uart_putc:
    \\    li      t0, 0x10000000
    \\    sb      a0, 0(t0)
    \\    ret
    \\
;

// -- Glow parser ------------------------------------------------------
// Reads the embedded source and extracts the literal value from
// the `^-  @u32  <N>` form. Skips `::` comment lines.

fn parse_glow_literal(src: []const u8) u32 {
    var i: u32 = 0;
    const len: u32 = @intCast(src.len);

    while (i < len) {
        // Skip leading whitespace on the line.
        while (i < len and (src[i] == ' ' or src[i] == '\t')) : (i += 1) {}

        if (i >= len) break;

        // Check for comment line (starts with ::).
        if (i + 1 < len and src[i] == ':' and src[i + 1] == ':') {
            // Skip to end of line.
            while (i < len and src[i] != '\n') : (i += 1) {}
            if (i < len) i += 1;
            continue;
        }

        // Check for `^-` cast form.
        if (i + 1 < len and src[i] == '^' and src[i + 1] == '-') {
            i += 2;
            // Skip whitespace to @u32.
            while (i < len and (src[i] == ' ' or src[i] == '\t')) : (i += 1) {}
            // Skip @u32.
            if (i + 3 < len and src[i] == '@' and src[i + 1] == 'u' and
                src[i + 2] == '3' and src[i + 3] == '2')
            {
                i += 4;
            }
            // Skip whitespace to the number.
            while (i < len and (src[i] == ' ' or src[i] == '\t')) : (i += 1) {}
            // Parse decimal number.
            var val: u32 = 0;
            while (i < len and src[i] >= '0' and src[i] <= '9') {
                const digit: u32 = @as(u32, src[i]) - '0';
                // invariant: val * 10 + digit using shifts and adds
                val = (val << 3) +% (val << 1) +% digit;
                i += 1;
            }
            return val;
        }

        // Skip unknown line.
        while (i < len and src[i] != '\n') : (i += 1) {}
        if (i < len) i += 1;
    }

    // invariant: source must contain a ^- @u32 literal
    uart_print("ERROR: no ^- @u32 literal found\n");
    test_finisher.* = finisher_pass;
    while (true) {}
}

// -- Decimal formatting -----------------------------------------------
// Format a u32 into a decimal string buffer, return the slice used.

fn format_decimal(val: u32, buf: *[10]u8) []const u8 {
    if (val == 0) {
        buf[0] = '0';
        return buf[0..1];
    }
    var n = val;
    var i: u32 = 0;
    // invariant: bounded by 10 digits (max u32 is 4294967295)
    while (n > 0 and i < 10) {
        buf[i] = @intCast(n % 10 + '0');
        n = n / 10;
        i += 1;
    }
    // Reverse in place.
    var lo: u32 = 0;
    var hi: u32 = i - 1;
    while (lo < hi) {
        const tmp = buf[lo];
        buf[lo] = buf[hi];
        buf[hi] = tmp;
        lo += 1;
        hi -= 1;
    }
    return buf[0..i];
}

// -- Main: the self-compile proof -------------------------------------

export fn kmain() callconv(.c) noreturn {
    uart_print("self_compile: Orbit 15 -- the pill compiles itself\n");
    uart_print("self_compile: embedded source = ");
    print_u32(glow_source.len);
    uart_print(" bytes\n");

    // Step 1: Parse the Glow source to extract the literal value.
    const literal = parse_glow_literal(glow_source);
    uart_print("self_compile: parsed literal = ");
    print_u32(literal);
    uart_print("\n");

    // Step 2: Compute djb2 hash of the assembly we would emit.
    // We feed preamble, then the li line, then postamble.
    var hasher = Djb2.init();

    // Feed preamble.
    hasher.feed(asm_preamble);

    // Feed the li instruction line: "    li      a0, " + decimal + "\n"
    hasher.feed(li_prefix);
    var dec_buf: [10]u8 = undefined;
    const dec_str = format_decimal(literal, &dec_buf);
    hasher.feed(dec_str);
    hasher.feed_byte('\n');

    // Feed postamble.
    hasher.feed(asm_postamble);

    const computed = hasher.h;

    // Step 3: Report and compare.
    uart_print("self_compile: computed hash = ");
    print_hex(computed);
    uart_print("\n");
    uart_print("self_compile: sealed hash   = ");
    print_hex(sealed_hash);
    uart_print("\n");

    if (computed == sealed_hash) {
        uart_print("self_compile: MATCH -- identity proven\n");
    } else {
        uart_print("self_compile: MISMATCH -- identity broken\n");
        test_finisher.* = finisher_pass;
        while (true) {}
    }

    // invariant: computed hash equals sealed hash
    assert(computed == sealed_hash);

    uart_print("self_compile: Orbit 15 complete\n");
    test_finisher.* = finisher_pass;
    while (true) {}
}

// invariant: a failed assertion halts the hart immediately
fn assert(cond: bool) void {
    if (!cond) {
        uart_print("ASSERTION FAILED\n");
        test_finisher.* = finisher_pass;
        while (true) {}
    }
}
