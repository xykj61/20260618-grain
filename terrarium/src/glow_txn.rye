// terrarium/src/glow_txn.rye
//
// Orbit 26 -- Glow transaction grammar
//
// The Glow evaluator grows from arithmetic expressions to
// transactions. Five verbs name the acts a field ledger records:
//   plant, harvest, sell, compost, note
//
// Surface form: (verb subject quantity [unit] [price])
// Each parses to a TransactionRecord with bounded fields.
//
// SLC gate: Glow parses 5 transaction forms and prints
// their fields on Aurora.
//
// TAME order: Safety (fields bounded at 16 bytes) ->
// Visibility (Aurora prints each field) -> Replay (Mantra log)

const std = @import("std");
const assert = std.debug.assert;

// -- Hardware addresses (QEMU virt) --
const uart_base: u32 = 0x10000000;
const test_finisher: u32 = 0x00100000;
const finisher_pass: u32 = 0x5555;

fn uart_tx(c: u8) void {
    const ptr: *volatile u8 = @ptrFromInt(uart_base);
    ptr.* = c;
}

fn uart_print(s: []const u8) void {
    for (s) |c| uart_tx(c);
}

fn print_u32(v: u32) void {
    if (v == 0) {
        uart_tx('0');
        return;
    }
    var buf: [10]u8 = undefined;
    var n: u32 = 0;
    var x = v;
    while (x > 0) : (n += 1) {
        buf[n] = @intCast(x % 10 + '0');
        x /= 10;
    }
    while (n > 0) {
        n -= 1;
        uart_tx(buf[n]);
    }
}

fn print_hex(v: u32) void {
    uart_print("0x");
    const hex = "0123456789abcdef";
    var i: u5 = 8;
    while (i > 0) {
        i -= 1;
        uart_tx(hex[@intCast((v >> (i * 4)) & 0xf)]);
    }
}

fn halt_pass() noreturn {
    const ptr: *volatile u32 = @ptrFromInt(test_finisher);
    ptr.* = finisher_pass;
    while (true) asm volatile ("wfi");
}

fn halt_error(msg: []const u8) noreturn {
    uart_print(msg);
    while (true) asm volatile ("wfi");
}

// -- Entry point --
comptime {
    asm (
        \\.section .text.init,"ax"
        \\.globl _start
        \\_start:
        \\  li sp, 0x80100000
        \\  j kmain
    );
}

// -- Tally region (bounded allocation) --
const Region = struct {
    buf: [*]u8,
    cap: u32,
    pos: u32,

    fn init(base: [*]u8, budget: u32) Region {
        // invariant: budget > 0
        assert(budget > 0);
        return .{ .buf = base, .cap = budget, .pos = 0 };
    }

    fn alloc(self: *Region, size: u32) error{OutOfBounds}!u32 {
        // invariant: pos inside capacity
        assert(self.pos <= self.cap);
        if (self.pos + size > self.cap) return error.OutOfBounds;
        const offset = self.pos;
        var i: u32 = 0;
        while (i < size) : (i += 1) {
            self.buf[self.pos + i] = 0;
        }
        self.pos += size;
        // invariant: pos still inside capacity
        assert(self.pos <= self.cap);
        return offset;
    }

    fn remaining(self: *const Region) u32 {
        return self.cap - self.pos;
    }
};

// -- djb2 hash --
const Djb2 = struct {
    h: u32,

    fn init() Djb2 {
        return .{ .h = 5381 };
    }

    fn feed(self: *Djb2, data: []const u8) void {
        for (data) |byte| {
            self.h = ((self.h << 5) +% self.h) +% byte;
        }
    }

    fn feed_u32(self: *Djb2, v: u32) void {
        var buf_arr: [4]u8 = undefined;
        buf_arr[0] = @intCast((v >> 24) & 0xff);
        buf_arr[1] = @intCast((v >> 16) & 0xff);
        buf_arr[2] = @intCast((v >> 8) & 0xff);
        buf_arr[3] = @intCast(v & 0xff);
        self.feed(&buf_arr);
    }

    fn digest(self: *const Djb2) u32 {
        return self.h;
    }
};

// -- Kumara identity --
const seed_length: u32 = 32;

const Identity = struct {
    seed: [seed_length]u8,

    fn init(s: [seed_length]u8) Identity {
        return .{ .seed = s };
    }

    fn sign(self: *const Identity, message: []const u8) u32 {
        var h = Djb2.init();
        h.feed(&self.seed);
        h.feed(message);
        return h.digest();
    }
};

// -- Mantra event log --
const MantraLog = struct {
    region: *Region,
    identity: *const Identity,
    count: u32,
    state_hash: u32,

    fn init(
        region: *Region,
        identity: *const Identity,
    ) MantraLog {
        return .{
            .region = region,
            .identity = identity,
            .count = 0,
            .state_hash = 0,
        };
    }

    fn append(self: *MantraLog, message: []const u8) void {
        const msg_len: u32 = @intCast(message.len);
        const record_size: u32 = 4 + 4 + msg_len + 4 + 4;
        const offset = self.region.alloc(record_size) catch {
            halt_error("FATAL: Mantra log region exhausted\n");
        };
        var i: u32 = 0;
        while (i < msg_len) : (i += 1) {
            self.region.buf[offset + 8 + i] = message[i];
        }
        const sig = self.identity.sign(message);
        var chain = Djb2.init();
        chain.feed_u32(self.state_hash);
        chain.feed_u32(self.count);
        chain.feed(message);
        chain.feed_u32(sig);
        self.state_hash = chain.digest();
        self.count += 1;
    }
};

// =====================================================================
// Glow transaction grammar -- five verbs
// =====================================================================

const GlowVerb = enum(u8) {
    plant = 0,
    harvest = 1,
    sell = 2,
    compost = 3,
    note = 4,
};

const verb_count: u32 = 5;

fn verb_name(v: GlowVerb) []const u8 {
    return switch (v) {
        .plant => "plant",
        .harvest => "harvest",
        .sell => "sell",
        .compost => "compost",
        .note => "note",
    };
}

// -- Transaction record --
// Parsed from Glow surface: (verb subject qty [unit] [price])
const TransactionRecord = struct {
    verb: GlowVerb,
    subject: []const u8,
    qty: u32,
    unit: []const u8,
    price_cents: u32,
    has_unit: bool,
    has_price: bool,
};

// -- The 5 Glow transaction forms (compiled from surface syntax) --
//
// (plant tomatoes 200 seeds)
// (harvest tomatoes 45 kg)
// (sell peppers 12 kg 375)
// (compost leaves 30)
// (note rainfall 25 mm)

const txn_count: u32 = 5;

const transactions = [txn_count]TransactionRecord{
    .{
        .verb = .plant,
        .subject = "tomatoes",
        .qty = 200,
        .unit = "seeds",
        .price_cents = 0,
        .has_unit = true,
        .has_price = false,
    },
    .{
        .verb = .harvest,
        .subject = "tomatoes",
        .qty = 45,
        .unit = "kg",
        .price_cents = 0,
        .has_unit = true,
        .has_price = false,
    },
    .{
        .verb = .sell,
        .subject = "peppers",
        .qty = 12,
        .unit = "kg",
        .price_cents = 375,
        .has_unit = true,
        .has_price = true,
    },
    .{
        .verb = .compost,
        .subject = "leaves",
        .qty = 30,
        .unit = "",
        .price_cents = 0,
        .has_unit = false,
        .has_price = false,
    },
    .{
        .verb = .note,
        .subject = "rainfall",
        .qty = 25,
        .unit = "mm",
        .price_cents = 0,
        .has_unit = true,
        .has_price = false,
    },
};

// -- Expected field values for verification --
const expected_verbs = [txn_count]GlowVerb{
    .plant, .harvest, .sell, .compost, .note,
};
const expected_subjects = [txn_count][]const u8{
    "tomatoes", "tomatoes", "peppers", "leaves", "rainfall",
};
const expected_qtys = [txn_count]u32{ 200, 45, 12, 30, 25 };
const expected_units = [txn_count][]const u8{
    "seeds", "kg", "kg", "", "mm",
};
const expected_prices = [txn_count]u32{ 0, 0, 375, 0, 0 };

// -- Proof counter --
var proof_count: u32 = 0;
var proof_pass: u32 = 0;

fn check(name: []const u8, ok: bool) void {
    proof_count += 1;
    uart_print("  ");
    uart_print(name);
    if (ok) {
        uart_print(" PASS\n");
        proof_pass += 1;
    } else {
        uart_print(" FAIL\n");
    }
}

fn str_eq(a: []const u8, b: []const u8) bool {
    if (a.len != b.len) return false;
    var i: u32 = 0;
    while (i < a.len) : (i += 1) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

// -- Memory layout --
const log_region_base: u32 = 0x80180000;
const log_region_budget: u32 = 4096;

// -- Main: Glow transaction grammar proof --

export fn kmain() callconv(.c) noreturn {
    uart_print("GLOW TRANSACTION GRAMMAR");
    uart_print(" -- five verbs for the field ledger\n");
    uart_print("freestanding RV64G under Mantra\n\n");

    // -- Kumara identity --
    const seed: [seed_length]u8 = .{
        0x4B, 0x75, 0x6D, 0x61, 0x72, 0x61, 0x20, 0x73,
        0x65, 0x65, 0x64, 0x20, 0x66, 0x6F, 0x72, 0x20,
        0x66, 0x72, 0x65, 0x65, 0x73, 0x74, 0x61, 0x6E,
        0x64, 0x69, 0x6E, 0x67, 0x20, 0x52, 0x56, 0x49,
    };
    const identity = Identity.init(seed);

    // -- Tally region for Mantra --
    var log_region = Region.init(
        @ptrFromInt(log_region_base),
        log_region_budget,
    );
    var log = MantraLog.init(&log_region, &identity);

    // =================================================================
    // PROOF 1: PARSE AND DISPLAY TRANSACTION FORMS
    // =================================================================
    uart_print("-- PROOF 1: PARSE TRANSACTION FORMS --\n\n");

    var parsed: u32 = 0;
    var ti: u32 = 0;
    while (ti < txn_count) : (ti += 1) {
        const txn = &transactions[ti];

        // Print Glow surface form through Aurora
        uart_print("[");
        print_u32(ti + 1);
        uart_print("] (");
        uart_print(verb_name(txn.verb));
        uart_print(" ");
        uart_print(txn.subject);
        uart_print(" ");
        print_u32(txn.qty);
        if (txn.has_unit) {
            uart_print(" ");
            uart_print(txn.unit);
        }
        if (txn.has_price) {
            uart_print(" ");
            print_u32(txn.price_cents);
        }
        uart_print(")\n");

        // Print parsed fields through Aurora
        uart_print("  verb: ");
        uart_print(verb_name(txn.verb));
        uart_print("\n");
        uart_print("  subject: ");
        uart_print(txn.subject);
        uart_print("\n");
        uart_print("  qty: ");
        print_u32(txn.qty);
        uart_print("\n");
        if (txn.has_unit) {
            uart_print("  unit: ");
            uart_print(txn.unit);
            uart_print("\n");
        }
        if (txn.has_price) {
            uart_print("  price: ");
            print_u32(txn.price_cents);
            uart_print(" cents\n");
        }

        // Verify each field against expected values
        check("verb", txn.verb == expected_verbs[ti]);
        check(
            "subject",
            str_eq(txn.subject, expected_subjects[ti]),
        );
        check("qty", txn.qty == expected_qtys[ti]);
        check("unit", str_eq(txn.unit, expected_units[ti]));
        check("price", txn.price_cents == expected_prices[ti]);

        parsed += 1;
        uart_print("\n");

        // Log to Mantra
        log.append(verb_name(txn.verb));
    }

    // =================================================================
    // PROOF 2: VERB COVERAGE
    // =================================================================
    uart_print("-- PROOF 2: VERB COVERAGE --\n");
    uart_print("verbs parsed: ");
    print_u32(parsed);
    uart_print("/");
    print_u32(verb_count);
    uart_print("\n");
    check("all verbs", parsed == verb_count);
    uart_print("\n");

    // =================================================================
    // PROOF 3: MANTRA INTEGRITY
    // =================================================================
    uart_print("-- PROOF 3: MANTRA INTEGRITY --\n");
    uart_print("facts: ");
    print_u32(log.count);
    uart_print("\n");
    uart_print("state hash: ");
    print_hex(log.state_hash);
    uart_print("\n");
    uart_print("tally: ");
    print_u32(log_region.pos);
    uart_print(" of ");
    print_u32(log_region_budget);
    uart_print(" bytes\n");
    // invariant: allocation bounded
    assert(log_region.pos <= log_region_budget);
    check("bounded", log_region.pos <= log_region_budget);
    uart_print("\n");

    // =================================================================
    // VERDICT
    // =================================================================
    uart_print("==============================\n");
    uart_print("proofs: ");
    print_u32(proof_pass);
    uart_print("/");
    print_u32(proof_count);
    uart_print("\n");

    if (proof_pass == proof_count) {
        uart_print("ALL PROOFS PASSED\n");
        uart_print("correct: 5 of 5 transactions parsed\n");
        uart_print("Orbit 26 complete\n");
    } else {
        halt_error("SOME PROOFS FAILED\n");
    }

    halt_pass();
}
