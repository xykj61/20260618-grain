// terrarium/src/dimeroll_seal.rye
//
// Dimeroll daily seal -- Amphora vessel over Mantra state
//
// At the end of the day, all transactions seal
// into an Amphora vessel -- content-addressed,
// hash-identified, immutable. The seal travels
// through the wire to the host.
//
// SLC gate: daily seal created, hash verified,
// transmitted through wire.
//
// 80-column TAME, explicit u32, bounded everything.

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

// =========================================================
// HARDWARE -- UART, TEST FINISHER
// =========================================================

const uart_base: u32 = 0x10000000;
const test_finisher: u32 = 0x00100000;

fn uart_tx(c: u8) void {
    const ptr: *volatile u8 = @ptrFromInt(uart_base);
    ptr.* = c;
}

fn uart_print(s: []const u8) void {
    for (s) |c| uart_tx(c);
}

fn print_u32(v: u32) void {
    if (v == 0) {
        uart_tx('0');
        return;
    }
    var buf: [10]u8 = undefined;
    var n: u32 = 0;
    var val = v;
    while (val > 0) : (n += 1) {
        buf[n] = @intCast(val % 10 + '0');
        val /= 10;
    }
    var i: u32 = n;
    while (i > 0) {
        i -= 1;
        uart_tx(buf[i]);
    }
}

fn print_hex32(val: u32) void {
    uart_print("0x");
    var i: u32 = 0;
    while (i < 8) : (i += 1) {
        const nib: u4 = @intCast(
            (val >> @intCast(28 - i * 4)) & 0xF,
        );
        uart_tx(if (nib < 10)
            '0' + @as(u8, nib)
        else
            'a' + @as(u8, nib) - 10);
    }
}

fn halt_ok() noreturn {
    const p: *volatile u32 = @ptrFromInt(test_finisher);
    p.* = 0x5555;
    while (true) {}
}

// =========================================================
// AURORA FRAMEBUFFER
// =========================================================

const fwcfg_base: u32 = 0x10100000;
const fwcfg_data: u32 = fwcfg_base + 0x00;
const fwcfg_sel: u32 = fwcfg_base + 0x08;
const fwcfg_dma: u32 = fwcfg_base + 0x10;

const ramfb_cfg_addr: u32 = 0x80180000;
const dma_addr: u32 = 0x80180100;
const fb_addr: u32 = 0x80200000;

const fb_width: u32 = 320;
const fb_height: u32 = 240;
const fb_stride: u32 = fb_width * 4;
const fb_size: u32 = fb_height * fb_stride;
const drm_format: u32 = 0x34325258;

const console_cols: u32 = 40;
const console_rows: u32 = 30;
const glyph_w: u32 = 8;
const glyph_h: u32 = 8;

const color_bg: u32 = 0x001a3d;
const color_fg: u32 = 0xe0e0e0;
const color_accent: u32 = 0x40c060;
const color_header: u32 = 0x60a0ff;
const color_dim: u32 = 0x8090a0;

var has_display: bool = false;

fn write_be32(addr: u32, val: u32) void {
    const p: *volatile u32 = @ptrFromInt(addr);
    p.* = @byteSwap(val);
}

fn read_be32(addr: u32) u32 {
    const p: *volatile u32 = @ptrFromInt(addr);
    return @byteSwap(p.*);
}

fn write_be64(addr: u32, val: u64) void {
    write_be32(addr, @intCast(val >> 32));
    write_be32(addr + 4, @intCast(val & 0xFFFFFFFF));
}

fn fwcfg_select(key: u16) void {
    const p: *volatile u16 = @ptrFromInt(fwcfg_sel);
    p.* = @byteSwap(key);
}

fn fwcfg_read_u8() u8 {
    const p: *volatile u8 = @ptrFromInt(fwcfg_data);
    return p.*;
}

fn fwcfg_dma_write(
    selector: u16,
    buf_addr: u32,
    length: u32,
) void {
    const ctrl: u32 = (@as(u32, selector) << 16) | 0x18;
    write_be32(dma_addr + 0, ctrl);
    write_be32(dma_addr + 4, buf_addr);
    write_be32(dma_addr + 8, length);
    write_be64(fwcfg_dma, @as(u64, dma_addr));
    while (read_be32(dma_addr) != 0) {}
}

fn find_ramfb_selector() ?u16 {
    fwcfg_select(0x0000);
    _ = read_be32(fwcfg_data);
    fwcfg_select(0x0001);
    const count = read_be32(fwcfg_data);
    if (count > 4096) return null;
    const target = "etc/ramfb";
    var i: u32 = 0;
    while (i < count) : (i += 1) {
        fwcfg_select(0x0002 + @as(u16, @intCast(i)));
        var name: [56]u8 = undefined;
        for (&name) |*b| b.* = fwcfg_read_u8();
        var match = true;
        for (target, 0..) |c, j| {
            if (name[j] != c) { match = false; break; }
        }
        if (match and name[target.len] == 0) {
            return 0x0002 + @as(u16, @intCast(i));
        }
    }
    return null;
}

fn configure_ramfb(selector: u16) void {
    const cfg: u32 = ramfb_cfg_addr;
    write_be32(cfg + 0, fb_addr);
    write_be32(cfg + 4, 0);
    write_be32(cfg + 8, drm_format);
    write_be32(cfg + 12, 0);
    write_be32(cfg + 16, fb_stride);
    write_be32(cfg + 20, fb_width);
    write_be32(cfg + 24, fb_height);
    fwcfg_dma_write(selector, cfg, 28);
}

fn clear_screen() void {
    const p: [*]volatile u32 = @ptrFromInt(fb_addr);
    var i: u32 = 0;
    const total = fb_width * fb_height;
    while (i < total) : (i += 1) p[i] = color_bg;
}

