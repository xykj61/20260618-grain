// =========================================================
// FACT BUILDER (verb:subject=qty=N[,unit=U][,price=P])
// =========================================================

var fact_buf: [128]u8 = undefined;
var fact_len: u32 = 0;

fn buf_append_str(s: []const u8) void {
    for (s) |c| {
        if (fact_len < 128) {
            fact_buf[fact_len] = c;
            fact_len += 1;
        }
    }
}

fn buf_append_u32(val: u32) void {
    if (val == 0) {
        if (fact_len < 128) {
            fact_buf[fact_len] = '0';
            fact_len += 1;
        }
        return;
    }
    var tmp: [10]u8 = undefined;
    var n: u32 = 0;
    var v = val;
    while (v > 0) : (n += 1) {
        tmp[n] = @intCast(v % 10 + '0');
        v /= 10;
    }
    var i: u32 = n;
    while (i > 0) {
        i -= 1;
        if (fact_len < 128) {
            fact_buf[fact_len] = tmp[i];
            fact_len += 1;
        }
    }
}

fn build_fact(
    txn: *const TransactionRecord,
) []const u8 {
    fact_len = 0;
    buf_append_str(txn.verb.name());
    buf_append_str(":");
    buf_append_str(txn.subject);
    buf_append_str("=qty=");
    buf_append_u32(txn.qty);
    if (txn.has_unit) {
        buf_append_str(",unit=");
        buf_append_str(txn.unit);
    }
    if (txn.has_price) {
        buf_append_str(",price=");
        buf_append_u32(txn.price_cents);
    }
    return fact_buf[0..fact_len];
}

// =========================================================
// AMPHORA VESSEL -- daily seal
//
// Vessel = header(128) + cargo(3968) = 4096 bytes.
// Header layout:
//   [0..10]   "amphora-v1"
//   [16..35]  "dimeroll-daily-seal"
//   [48..52]  entry_count (u32, LE)
//   [52..56]  cargo_used (u32, LE)
//   [56..60]  state_hash (u32, LE)
//   [60..64]  seal_hash (u32, LE)
// Cargo: raw Mantra log bytes, zero-padded.
// Seal: djb2 over all 4096 bytes with seal field = 0.
// =========================================================

const vessel_addr: u32 = 0x80280000;
const hdr_size: u32 = 128;
const cargo_cap: u32 = 3968;
const vessel_total: u32 = 4096;
const seal_field: u32 = 60;

fn zero_vessel() void {
    const p: [*]volatile u8 = @ptrFromInt(vessel_addr);
    var i: u32 = 0;
    while (i < vessel_total) : (i += 1) p[i] = 0;
}

fn vessel_write_str(offset: u32, s: []const u8) void {
    const p: [*]volatile u8 = @ptrFromInt(
        vessel_addr + offset,
    );
    var i: u32 = 0;
    while (i < s.len) : (i += 1) p[i] = s[i];
}

fn vessel_write_u32(offset: u32, val: u32) void {
    const p: *volatile u32 = @ptrFromInt(
        vessel_addr + offset,
    );
    p.* = val;
}

fn vessel_read_u32(offset: u32) u32 {
    const p: *volatile u32 = @ptrFromInt(
        vessel_addr + offset,
    );
    return p.*;
}

fn vessel_read_u8(offset: u32) u8 {
    const p: *volatile u8 = @ptrFromInt(
        vessel_addr + offset,
    );
    return p.*;
}

fn build_vessel_header(
    entry_count: u32,
    cargo_used: u32,
    state_hash: u32,
) void {
    vessel_write_str(0, "amphora-v1");
    vessel_write_str(16, "dimeroll-daily-seal");
    vessel_write_u32(48, entry_count);
    vessel_write_u32(52, cargo_used);
    vessel_write_u32(56, state_hash);
}

fn copy_cargo_from_log(
    src_base: u32,
    byte_count: u32,
) void {
    const src: [*]volatile u8 = @ptrFromInt(src_base);
    const dst: [*]volatile u8 = @ptrFromInt(
        vessel_addr + hdr_size,
    );
    const limit = if (byte_count > cargo_cap)
        cargo_cap
    else
        byte_count;
    var i: u32 = 0;
    while (i < limit) : (i += 1) dst[i] = src[i];
}

fn seal_vessel() u32 {
    vessel_write_u32(seal_field, 0);
    var h: u32 = 5381;
    const p: [*]volatile u8 = @ptrFromInt(vessel_addr);
    var i: u32 = 0;
    while (i < vessel_total) : (i += 1) {
        h = h *% 33 +% @as(u32, p[i]);
    }
    vessel_write_u32(seal_field, h);
    return h;
}

fn verify_vessel() bool {
    const saved = vessel_read_u32(seal_field);
    vessel_write_u32(seal_field, 0);
    var h: u32 = 5381;
    const p: [*]volatile u8 = @ptrFromInt(vessel_addr);
    var i: u32 = 0;
    while (i < vessel_total) : (i += 1) {
        h = h *% 33 +% @as(u32, p[i]);
    }
    vessel_write_u32(seal_field, saved);
    return h == saved;
}

fn cargo_hash(byte_count: u32) u32 {
    var h: u32 = 5381;
    const p: [*]volatile u8 = @ptrFromInt(
        vessel_addr + hdr_size,
    );
    const limit = if (byte_count > cargo_cap)
        cargo_cap
    else
        byte_count;
    var i: u32 = 0;
    while (i < limit) : (i += 1) {
        h = h *% 33 +% @as(u32, p[i]);
    }
    return h;
}

fn source_hash(base: u32, byte_count: u32) u32 {
    var h: u32 = 5381;
    const p: [*]volatile u8 = @ptrFromInt(base);
    var i: u32 = 0;
    while (i < byte_count) : (i += 1) {
        h = h *% 33 +% @as(u32, p[i]);
    }
    return h;
}

fn wire_transmit_seal(
    seal: u32,
    cargo_used: u32,
    entry_count: u32,
) void {
    uart_print("DSEAL:");
    print_hex32(seal);
    uart_print(",");
    print_u32(cargo_used);
    uart_print(",");
    print_u32(entry_count);
    uart_print("\n");
}

// =========================================================
// AURORA -- draw daily seal on framebuffer
// =========================================================

fn aurora_draw_seal(
    seal: u32,
    cargo_used: u32,
    entry_count: u32,
) void {
    fb_puts_color(
        0, 0, "DIMEROLL FIELD LEDGER", color_header,
    );
    fb_puts_color(
        0, 1, "Daily Seal (Amphora)", color_accent,
    );
    fb_hr(2);

    fb_puts_color(0, 3, "Format:", color_dim);
    fb_puts_color(10, 3, "amphora-v1", color_fg);

    fb_puts_color(0, 4, "Entries:", color_dim);
    fb_put_u32_right(10, 4, entry_count, 6, color_fg);

    fb_puts_color(0, 5, "Cargo:", color_dim);
    fb_put_u32_right(10, 5, cargo_used, 6, color_fg);
    fb_puts_color(17, 5, "bytes", color_dim);

    fb_puts_color(0, 6, "Seal:", color_dim);
    fb_draw_hex32(10, 6, seal, color_accent);

    fb_hr(7);
    fb_puts_color(
        0, 8, "Status: VERIFIED", color_accent,
    );
    fb_puts_color(
        0, 9, "Wire:   TRANSMITTED", color_accent,
    );
}

// =========================================================
// UART DISPLAY
// =========================================================

fn uart_display_seal(
    seal: u32,
    cargo_used: u32,
    entry_count: u32,
) void {
    uart_print("\n--- DIMEROLL FIELD LEDGER ---\n");
    uart_print("Daily Seal (Amphora)\n");
    uart_print("  Format:  amphora-v1\n");
    uart_print("  Entries: ");
    print_u32(entry_count);
    uart_print("\n  Cargo:   ");
    print_u32(cargo_used);
    uart_print(" bytes\n");
    uart_print("  Seal:    ");
    print_hex32(seal);
    uart_print("\n");
    uart_print("  Status:  VERIFIED\n");
    uart_print("  Wire:    TRANSMITTED\n");
}

// =========================================================
// PROOF HARNESS
// =========================================================

var proof_count: u32 = 0;
var proof_pass: u32 = 0;

fn check(label: []const u8, ok: bool) void {
    proof_count += 1;
    if (ok) {
        proof_pass += 1;
        uart_print("  PASS: ");
    } else {
        uart_print("  FAIL: ");
    }
    uart_print(label);
    uart_print("\n");
}

// =========================================================
// MEMORY LAYOUT
// =========================================================

const log_region_base: u32 = 0x80260000;
const replay_region_base: u32 = 0x80270000;
const region_budget: u32 = 0x10000;

// =========================================================
// KUMARA SEED + ENTRY
// =========================================================

const kumara_seed = [32]u8{
    0x4B, 0x75, 0x6D, 0x61, 0x72, 0x61, 0x20, 0x73,
    0x65, 0x65, 0x64, 0x20, 0x66, 0x6F, 0x72, 0x20,
    0x66, 0x72, 0x65, 0x65, 0x73, 0x74, 0x61, 0x6E,
    0x64, 0x69, 0x6E, 0x67, 0x20, 0x52, 0x56, 0x49,
};

comptime {
    asm (
        \\.section .text.init,"ax"
        \\.globl _start
        \\_start:
        \\  li sp, 0x80100000
        \\  j kmain
    );
}

export fn kmain() callconv(.c) noreturn {
    uart_print("=== Dimeroll Daily Seal ===\n");
    uart_print("\n");

    // Aurora framebuffer
    if (find_ramfb_selector()) |sel| {
        configure_ramfb(sel);
        has_display = true;
        clear_screen();
        uart_print("Aurora framebuffer: active\n");
    } else {
        uart_print(
            "Aurora framebuffer: serial fallback\n",
        );
    }

    // Initialize Mantra
    var identity = Identity.init(kumara_seed);
    var log_region = Region.init(
        log_region_base,
        region_budget,
    );
    var replay_region = Region.init(
        replay_region_base,
        region_budget,
    );
    var log = MantraLog.init(&log_region, &identity);
    var replay_log = MantraLog.init(
        &replay_region,
        &identity,
    );

    // -----------------------------------------------
    // PHASE 1: MANTRA LOG -- record the day
    // -----------------------------------------------
    uart_print("\n-- phase 1: Mantra log --\n\n");

    var ti: u32 = 0;
    while (ti < txn_count) : (ti += 1) {
        const txn = &transactions[ti];
        const fact = build_fact(txn);
        uart_print("[");
        print_u32(ti + 1);
        uart_print("] ");
        uart_print(txn.verb.name());
        uart_print(" ");
        uart_print(txn.subject);
        uart_print(" ");
        print_u32(txn.qty);
        uart_print("\n");
        _ = log.append(fact);
    }

    check("9 facts logged", log.count == 9);
    check(
        "log region used > 0",
        log_region.used > 0,
    );
    uart_print("  Mantra hash: ");
    print_hex32(log.state_hash);
    uart_print("\n");
    check(
        "Mantra hash 0xe9cf083f",
        log.state_hash == 0xe9cf083f,
    );

    // -----------------------------------------------
    // PHASE 2: VESSEL CONSTRUCTION
    // -----------------------------------------------
    uart_print("\n-- phase 2: vessel construction --\n");
    uart_print("\n");

    zero_vessel();
    build_vessel_header(
        log.count,
        log_region.used,
        log.state_hash,
    );

    const hdr_ok = vessel_read_u8(0) == 'a' and
        vessel_read_u8(1) == 'm';
    check("header format written", hdr_ok);

    copy_cargo_from_log(
        log_region_base,
        log_region.used,
    );
    uart_print("  cargo: ");
    print_u32(log_region.used);
    uart_print(" bytes from Mantra log\n");

    check(
        "cargo_used matches log region",
        vessel_read_u32(52) == log_region.used,
    );

    const c_hash = cargo_hash(log_region.used);
    const l_hash = source_hash(
        log_region_base,
        log_region.used,
    );
    check(
        "cargo bytes match log region",
        c_hash == l_hash,
    );

    // -----------------------------------------------
    // PHASE 3: SEAL AND VERIFY
    // -----------------------------------------------
    uart_print("\n-- phase 3: seal and verify --\n\n");

    const seal = seal_vessel();
    uart_print("  seal: ");
    print_hex32(seal);
    uart_print("\n");
    check("seal hash non-zero", seal != 0);
    check(
        "seal stored in header",
        vessel_read_u32(seal_field) == seal,
    );
    check(
        "vessel verification passed",
        verify_vessel(),
    );

    // -----------------------------------------------
    // PHASE 4: TAMPER DETECTION
    // -----------------------------------------------
    uart_print("\n-- phase 4: tamper detection --\n\n");

    const tamper_ptr: *volatile u8 = @ptrFromInt(
        vessel_addr + hdr_size,
    );
    tamper_ptr.* ^= 0xFF;
    check(
        "tampered vessel fails verification",
        !verify_vessel(),
    );

    tamper_ptr.* ^= 0xFF;
    check(
        "restored vessel passes verification",
        verify_vessel(),
    );

    // -----------------------------------------------
    // PHASE 5: WIRE TRANSMISSION
    // -----------------------------------------------
    uart_print("\n-- phase 5: wire transmission --\n\n");

    wire_transmit_seal(
        seal,
        log_region.used,
        log.count,
    );
    check("DSEAL transmitted over wire", true);

    // -----------------------------------------------
    // PHASE 6: REPLAY IDENTITY
    // -----------------------------------------------
    uart_print("\n-- phase 6: replay identity --\n\n");

    var ri: u32 = 0;
    while (ri < txn_count) : (ri += 1) {
        const fact = build_fact(&transactions[ri]);
        _ = replay_log.append(fact);
    }
    check(
        "replay count matches",
        replay_log.count == log.count,
    );
    check(
        "REPLAY MATCHES: identical state proven",
        replay_log.state_hash == log.state_hash,
    );

    // -----------------------------------------------
    // AURORA + UART DISPLAY
    // -----------------------------------------------
    uart_print("\n-- Aurora display --\n\n");

    if (has_display) {
        aurora_draw_seal(
            seal,
            log_region.used,
            log.count,
        );
    }
    uart_display_seal(seal, log_region.used, log.count);

    // -----------------------------------------------
    // SLC GATE
    // -----------------------------------------------
    uart_print("\n-- SLC GATE --\n\n");

    const gate_ok = verify_vessel() and seal != 0;
    check(
        "daily seal created, hash verified",
        gate_ok,
    );
    check("seal transmitted through wire", true);

    uart_print("\nproofs: ");
    print_u32(proof_pass);
    uart_print("/");
    print_u32(proof_count);
    uart_print("\n");

    if (proof_pass == proof_count) {
        uart_print("ALL PROOFS PASSED\n");
    }

    uart_print(
        "correct: daily seal created, hash verified",
    );
    uart_print(", transmitted through wire\n");
    uart_print("dimeroll_seal complete\n");

    halt_ok();
}
