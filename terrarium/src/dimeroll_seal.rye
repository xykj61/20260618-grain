fn get_glyph(c: u8) [8]u8 {
    if (c >= 32 and c <= 126) {
        return font_glyphs[c - 32];
    }
    return font_glyphs[0];
}

// =========================================================
// AURORA DRAWING
// =========================================================

fn fb_draw_glyph(
    col: u32,
    row: u32,
    ch: u8,
    color: u32,
) void {
    if (!has_display) return;
    const glyph = get_glyph(ch);
    const x0 = col * glyph_w;
    const y0 = row * glyph_h;
    const fb: [*]volatile u32 = @ptrFromInt(fb_addr);
    var gy: u32 = 0;
    while (gy < glyph_h) : (gy += 1) {
        const bits = glyph[gy];
        var gx: u32 = 0;
        while (gx < glyph_w) : (gx += 1) {
            if (bits & (@as(u8, 0x80) >> @intCast(gx)) != 0) {
                const px = x0 + gx;
                const py = y0 + gy;
                if (px < fb_width and py < fb_height) {
                    fb[py * fb_width + px] = color;
                }
            }
        }
    }
}

fn fb_puts_color(
    col: u32,
    row: u32,
    s: []const u8,
    color: u32,
) void {
    for (s, 0..) |c, i| {
        fb_draw_glyph(
            col + @as(u32, @intCast(i)),
            row,
            c,
            color,
        );
    }
}

fn fb_hr(row: u32) void {
    if (!has_display) return;
    const fb: [*]volatile u32 = @ptrFromInt(fb_addr);
    const y = row * glyph_h + glyph_h / 2;
    if (y >= fb_height) return;
    var x: u32 = 0;
    while (x < fb_width) : (x += 1) {
        fb[y * fb_width + x] = color_dim;
    }
}

fn fb_put_u32_right(
    col: u32,
    row: u32,
    val: u32,
    width: u32,
    color: u32,
) void {
    var buf: [10]u8 = undefined;
    var n: u32 = 0;
    var v = val;
    if (v == 0) {
        n = 1;
        buf[0] = '0';
    } else {
        while (v > 0) : (n += 1) {
            buf[n] = @intCast(v % 10 + '0');
            v /= 10;
        }
    }
    const start = if (n < width) col + width - n else col;
    var i: u32 = n;
    var c: u32 = start;
    while (i > 0) {
        i -= 1;
        fb_draw_glyph(c, row, buf[i], color);
        c += 1;
    }
}

fn fb_draw_hex32(
    col: u32,
    row: u32,
    val: u32,
    color: u32,
) void {
    fb_draw_glyph(col, row, '0', color);
    fb_draw_glyph(col + 1, row, 'x', color);
    var i: u32 = 0;
    while (i < 8) : (i += 1) {
        const nib: u4 = @intCast(
            (val >> @intCast(28 - i * 4)) & 0xF,
        );
        const ch: u8 = if (nib < 10)
            '0' + @as(u8, nib)
        else
            'a' + @as(u8, nib) - 10;
        fb_draw_glyph(col + 2 + i, row, ch, color);
    }
}

// =========================================================
// DJB2 HASH
// =========================================================

fn djb2(data: []const u8) u32 {
    var h: u32 = 5381;
    for (data) |b| {
        h = h *% 33 +% @as(u32, b);
    }
    return h;
}

fn djb2_update(state: u32, val: u32) u32 {
    var h = state;
    h = h *% 33 +% @as(u32, @intCast(val & 0xFF));
    h = h *% 33 +% @as(u32, @intCast((val >> 8) & 0xFF));
    h = h *% 33 +% @as(u32, @intCast((val >> 16) & 0xFF));
    h = h *% 33 +% @as(u32, @intCast((val >> 24) & 0xFF));
    return h;
}

// =========================================================
// REGION ALLOCATOR + IDENTITY + MANTRA LOG
// =========================================================

const Region = struct {
    base: u32,
    budget: u32,
    used: u32,

    fn init(base: u32, budget: u32) Region {
        return .{
            .base = base,
            .budget = budget,
            .used = 0,
        };
    }

    fn alloc(self: *Region, size: u32) ?u32 {
        if (self.used + size > self.budget) return null;
        const off = self.used;
        self.used += size;
        return off;
    }
};

const Djb2 = struct {
    state: u32,

    fn init() Djb2 {
        return .{ .state = 5381 };
    }

    fn update(self: *Djb2, data: []const u8) void {
        for (data) |b| {
            self.state = self.state *% 33 +% @as(u32, b);
        }
    }

    fn finish(self: *const Djb2) u32 {
        return self.state;
    }
};

const Identity = struct {
    seed: [32]u8,

    fn init(s: [32]u8) Identity {
        return .{ .seed = s };
    }

    fn sign(
        self: *const Identity,
        message: []const u8,
    ) u32 {
        var h = Djb2.init();
        h.update(&self.seed);
        h.update(message);
        return h.finish();
    }
};

const MantraLog = struct {
    region: *Region,
    identity: *const Identity,
    count: u32,
    state_hash: u32,

    fn init(
        region: *Region,
        identity: *const Identity,
    ) MantraLog {
        return .{
            .region = region,
            .identity = identity,
            .count = 0,
            .state_hash = 0,
        };
    }

    fn append(self: *MantraLog, fact: []const u8) ?u32 {
        const flen: u32 = @intCast(fact.len);
        const total: u32 = 4 + 4 + flen;
        const offset = self.region.alloc(total) orelse
            return null;
        const base = self.region.base + offset;

        const len_ptr: *volatile u32 =
            @ptrFromInt(base);
        len_ptr.* = 4 + flen;

        const sig = self.identity.sign(fact);
        const sig_ptr: *volatile u32 =
            @ptrFromInt(base + 4);
        sig_ptr.* = sig;

        const fact_ptr: [*]volatile u8 =
            @ptrFromInt(base + 8);
        var i: u32 = 0;
        while (i < flen) : (i += 1) {
            fact_ptr[i] = fact[i];
        }

        self.count += 1;
        self.state_hash =
            self.state_hash *% 31 +% sig;
        return sig;
    }
};

// =========================================================
// TRANSACTION GRAMMAR (shared across dimeroll modules)
// =========================================================

const GlowVerb = enum(u8) {
    plant = 0,
    harvest = 1,
    sell = 2,
    compost = 3,
    note = 4,

    fn name(self: GlowVerb) []const u8 {
        return switch (self) {
            .plant => "plant",
            .harvest => "harvest",
            .sell => "sell",
            .compost => "compost",
            .note => "note",
        };
    }
};

const TransactionRecord = struct {
    verb: GlowVerb,
    subject: []const u8,
    qty: u32,
    has_price: bool,
    price_cents: u32,
    has_unit: bool,
    unit: []const u8,
};

