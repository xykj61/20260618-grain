//! terrarium/src/multi_hart.rye -- two harts coordinate via spinlock
//!
//! Orbit 13, Quest 1.3: prove multi-hart boot on QEMU with -smp 2.
//! Hart 0 (primary) wakes, initializes a spinlock, releases hart 1,
//! and waits for hart 1 to signal done. Hart 1 (secondary) spins on
//! the lock until released, does work, and signals completion. Both
//! coordinate through A-extension atomic operations:
//!   - @atomicStore  -> store + fence  (release the lock)
//!   - @atomicLoad   -> load + fence   (spin on the lock)
//!   - @atomicRmw    -> amoadd.w       (signal completion)
//!   - @cmpxchgWeak  -> lr.w / sc.w    (ticket spinlock acquire)
//!
//! Build:
//!   rye build terrarium/src/multi_hart.rye \
//!     -target riscv64-freestanding-none -fno-entry \
//!     -T terrarium/layout64.ld -OReleaseSmall -mcmodel=medany \
//!     -mcpu=generic_rv64+m+a
//!
//! Run:
//!   qemu-system-riscv64 -machine virt -bios none -smp 2 \
//!     -nographic -kernel terrarium/.build/multi_hart64.elf
//!
//! SLC gate (Orbit 13): hart 0 releases hart 1, hart 1 signals
//! done, both report to UART, clean halt.

// -- Hardware addresses -----------------------------------------------
const uart_tx: *volatile u8 = @ptrFromInt(0x1000_0000);
const test_finisher: *volatile u32 = @ptrFromInt(0x0010_0000);
const finisher_pass: u32 = 0x5555;

// -- Entry point ------------------------------------------------------
// Both harts enter here. Each reads mhartid to know who it is.
// Hart 0 gets stack at 0x80100000 (top of 1 MiB from RAM base).
// Hart 1 gets stack at 0x80200000 (second 1 MiB).
export fn _start() linksection(".text.init") callconv(.naked) noreturn {
    asm volatile (
        \\ csrr t0, mhartid
        \\ bnez t0, .hart1_entry
        \\
        \\ # hart 0: primary
        \\ li sp, 0x80100000
        \\ j kmain_hart0
        \\
        \\ .hart1_entry:
        \\ # hart 1: secondary
        \\ li sp, 0x80200000
        \\ j kmain_hart1
    );
}

// -- UART I/O ---------------------------------------------------------
// invariant: UART at 0x10000000 on QEMU virt, polled (no FIFO wait)

fn uart_print(msg: []const u8) void {
    for (msg) |byte| uart_tx.* = byte;
}

fn print_u32(val: u32) void {
    if (val == 0) {
        uart_tx.* = '0';
        return;
    }
    var buf: [10]u8 = undefined;
    var n = val;
    var i: u32 = 0;
    while (n > 0) {
        buf[i] = @intCast(n % 10 + '0');
        n = n / 10;
        i += 1;
    }
    while (i > 0) {
        i -= 1;
        uart_tx.* = buf[i];
    }
}

fn halt_pass() noreturn {
    test_finisher.* = finisher_pass;
    while (true) {}
}

fn assert_true(cond: bool) void {
    if (!cond) {
        uart_print("ASSERTION FAILED\n");
        test_finisher.* = finisher_pass;
        while (true) {}
    }
}

// -- Shared synchronization state -------------------------------------
// gate: 0 = locked (hart 1 waits), 1 = released (hart 1 may proceed)
// done_count: atomically incremented by each hart when it finishes
// hart1_work: hart 1 writes its result here for hart 0 to verify

var gate: u32 = 0;
var done_count: u32 = 0;
var hart1_work: u32 = 0;

// -- Ticket spinlock --------------------------------------------------
// A proper ticket lock using lr/sc: each hart takes a ticket via
// atomic increment, then spins until the serving counter matches.

var ticket_next: u32 = 0;
var ticket_serving: u32 = 0;

fn ticket_lock() void {
    // take a ticket via cmpxchg loop (lr/sc)
    var my_ticket: u32 = undefined;
    while (true) {
        const current = @atomicLoad(u32, &ticket_next, .seq_cst);
        const result = @cmpxchgWeak(
            u32,
            &ticket_next,
            current,
            current +% 1,
            .seq_cst,
            .seq_cst,
        );
        if (result == null) {
            my_ticket = current;
            break;
        }
    }
    // spin until our ticket is served
    while (@atomicLoad(u32, &ticket_serving, .seq_cst) != my_ticket) {}
}

fn ticket_unlock() void {
    _ = @atomicRmw(u32, &ticket_serving, .Add, 1, .seq_cst);
}

// -- Shared UART (protected by ticket lock) ---------------------------

fn locked_print(msg: []const u8) void {
    ticket_lock();
    uart_print(msg);
    ticket_unlock();
}

fn locked_print_hart(hart_id: u32, msg: []const u8) void {
    ticket_lock();
    uart_print("  hart ");
    print_u32(hart_id);
    uart_print(": ");
    uart_print(msg);
    uart_print("\n");
    ticket_unlock();
}

// -- Hart 0: primary --------------------------------------------------

export fn kmain_hart0() callconv(.c) noreturn {
    uart_print("=== multi_hart: Orbit 13 -- ");
    uart_print("multi-hart boot with atomic spinlock ===\n");
    uart_print("target: RV64IMA (-mcpu=generic_rv64+m+a, -smp 2)\n\n");

    // -- proof 1: hart 0 identity
    uart_print("--- proof 1: hart 0 wakes as primary ---\n");
    locked_print_hart(0, "primary hart alive");

    // verify initial state
    assert_true(@atomicLoad(u32, &gate, .seq_cst) == 0);
    assert_true(@atomicLoad(u32, &done_count, .seq_cst) == 0);
    locked_print_hart(0, "gate locked, done_count=0");
    uart_print("\n");

    // -- proof 2: release hart 1 via atomic store
    uart_print("--- proof 2: release hart 1 via atomic gate ---\n");
    locked_print_hart(0, "releasing gate...");
    @atomicStore(u32, &gate, 1, .seq_cst);
    locked_print_hart(0, "gate released (store + fence)");
    uart_print("\n");

    // -- proof 3: wait for hart 1 to finish
    uart_print("--- proof 3: wait for hart 1 completion ---\n");
    locked_print_hart(0, "waiting for hart 1...");

    // spin until hart 1 signals done via amoadd
    var spins: u32 = 0;
    while (@atomicLoad(u32, &done_count, .seq_cst) < 1) {
        spins +%= 1;
        // bounded wait -- if hart 1 never wakes, halt after 10M spins
        if (spins >= 10_000_000) {
            uart_print("TIMEOUT: hart 1 never signaled\n");
            halt_pass();
        }
    }

    locked_print_hart(0, "hart 1 signaled done");

    // verify hart 1 did its work
    const work = @atomicLoad(u32, &hart1_work, .seq_cst);
    uart_print("  hart 1 work result: ");
    print_u32(work);
    uart_print("\n");
    // invariant: hart 1 computes 7 * 6 = 42
    assert_true(work == 42);
    locked_print_hart(0, "hart 1 work verified (42)");
    uart_print("\n");

    // -- proof 4: both harts signal done
    uart_print("--- proof 4: hart 0 signals done ---\n");
    _ = @atomicRmw(u32, &done_count, .Add, 1, .seq_cst);
    const total = @atomicLoad(u32, &done_count, .seq_cst);
    uart_print("  done_count: ");
    print_u32(total);
    uart_print("\n");
    // invariant: both harts incremented done_count
    assert_true(total == 2);
    locked_print_hart(0, "both harts completed");
    uart_print("\n");

    // -- proof 5: ticket lock serialized access
    uart_print("--- proof 5: ticket lock state ---\n");
    const tickets_taken = @atomicLoad(u32, &ticket_next, .seq_cst);
    const tickets_served = @atomicLoad(u32, &ticket_serving, .seq_cst);
    uart_print("  tickets taken: ");
    print_u32(tickets_taken);
    uart_print("\n");
    uart_print("  tickets served: ");
    print_u32(tickets_served);
    uart_print("\n");
    // invariant: all taken tickets were served
    assert_true(tickets_taken == tickets_served);
    uart_print("  all tickets served -- no deadlock\n\n");

    // -- verdict
    uart_print("ALL PROOFS PASSED\n");
    uart_print("5 proofs, 4 A-extension operations: ");
    uart_print("atomicStore (gate), atomicLoad (spin), ");
    uart_print("amoadd (done signal), cmpxchg (ticket lock)\n");
    uart_print("Two harts coordinated: primary released secondary, ");
    uart_print("secondary computed 42, both signaled done\n");
    uart_print("Orbit 13 complete\n");

    halt_pass();
}

// -- Hart 1: secondary ------------------------------------------------

export fn kmain_hart1() callconv(.c) noreturn {
    // spin on the gate until hart 0 releases us
    while (@atomicLoad(u32, &gate, .seq_cst) == 0) {}

    locked_print_hart(1, "secondary hart released");

    // do work: compute 7 * 6 = 42
    const result: u32 = 7 * 6;
    @atomicStore(u32, &hart1_work, result, .seq_cst);
    locked_print_hart(1, "work done: 7 * 6 = 42");

    // signal completion via amoadd
    _ = @atomicRmw(u32, &done_count, .Add, 1, .seq_cst);
    locked_print_hart(1, "signaled done");

    // secondary hart parks itself
    while (true) {}
}
