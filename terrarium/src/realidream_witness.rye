// -- Main entry ----------------------------------------------------

const resp_max: u32 = 16384;

export fn kmain() noreturn {
    uart_print(
        "Realidream witness"
        ++ " -- the vision is working\n",
    );
    uart_print(
        "Siya requests Bloom content"
        ++ " from all 8 content galaxies\n\n",
    );

    var payload_buf: [resp_max]u8 = undefined;
    var total_claims: u32 = 0;
    var total_bytes: u32 = 0;

    for (galaxies) |gal| {
        uart_print("-- galaxy ");
        uart_print(gal.peer);
        uart_print(" (");
        uart_print(gal.bolt);
        uart_print(", ");
        print_u32(@intCast(gal.pages.len));
        uart_print(" pages)\n");

        for (gal.pages) |page| {
            uart_print("  ");
            uart_print(page);
            uart_print(":\n");
            send_creq(gal.peer, gal.bolt, page);
            const r = receive_cresp(&payload_buf);

            if (!r.ok) halt_error("receive failed");
            if (r.status != 200) {
                uart_print("status ");
                print_u32(r.status);
                uart_print(" -- ");
                halt_error("expected 200");
            }

            const d = djb2(
                payload_buf[0..r.payload_len],
            );
            if (d != r.digest) {
                uart_print("digest mismatch ");
                emit_hex_u32(d);
                uart_print(" != ");
                emit_hex_u32(r.digest);
                uart_print(" -- ");
                halt_error("djb2 mismatch");
            }

            print_u32(r.payload_len);
            uart_print(" bytes, djb2 ");
            emit_hex_u32(d);
            uart_print(" ok\n");

            total_claims += 1;
            total_bytes += r.payload_len;
        }
    }

    // -- Claim 2: 404 refusal
    uart_print("\n-- refusal test\n");
    uart_print("  nonexistent-page:\n");
    send_creq(
        "~sunflower",
        "curriculum",
        "no-such-page",
    );
    const r_bad = receive_cresp(&payload_buf);
    if (!r_bad.ok) halt_error("refusal receive fail");
    if (r_bad.status != 404)
        halt_error("expected 404");
    uart_print("404 (correctly refused)\n");
    total_claims += 1;

    // -- Verdict
    uart_print("\nclaims proven: ");
    print_u32(total_claims);
    uart_print("\ntotal bytes received: ");
    print_u32(total_bytes);
    uart_print("\n");
    uart_print(
        "GREEN: Realidream -- 47 pages across"
        ++ " 8 galaxies, djb2 verified."
        ++ " The vision is working.\n",
    );
    halt_pass();
}

// -- Entry ---------------------------------------------------------

export fn _start() linksection(".text.init") callconv(.naked) noreturn {
    asm volatile (
        "li sp, 0x80100000\n" ++
            "j kmain"
    );
}
