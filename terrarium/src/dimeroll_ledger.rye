// dimeroll_ledger.rye -- Orbit 31: Ledger page on Aurora framebuffer
//
// Aurora draws a table of the day's transactions on the 320x240
// framebuffer console. 5 transactions display as a readable table.
// Quest 2.2 opener.

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

// =========================================================
// HARDWARE
// =========================================================

const uart_base: usize = 0x10000000;
const test_finisher: usize = 0x00100000;

fn uart_tx(c: u8) void {
    const ptr: *volatile u8 = @ptrFromInt(uart_base);
    ptr.* = c;
}

fn uart_print(s: []const u8) void {
    for (s) |c| uart_tx(c);
}

fn print_u32(val: u32) void {
    if (val == 0) {
        uart_tx('0');
        return;
    }
    var buf: [10]u8 = undefined;
    var n: u32 = 0;
    var v = val;
    while (v > 0) : (n += 1) {
        buf[n] = @intCast(v % 10 + '0');
        v /= 10;
    }
    var i: u32 = n;
    while (i > 0) {
        i -= 1;
        uart_tx(buf[i]);
    }
}

fn halt_ok() noreturn {
    const ptr: *volatile u32 = @ptrFromInt(test_finisher);
    ptr.* = 0x5555;
    while (true) {}
}

// =========================================================
// FRAMEBUFFER -- Aurora console on 320x240 XRGB8888
// =========================================================

const fb_addr: usize = 0x80200000;
const fb_width: u32 = 320;
const fb_height: u32 = 240;
const fb_stride: u32 = fb_width * 4;
const fb_size: u32 = fb_stride * fb_height;

const glyph_w: u32 = 8;
const glyph_h: u32 = 8;
const console_cols: u32 = fb_width / glyph_w;
const console_rows: u32 = fb_height / glyph_h;

const color_bg: u32 = 0x001a3d;
const color_fg: u32 = 0xe0e0e0;
const color_accent: u32 = 0x40c060;
const color_header: u32 = 0x60a0ff;
const color_dim: u32 = 0x8090a0;

var cursor_col: u32 = 0;
var cursor_row: u32 = 0;
var has_display: bool = false;

// fw_cfg for ramfb discovery
const fwcfg_base: usize = 0x10100000;
const fwcfg_sel: usize = fwcfg_base + 0x08;
const fwcfg_data: usize = fwcfg_base + 0x00;
const fwcfg_dma: usize = fwcfg_base + 0x10;

const ramfb_cfg_addr: usize = 0x80180000;
const dma_addr: usize = 0x80180100;

fn fwcfg_select(sel: u16) void {
    const p: *volatile u16 = @ptrFromInt(fwcfg_sel);
    p.* = std.mem.nativeToBig(u16, sel);
}

fn fwcfg_read_byte() u8 {
    const p: *volatile u8 = @ptrFromInt(fwcfg_data);
    return p.*;
}

fn fwcfg_read_be16() u16 {
    var b: [2]u8 = undefined;
    b[0] = fwcfg_read_byte();
    b[1] = fwcfg_read_byte();
    return std.mem.readInt(u16, &b, .big);
}

fn fwcfg_read_be32() u32 {
    var b: [4]u8 = undefined;
    b[0] = fwcfg_read_byte();
    b[1] = fwcfg_read_byte();
    b[2] = fwcfg_read_byte();
    b[3] = fwcfg_read_byte();
    return std.mem.readInt(u32, &b, .big);
}

fn write_be32(addr: usize, val: u32) void {
    const p: *volatile u32 = @ptrFromInt(addr);
    p.* = @byteSwap(val);
}

fn write_be64(addr: usize, val: u64) void {
    write_be32(addr, @truncate(val >> 32));
    write_be32(addr + 4, @truncate(val));
}

fn read_be32(addr: usize) u32 {
    const p: *volatile u32 = @ptrFromInt(addr);
    return @byteSwap(p.*);
}

fn find_ramfb_selector() ?u16 {
    fwcfg_select(0x0019);
    const count = fwcfg_read_be32();
    assert(count > 0);
    assert(count < 256);
    var i: u32 = 0;
    while (i < count) : (i += 1) {
        _ = fwcfg_read_be32();
        const sel = fwcfg_read_be16();
        _ = fwcfg_read_be16();
        var name_buf: [56]u8 = undefined;
        for (&name_buf) |*b| b.* = fwcfg_read_byte();
        if (name_match(&name_buf, "etc/ramfb")) return sel;
    }
    return null;
}

fn name_match(buf: *const [56]u8, target: []const u8) bool {
    if (target.len > 56) return false;
    for (target, 0..) |c, idx| {
        if (buf[idx] != c) return false;
    }
    if (target.len < 56) return buf[target.len] == 0;
    return true;
}

const drm_format_xrgb8888: u32 = 0x34325258;

fn configure_ramfb(selector: u16) void {
    // RAMFBCfg (28 bytes, BE): addr(8), fourcc(4), flags(4),
    //                          width(4), height(4), stride(4)
    write_be64(ramfb_cfg_addr + 0, @as(u64, fb_addr));
    write_be32(ramfb_cfg_addr + 8, drm_format_xrgb8888);
    write_be32(ramfb_cfg_addr + 12, 0);
    write_be32(ramfb_cfg_addr + 16, fb_width);
    write_be32(ramfb_cfg_addr + 20, fb_height);
    write_be32(ramfb_cfg_addr + 24, fb_stride);

    // FWCfgDmaAccess (16 bytes, BE): control(4), length(4),
    //                                 address(8)
    const control: u32 =
        (@as(u32, selector) << 16) | 0x18;
    write_be32(dma_addr + 0, control);
    write_be32(dma_addr + 4, 28);
    write_be64(dma_addr + 8, @as(u64, ramfb_cfg_addr));

    // Trigger DMA via fw_cfg registers
    const dma_hi: *volatile u32 = @ptrFromInt(fwcfg_dma);
    const dma_lo: *volatile u32 = @ptrFromInt(fwcfg_dma + 4);
    dma_hi.* = @byteSwap(@as(u32, 0));
    dma_lo.* = @byteSwap(@as(u32, @intCast(dma_addr)));

    // Poll until QEMU clears the control field
    var polls: u32 = 0;
    while (read_be32(dma_addr + 0) != 0) : (polls += 1) {
        assert(polls < 1_000_000);
    }
}

fn clear_screen() void {
    var y: u32 = 0;
    while (y < fb_height) : (y += 1) {
        var x: u32 = 0;
        while (x < fb_width) : (x += 1) {
            const off = fb_addr + y * fb_stride + x * 4;
            const p: *volatile u32 = @ptrFromInt(off);
            p.* = color_bg;
        }
    }
}

