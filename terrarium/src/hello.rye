//! terrarium/src/hello.rye -- a hart wakes on RV32I and speaks.
//!
//! The smallest living piece of Terrarium's boot story: a single hart
//! wakes on a 32-bit RISC-V machine, gives itself a stack, speaks one
//! line over the console UART, and powers the machine down cleanly.
//! No operating system sits beneath it and no standard library above
//! it -- only Rye's own toolchain, aimed at bare metal, and an
//! emulator to wake in.
//!
//! Build and run:
//!   rishi/bin/rishi run tools/te/terrarium_run.rish
//!
//! The addresses below belong to QEMU's `virt` machine for riscv32:
//! a 16550-style console UART at 0x1000_0000, and a test device at
//! 0x10_0000 that powers the machine off when written. They are the
//! same addresses Aurora's riscv64 seed uses -- the virt machine
//! memory map is identical across word widths.

const uart_tx: *volatile u8 = @ptrFromInt(0x1000_0000);

const test_finisher: *volatile u32 = @ptrFromInt(0x0010_0000);
const finisher_pass: u32 = 0x5555;

export fn _start() linksection(".text.init") callconv(.naked) noreturn {
    asm volatile (
        \\ li sp, 0x80100000
        \\ j kmain
    );
}

export fn kmain() callconv(.c) noreturn {
    const line =
        "Terrarium hello: a hart woke on RV32I" ++
        ", spoke this line, and halted.\n";

    // invariant: a silent hart proves nothing
    assert(line.len != 0);
    for (line) |byte| uart_tx.* = byte;

    test_finisher.* = finisher_pass;
    while (true) {}
}

// invariant: a failed proof halts immediately
fn assert(ok: bool) void {
    if (!ok) unreachable;
}
