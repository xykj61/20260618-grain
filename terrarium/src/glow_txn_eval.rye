// terrarium/src/glow_txn_eval.rye
//
// Orbit 27 -- Transaction evaluation and Mantra logging
//
// Each parsed transaction evaluates to a signed Mantra fact.
// The fact carries verb, subject, quantity, unit, price, and
// timestamp. The Mantra log grows from calculation traces
// to a book of account.
//
// Key encoding:   verb:subject  (colon-separated)
// Value encoding:  qty=N,unit=U,price=P  (comma-separated)
//
// SLC gate: 5 transactions log as 5 signed Mantra facts,
// replay identity proven.
//
// TAME order: Safety (bounded keys and values) ->
// Visibility (Aurora prints each fact) -> Replay (identity)

const std = @import("std");
const assert = std.debug.assert;

// -- Hardware addresses (QEMU virt) --
const uart_base: u32 = 0x10000000;
const test_finisher: u32 = 0x00100000;
const finisher_pass: u32 = 0x5555;

fn uart_tx(c: u8) void {
    const ptr: *volatile u8 = @ptrFromInt(uart_base);
    ptr.* = c;
}

fn uart_print(s: []const u8) void {
    for (s) |c| uart_tx(c);
}

fn print_u32(v: u32) void {
    if (v == 0) {
        uart_tx('0');
        return;
    }
    var buf: [10]u8 = undefined;
    var n: u32 = 0;
    var x = v;
    while (x > 0) : (n += 1) {
        buf[n] = @intCast(x % 10 + '0');
        x /= 10;
    }
    while (n > 0) {
        n -= 1;
        uart_tx(buf[n]);
    }
}

fn print_hex(v: u32) void {
    uart_print("0x");
    const hex = "0123456789abcdef";
    var i: u5 = 8;
    while (i > 0) {
        i -= 1;
        uart_tx(hex[@intCast((v >> (i * 4)) & 0xf)]);
    }
}

fn halt_pass() noreturn {
    const ptr: *volatile u32 = @ptrFromInt(test_finisher);
    ptr.* = finisher_pass;
    while (true) asm volatile ("wfi");
}

fn halt_error(msg: []const u8) noreturn {
    uart_print(msg);
    while (true) asm volatile ("wfi");
}

// -- Entry point --
comptime {
    asm (
        \\.section .text.init,"ax"
        \\.globl _start
        \\_start:
        \\  li sp, 0x80100000
        \\  j kmain
    );
}

// -- Tally region (bounded allocation) --
const Region = struct {
    buf: [*]u8,
    cap: u32,
    pos: u32,

    fn init(base: [*]u8, budget: u32) Region {
        // invariant: budget > 0
        assert(budget > 0);
        return .{ .buf = base, .cap = budget, .pos = 0 };
    }

    fn alloc(self: *Region, size: u32) error{OutOfBounds}!u32 {
        // invariant: pos inside capacity
        assert(self.pos <= self.cap);
        if (self.pos + size > self.cap) return error.OutOfBounds;
        const offset = self.pos;
        var i: u32 = 0;
        while (i < size) : (i += 1) {
            self.buf[self.pos + i] = 0;
        }
        self.pos += size;
        // invariant: pos still inside capacity
        assert(self.pos <= self.cap);
        return offset;
    }

    fn remaining(self: *const Region) u32 {
        return self.cap - self.pos;
    }
};

// -- djb2 hash --
const Djb2 = struct {
    h: u32,

    fn init() Djb2 {
        return .{ .h = 5381 };
    }

    fn feed(self: *Djb2, data: []const u8) void {
        for (data) |byte| {
            self.h = ((self.h << 5) +% self.h) +% byte;
        }
    }

    fn feed_u32(self: *Djb2, v: u32) void {
        var buf_arr: [4]u8 = undefined;
        buf_arr[0] = @intCast((v >> 24) & 0xff);
        buf_arr[1] = @intCast((v >> 16) & 0xff);
        buf_arr[2] = @intCast((v >> 8) & 0xff);
        buf_arr[3] = @intCast(v & 0xff);
        self.feed(&buf_arr);
    }

    fn digest(self: *const Djb2) u32 {
        return self.h;
    }
};

// -- Kumara identity --
const seed_length: u32 = 32;

const Identity = struct {
    seed: [seed_length]u8,

    fn init(s: [seed_length]u8) Identity {
        return .{ .seed = s };
    }

    fn sign(self: *const Identity, message: []const u8) u32 {
        var h = Djb2.init();
        h.feed(&self.seed);
        h.feed(message);
        return h.digest();
    }
};

// -- Mantra event log --
const MantraLog = struct {
    region: *Region,
    identity: *const Identity,
    count: u32,
    state_hash: u32,

    fn init(
        region: *Region,
        identity: *const Identity,
    ) MantraLog {
        return .{
            .region = region,
            .identity = identity,
            .count = 0,
            .state_hash = 0,
        };
    }

    fn append(self: *MantraLog, message: []const u8) void {
        const msg_len: u32 = @intCast(message.len);
        const record_size: u32 = 4 + 4 + msg_len + 4 + 4;
        const offset = self.region.alloc(record_size) catch {
            halt_error("FATAL: Mantra log region exhausted\n");
        };
        var i: u32 = 0;
        while (i < msg_len) : (i += 1) {
            self.region.buf[offset + 8 + i] = message[i];
        }
        const sig = self.identity.sign(message);
        var chain = Djb2.init();
        chain.feed_u32(self.state_hash);
        chain.feed_u32(self.count);
        chain.feed(message);
        chain.feed_u32(sig);
        self.state_hash = chain.digest();
        self.count += 1;
    }
};

// =====================================================================
// Glow transaction grammar -- five verbs (from Orbit 26)
// =====================================================================

const GlowVerb = enum(u8) {
    plant = 0,
    harvest = 1,
    sell = 2,
    compost = 3,
    note = 4,
};

const verb_count: u32 = 5;

fn verb_name(v: GlowVerb) []const u8 {
    return switch (v) {
        .plant => "plant",
        .harvest => "harvest",
        .sell => "sell",
        .compost => "compost",
        .note => "note",
    };
}

const TransactionRecord = struct {
    verb: GlowVerb,
    subject: []const u8,
    qty: u32,
    unit: []const u8,
    price_cents: u32,
    has_unit: bool,
    has_price: bool,
};

// -- The 5 Glow transaction forms --
const txn_count: u32 = 5;

const transactions = [txn_count]TransactionRecord{
    .{
        .verb = .plant,
        .subject = "tomatoes",
        .qty = 200,
        .unit = "seeds",
        .price_cents = 0,
        .has_unit = true,
        .has_price = false,
    },
    .{
        .verb = .harvest,
        .subject = "tomatoes",
        .qty = 45,
        .unit = "kg",
        .price_cents = 0,
        .has_unit = true,
        .has_price = false,
    },
    .{
        .verb = .sell,
        .subject = "peppers",
        .qty = 12,
        .unit = "kg",
        .price_cents = 375,
        .has_unit = true,
        .has_price = true,
    },
    .{
        .verb = .compost,
        .subject = "leaves",
        .qty = 30,
        .unit = "",
        .price_cents = 0,
        .has_unit = false,
        .has_price = false,
    },
    .{
        .verb = .note,
        .subject = "rainfall",
        .qty = 25,
        .unit = "mm",
        .price_cents = 0,
        .has_unit = true,
        .has_price = false,
    },
};

// =====================================================================
// Orbit 27: Transaction evaluator -- Mantra fact encoding
// =====================================================================
//
// Key:   verb:subject    e.g. "plant:tomatoes"
// Value: qty=N[,unit=U][,price=P]   e.g. "qty=200,unit=seeds"
//
// The full Mantra message is "key=value" so a reader can
// reconstruct the transaction from any single fact.

// Scratch buffer for building fact messages
// Max key: 5 (verb) + 1 (:) + 16 (subject) = 22
// Max value: 4 (qty=) + 10 (digits) + 1 (,) + 5 (unit=) + 16 +
//            1 (,) + 6 (price=) + 10 = 53
// Total with = separator: 22 + 1 + 53 = 76
// Budget 128 to be safe
const fact_buf_size: u32 = 128;
var fact_buf: [fact_buf_size]u8 = std.mem.zeroes([fact_buf_size]u8);

fn buf_append_str(pos: *u32, s: []const u8) void {
    // invariant: write stays in buffer
    assert(pos.* + @as(u32, @intCast(s.len)) <= fact_buf_size);
    var i: u32 = 0;
    while (i < s.len) : (i += 1) {
        fact_buf[pos.* + i] = s[i];
    }
    pos.* += @intCast(s.len);
}

fn buf_append_u32(pos: *u32, v: u32) void {
    if (v == 0) {
        // invariant: room for one digit
        assert(pos.* < fact_buf_size);
        fact_buf[pos.*] = '0';
        pos.* += 1;
        return;
    }
    var digits: [10]u8 = undefined;
    var n: u32 = 0;
    var x = v;
    while (x > 0) : (n += 1) {
        digits[n] = @intCast(x % 10 + '0');
        x /= 10;
    }
    // invariant: room for digits
    assert(pos.* + n <= fact_buf_size);
    while (n > 0) {
        n -= 1;
        fact_buf[pos.*] = digits[n];
        pos.* += 1;
    }
}

// Build a Mantra fact message from a transaction record.
// Returns the slice of fact_buf that holds the message.
fn build_fact(txn: *const TransactionRecord) []const u8 {
    var pos: u32 = 0;

    // Key: verb:subject
    buf_append_str(&pos, verb_name(txn.verb));
    buf_append_str(&pos, ":");
    buf_append_str(&pos, txn.subject);

    // Separator
    buf_append_str(&pos, "=");

    // Value: qty=N[,unit=U][,price=P]
    buf_append_str(&pos, "qty=");
    buf_append_u32(&pos, txn.qty);

    if (txn.has_unit) {
        buf_append_str(&pos, ",unit=");
        buf_append_str(&pos, txn.unit);
    }

    if (txn.has_price) {
        buf_append_str(&pos, ",price=");
        buf_append_u32(&pos, txn.price_cents);
    }

    // invariant: message fits in buffer
    assert(pos <= fact_buf_size);
    return fact_buf[0..pos];
}

// -- Expected fact messages for verification --
const expected_facts = [txn_count][]const u8{
    "plant:tomatoes=qty=200,unit=seeds",
    "harvest:tomatoes=qty=45,unit=kg",
    "sell:peppers=qty=12,unit=kg,price=375",
    "compost:leaves=qty=30",
    "note:rainfall=qty=25,unit=mm",
};

// -- Proof counter --
var proof_count: u32 = 0;
var proof_pass: u32 = 0;

fn check(name: []const u8, ok: bool) void {
    proof_count += 1;
    uart_print("  ");
    uart_print(name);
    if (ok) {
        uart_print(" PASS\n");
        proof_pass += 1;
    } else {
        uart_print(" FAIL\n");
    }
}

fn str_eq(a: []const u8, b: []const u8) bool {
    if (a.len != b.len) return false;
    var i: u32 = 0;
    while (i < a.len) : (i += 1) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

// -- Memory layout --
// Two separate regions for replay identity proof
const log_region_base: u32 = 0x80180000;
const log_region_budget: u32 = 4096;
const replay_region_base: u32 = 0x80190000;
const replay_region_budget: u32 = 4096;

// -- Kumara seed (same across all terrarium modules) --
const seed: [seed_length]u8 = .{
    0x4B, 0x75, 0x6D, 0x61, 0x72, 0x61, 0x20, 0x73,
    0x65, 0x65, 0x64, 0x20, 0x66, 0x6F, 0x72, 0x20,
    0x66, 0x72, 0x65, 0x65, 0x73, 0x74, 0x61, 0x6E,
    0x64, 0x69, 0x6E, 0x67, 0x20, 0x52, 0x56, 0x49,
};

// -- Main --

export fn kmain() callconv(.c) noreturn {
    uart_print("TRANSACTION EVALUATION AND MANTRA LOGGING");
    uart_print(" -- Orbit 27\n");
    uart_print("freestanding RV64G under Mantra\n\n");

    const identity = Identity.init(seed);

    // -- Primary log --
    var log_region = Region.init(
        @ptrFromInt(log_region_base),
        log_region_budget,
    );
    var log = MantraLog.init(&log_region, &identity);

    // =================================================================
    // PROOF 1: EVALUATE TRANSACTIONS TO MANTRA FACTS
    // =================================================================
    uart_print("-- PROOF 1: EVALUATE TO MANTRA FACTS --\n\n");

    var facts_logged: u32 = 0;
    var ti: u32 = 0;
    while (ti < txn_count) : (ti += 1) {
        const txn = &transactions[ti];

        // Build the fact message
        const fact = build_fact(txn);

        // Print the Glow surface form
        uart_print("[");
        print_u32(ti + 1);
        uart_print("] (");
        uart_print(verb_name(txn.verb));
        uart_print(" ");
        uart_print(txn.subject);
        uart_print(" ");
        print_u32(txn.qty);
        if (txn.has_unit) {
            uart_print(" ");
            uart_print(txn.unit);
        }
        if (txn.has_price) {
            uart_print(" ");
            print_u32(txn.price_cents);
        }
        uart_print(")\n");

        // Print the Mantra fact
        uart_print("  fact: ");
        uart_print(fact);
        uart_print("\n");

        // Verify fact encoding matches expected
        check("fact_encoding", str_eq(fact, expected_facts[ti]));

        // Log to Mantra
        log.append(fact);
        facts_logged += 1;

        uart_print("\n");
    }

    // =================================================================
    // PROOF 2: FACT COUNT AND COVERAGE
    // =================================================================
    uart_print("-- PROOF 2: FACT COUNT --\n");
    uart_print("facts logged: ");
    print_u32(facts_logged);
    uart_print("/");
    print_u32(txn_count);
    uart_print("\n");
    check("all_facts_logged", facts_logged == txn_count);
    check("log_count", log.count == txn_count);
    uart_print("\n");

    // =================================================================
    // PROOF 3: MANTRA STATE INTEGRITY
    // =================================================================
    uart_print("-- PROOF 3: MANTRA STATE --\n");
    uart_print("state hash: ");
    print_hex(log.state_hash);
    uart_print("\n");
    uart_print("facts: ");
    print_u32(log.count);
    uart_print("\n");
    uart_print("tally: ");
    print_u32(log_region.pos);
    uart_print(" of ");
    print_u32(log_region_budget);
    uart_print(" bytes\n");
    // invariant: allocation bounded
    assert(log_region.pos <= log_region_budget);
    check("bounded", log_region.pos <= log_region_budget);
    uart_print("\n");

    // Capture primary hash for replay comparison
    const primary_hash = log.state_hash;
    const primary_count = log.count;
    const primary_tally = log_region.pos;

    // =================================================================
    // PROOF 4: REPLAY IDENTITY
    // =================================================================
    // Build a second independent log from the same transactions.
    // If the state hash matches, the log is deterministic.
    uart_print("-- PROOF 4: REPLAY IDENTITY --\n");

    var replay_region = Region.init(
        @ptrFromInt(replay_region_base),
        replay_region_budget,
    );
    var replay_log = MantraLog.init(&replay_region, &identity);

    // Replay the same 5 transactions
    var ri: u32 = 0;
    while (ri < txn_count) : (ri += 1) {
        const fact = build_fact(&transactions[ri]);
        replay_log.append(fact);
    }

    uart_print("primary hash:  ");
    print_hex(primary_hash);
    uart_print("\n");
    uart_print("replay hash:   ");
    print_hex(replay_log.state_hash);
    uart_print("\n");

    const hash_match = (primary_hash == replay_log.state_hash);
    check("replay_hash_match", hash_match);
    check(
        "replay_count_match",
        primary_count == replay_log.count,
    );
    check(
        "replay_tally_match",
        primary_tally == replay_region.pos,
    );

    if (hash_match) {
        uart_print("REPLAY MATCHES: identical state proven\n");
    }
    uart_print("\n");

    // =================================================================
    // PROOF 5: KEY FORMAT VERIFICATION
    // =================================================================
    // Each fact key is verb:subject -- verify the colon separator
    // exists and both halves are non-empty.
    uart_print("-- PROOF 5: KEY FORMAT --\n");

    var ki: u32 = 0;
    while (ki < txn_count) : (ki += 1) {
        const fact = expected_facts[ki];
        // Find the = separator between key and value
        var eq_pos: u32 = 0;
        var found_eq = false;
        var fi: u32 = 0;
        while (fi < fact.len) : (fi += 1) {
            if (fact[fi] == '=') {
                eq_pos = fi;
                found_eq = true;
                break;
            }
        }
        // invariant: every fact has a key=value separator
        assert(found_eq);

        // Find the colon in the key portion
        var colon_pos: u32 = 0;
        var found_colon = false;
        fi = 0;
        while (fi < eq_pos) : (fi += 1) {
            if (fact[fi] == ':') {
                colon_pos = fi;
                found_colon = true;
                break;
            }
        }

        check("has_colon", found_colon);
        // verb is non-empty
        check("verb_nonempty", colon_pos > 0);
        // subject is non-empty
        check("subject_nonempty", eq_pos > colon_pos + 1);
    }

    uart_print("\n");

    // =================================================================
    // VERDICT
    // =================================================================
    uart_print("==============================\n");
    uart_print("proofs: ");
    print_u32(proof_pass);
    uart_print("/");
    print_u32(proof_count);
    uart_print("\n");

    if (proof_pass == proof_count) {
        uart_print("ALL PROOFS PASSED\n");
        uart_print("correct: 5 of 5 signed Mantra facts\n");
        uart_print("Orbit 27 complete\n");
    } else {
        halt_error("SOME PROOFS FAILED\n");
    }

    halt_pass();
}
