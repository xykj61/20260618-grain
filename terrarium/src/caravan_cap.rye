//! terrarium/src/caravan_cap.rye -- Caravan capability model on RV32I
//!
//! The fifth TAME stage: Caravan governs who may do what. Each domain
//! runs inside a Pond enclosure with named capabilities and bounded
//! leases; a capability can be conferred and revoked. Allocation is
//! bounded by Tally, display by Aurora (UART console), log by Mantra.
//!
//! Freestanding port of caravan/objects.rye, caravan/entrust.rye,
//! caravan/revoke.rye, and caravan/exercise.rye -- no std, no
//! filesystem, no process model. Domains are structures in memory
//! bounded by Tally. Capabilities carry rights masks and bounded
//! leases; exercise checks both walls (capability then mode) before
//! granting a Reach handle.
//!
//! Build and run:
//!   make terrarium STAGE=caravan_cap
//!
//! SLC gate (Orbit 21): a domain creates a capability, confers it to
//! a dependent, the dependent exercises it, and the capability expires
//! -- all visible on Aurora's console and recorded in Mantra's log.

// -- Hardware addresses -----------------------------------------------
const uart_tx: *volatile u8 = @ptrFromInt(0x1000_0000);
const test_finisher: *volatile u32 = @ptrFromInt(0x0010_0000);
const finisher_pass: u32 = 0x5555;

// -- Entry point ------------------------------------------------------
export fn _start() linksection(".text.init") callconv(.naked) noreturn {
    asm volatile (
        \\ li sp, 0x80100000
        \\ j kmain
    );
}

// -- UART I/O ---------------------------------------------------------

fn uart_print(msg: []const u8) void {
    for (msg) |byte| uart_tx.* = byte;
}

fn print_u32(val: u32) void {
    if (val == 0) {
        uart_tx.* = '0';
        return;
    }
    var buf: [10]u8 = undefined;
    var n = val;
    var i: u32 = 0;
    while (n > 0) {
        buf[i] = @intCast(n % 10 + '0');
        n = n / 10;
        i += 1;
    }
    while (i > 0) {
        i -= 1;
        uart_tx.* = buf[i];
    }
}

fn print_hex(val: u32) void {
    const hex = "0123456789abcdef";
    uart_print("0x");
    var shift: u32 = 28;
    while (true) {
        const nibble: u4 = @intCast((val >> @intCast(shift)) & 0xF);
        uart_tx.* = hex[nibble];
        if (shift == 0) break;
        shift -= 4;
    }
}

fn halt_pass() noreturn {
    test_finisher.* = finisher_pass;
    while (true) {}
}

fn halt_error(msg: []const u8) noreturn {
    uart_print(msg);
    test_finisher.* = finisher_pass;
    while (true) {}
}

// -- Assert -----------------------------------------------------------

fn assert(cond: bool) void {
    if (!cond) halt_error("ASSERTION FAILED\n");
}

// -- Region (Tally) ---------------------------------------------------
// invariant: pos <= cap always

const Region = struct {
    buf: [*]u8,
    cap: u32,
    pos: u32,

    fn init(ptr: [*]u8, size: u32) Region {
        assert(size > 0);
        return .{ .buf = ptr, .cap = size, .pos = 0 };
    }

    fn alloc(self: *Region, n: u32) error{OutOfBounds}![]u8 {
        assert(self.pos <= self.cap);
        if (n > self.cap - self.pos) return error.OutOfBounds;
        const start = self.pos;
        self.pos += n;
        assert(self.pos <= self.cap);
        return self.buf[start..self.pos];
    }

    fn remaining(self: *const Region) u32 {
        return self.cap - self.pos;
    }
};

// -- djb2 hash --------------------------------------------------------

const Djb2 = struct {
    h: u32,

    fn init() Djb2 {
        return .{ .h = 5381 };
    }

    fn feed(self: *Djb2, data: []const u8) void {
        for (data) |byte| {
            self.h = ((self.h << 5) +% self.h) +% @as(u32, byte);
        }
    }

    fn feed_u32(self: *Djb2, val: u32) void {
        self.feed(&[4]u8{
            @intCast((val >> 24) & 0xFF),
            @intCast((val >> 16) & 0xFF),
            @intCast((val >> 8) & 0xFF),
            @intCast(val & 0xFF),
        });
    }

    fn digest(self: *const Djb2) u32 {
        return self.h;
    }
};

// -- Kumara identity (keyed hash) -------------------------------------

const seed_length: u32 = 32;

const Identity = struct {
    seed: [seed_length]u8,

    fn init(seed: [seed_length]u8) Identity {
        return .{ .seed = seed };
    }

    fn sign(self: *const Identity, message: []const u8) u32 {
        var h = Djb2.init();
        h.feed(&self.seed);
        h.feed(message);
        return h.digest();
    }
};

// -- Mantra fact log (inline) -----------------------------------------
// Simplified from mantra_log.rye: append facts and track state hash.
// No replay needed here -- the TAME boot witness already proved that.

const max_payload_len: u32 = 64;
const fact_header_bytes: u32 = 4 + 4 + 4 + 4;
const fact_size: u32 = fact_header_bytes + max_payload_len;
const max_facts: u32 = 32;

const Fact = struct {
    seq: u32,
    prev_hash: u32,
    payload_len: u32,
    tag: u32,
    payload: [max_payload_len]u8,
};

const MantraLog = struct {
    region: *Region,
    identity: *const Identity,
    count: u32,
    state_hash: u32,

    fn init(region: *Region, identity: *const Identity) MantraLog {
        return .{
            .region = region,
            .identity = identity,
            .count = 0,
            .state_hash = 0,
        };
    }

    fn append(self: *MantraLog, payload: []const u8) void {
        assert(self.count < max_facts);
        assert(payload.len <= max_payload_len);
        const raw = self.region.alloc(fact_size) catch
            halt_error("mantra: region exhausted\n");
        const fact: *Fact = @ptrCast(@alignCast(raw.ptr));
        fact.seq = self.count;
        fact.prev_hash = self.state_hash;
        fact.payload_len = @intCast(payload.len);
        var pi: u32 = 0;
        while (pi < max_payload_len) : (pi += 1) {
            if (pi < payload.len) {
                fact.payload[pi] = payload[pi];
            } else {
                fact.payload[pi] = 0;
            }
        }
        // sign: canonical form is seq+prev_hash+payload_len+payload
        var canon: [fact_size - 4]u8 = undefined;
        canon[0] = @intCast((fact.seq >> 24) & 0xFF);
        canon[1] = @intCast((fact.seq >> 16) & 0xFF);
        canon[2] = @intCast((fact.seq >> 8) & 0xFF);
        canon[3] = @intCast(fact.seq & 0xFF);
        canon[4] = @intCast((fact.prev_hash >> 24) & 0xFF);
        canon[5] = @intCast((fact.prev_hash >> 16) & 0xFF);
        canon[6] = @intCast((fact.prev_hash >> 8) & 0xFF);
        canon[7] = @intCast(fact.prev_hash & 0xFF);
        canon[8] = @intCast((fact.payload_len >> 24) & 0xFF);
        canon[9] = @intCast((fact.payload_len >> 16) & 0xFF);
        canon[10] = @intCast((fact.payload_len >> 8) & 0xFF);
        canon[11] = @intCast(fact.payload_len & 0xFF);
        var ci: u32 = 0;
        while (ci < max_payload_len) : (ci += 1) {
            canon[12 + ci] = fact.payload[ci];
        }
        fact.tag = self.identity.sign(&canon);
        // update state hash
        var sh = Djb2.init();
        sh.feed_u32(self.state_hash);
        sh.feed_u32(fact.tag);
        sh.feed(&canon);
        self.state_hash = sh.digest();
        self.count += 1;
    }
};

// -- Kernel object types (from caravan/objects.rye) --------------------
// Portable tier only -- the five types every architecture shares.

const ObjectType = enum(u8) {
    untyped = 0,
    tcb = 1,
    endpoint = 2,
    notification = 3,
    cap_table = 4,
};

// -- Rights mask ------------------------------------------------------
// Three bits: read, write, execute. W xor X arrives naturally from the
// grammar -- the exercise wall checks the mask, and the caller asks for
// one mode at a time.

const right_read: u32 = 1;
const right_write: u32 = 2;
const right_execute: u32 = 4;

fn rights_name(rights: u32) []const u8 {
    if (rights == (right_read | right_write)) return "RW";
    if (rights == right_read) return "R";
    if (rights == right_write) return "W";
    if (rights == right_execute) return "X";
    if (rights == (right_read | right_execute)) return "RX";
    if (rights == (right_read | right_write | right_execute))
        return "RWX";
    return "?";
}

fn object_name(obj: ObjectType) []const u8 {
    return switch (obj) {
        .untyped => "untyped",
        .tcb => "tcb",
        .endpoint => "endpoint",
        .notification => "notification",
        .cap_table => "cap_table",
    };
}

// -- Capability -------------------------------------------------------
// A capability names an object type, a rights mask, and a bounded
// lease. When the lease reaches zero the capability expires and
// exercise is refused.

const max_caps_per_domain: u32 = 8;

const Capability = struct {
    obj: ObjectType,
    rights: u32,
    lease: u32,
    active: bool,
    grantor_id: u32,
};

// -- Domain -----------------------------------------------------------
// A domain is a Pond enclosure: an isolated execution context with
// its own capability table. Each domain has a bounded number of
// capability slots.

const max_name_len: u32 = 32;
const max_domains: u32 = 4;

const Domain = struct {
    id: u32,
    name_ptr: [*]const u8,
    name_len: u32,
    caps: [max_caps_per_domain]Capability,
    cap_count: u32,
};

// -- Capability table operations --------------------------------------
// Confer: grant a capability to a domain (entrust).
// Revoke: withdraw a capability (narrow the domain's reach).
// Exercise: use a capability, checking both walls.
// Tick: advance the lease clock; expire capabilities at zero.

const CapError = error{
    CapTableFull,
    CapNotFound,
    CapExpired,
    CapRightsInsufficient,
};

fn confer(
    domain: *Domain,
    obj: ObjectType,
    rights: u32,
    lease: u32,
    grantor_id: u32,
) CapError!u32 {
    // invariant: cap_count inside ceiling
    assert(domain.cap_count <= max_caps_per_domain);
    if (domain.cap_count >= max_caps_per_domain)
        return CapError.CapTableFull;
    const slot = domain.cap_count;
    domain.caps[slot] = .{
        .obj = obj,
        .rights = rights,
        .lease = lease,
        .active = true,
        .grantor_id = grantor_id,
    };
    domain.cap_count += 1;
    // invariant: cap_count stayed inside ceiling
    assert(domain.cap_count <= max_caps_per_domain);
    return slot;
}

fn revoke(domain: *Domain, slot: u32) CapError!void {
    if (slot >= domain.cap_count) return CapError.CapNotFound;
    if (!domain.caps[slot].active) return CapError.CapExpired;
    domain.caps[slot].active = false;
    domain.caps[slot].lease = 0;
}

fn exercise(
    domain: *Domain,
    slot: u32,
    requested: u32,
) CapError!void {
    if (slot >= domain.cap_count) return CapError.CapNotFound;
    const cap = &domain.caps[slot];
    // wall 1: capability must be active
    if (!cap.active) return CapError.CapExpired;
    // wall 2: requested rights must be within the mask
    if ((requested & cap.rights) != requested)
        return CapError.CapRightsInsufficient;
    // Reach handle granted -- on a real system this would return
    // a handle to the backing store. Here the proof is that we
    // passed both walls.
}

fn tick_leases(domain: *Domain) u32 {
    var expired: u32 = 0;
    var i: u32 = 0;
    while (i < domain.cap_count) : (i += 1) {
        if (domain.caps[i].active and domain.caps[i].lease > 0) {
            domain.caps[i].lease -= 1;
            if (domain.caps[i].lease == 0) {
                domain.caps[i].active = false;
                expired += 1;
            }
        }
    }
    return expired;
}

// -- Domain registry --------------------------------------------------

const DomainRegistry = struct {
    domains: [max_domains]Domain,
    count: u32,

    fn init() DomainRegistry {
        return .{ .domains = undefined, .count = 0 };
    }

    fn create(
        self: *DomainRegistry,
        name: []const u8,
    ) error{RegistryFull}!*Domain {
        assert(self.count <= max_domains);
        if (self.count >= max_domains) return error.RegistryFull;
        const idx = self.count;
        self.domains[idx] = .{
            .id = idx,
            .name_ptr = name.ptr,
            .name_len = @intCast(name.len),
            .caps = undefined,
            .cap_count = 0,
        };
        self.count += 1;
        assert(self.count <= max_domains);
        return &self.domains[idx];
    }
};

fn domain_name(d: *const Domain) []const u8 {
    return d.name_ptr[0..d.name_len];
}

// -- Static backing store (Tally) -------------------------------------
const arena_budget: u32 = 4096;
const arena_base: u32 = 0x80180000;

// -- Main: the Caravan capability proof -------------------------------

export fn kmain() callconv(.c) noreturn {
    uart_print("CARAVAN CAPABILITY MODEL -- freestanding RV32I\n");
    uart_print("TAME stage 5: Caravan governs who may do what\n\n");

    // -- Kumara identity
    const seed: [seed_length]u8 = .{
        0x4B, 0x75, 0x6D, 0x61, 0x72, 0x61, 0x20, 0x73,
        0x65, 0x65, 0x64, 0x20, 0x66, 0x6F, 0x72, 0x20,
        0x66, 0x72, 0x65, 0x65, 0x73, 0x74, 0x61, 0x6E,
        0x64, 0x69, 0x6E, 0x67, 0x20, 0x52, 0x56, 0x49,
    };
    const identity = Identity.init(seed);

    // -- Tally region for Mantra
    var region = Region.init(@ptrFromInt(arena_base), arena_budget);
    uart_print("tally: ");
    print_u32(arena_budget);
    uart_print(" bytes at ");
    print_hex(arena_base);
    uart_print("\n");

    // -- Mantra log
    var log = MantraLog.init(&region, &identity);

    // -- Domain registry
    var registry = DomainRegistry.init();

    // === PROOF 1: Create domains ===
    uart_print("\n-- CREATE DOMAINS --\n");

    const steward = registry.create("steward") catch
        halt_error("ERROR: create steward failed\n");
    uart_print("caravan_cap: domain created -- ");
    uart_print(domain_name(steward));
    uart_print(" (id=");
    print_u32(steward.id);
    uart_print(")\n");
    log.append("caravan: domain steward created");

    const worker = registry.create("worker") catch
        halt_error("ERROR: create worker failed\n");
    uart_print("caravan_cap: domain created -- ");
    uart_print(domain_name(worker));
    uart_print(" (id=");
    print_u32(worker.id);
    uart_print(")\n");
    log.append("caravan: domain worker created");

    uart_print("caravan_cap: registry = ");
    print_u32(registry.count);
    uart_print(" domains\n");

    // === PROOF 2: Confer a capability ===
    uart_print("\n-- CONFER CAPABILITY --\n");

    const cap_rights = right_read | right_write;
    const cap_lease: u32 = 3;
    const slot = confer(
        worker,
        .endpoint,
        cap_rights,
        cap_lease,
        steward.id,
    ) catch halt_error("ERROR: confer failed\n");
    uart_print("caravan_cap: capability CONFERRED to ");
    uart_print(domain_name(worker));
    uart_print(" -- slot=");
    print_u32(slot);
    uart_print(", obj=");
    uart_print(object_name(.endpoint));
    uart_print(", rights=");
    uart_print(rights_name(cap_rights));
    uart_print(", lease=");
    print_u32(cap_lease);
    uart_print(" ticks\n");
    log.append("caravan: capability conferred to worker");

    // === PROOF 3: Exercise the capability ===
    uart_print("\n-- EXERCISE CAPABILITY --\n");

    exercise(worker, slot, right_read) catch
        halt_error("ERROR: exercise read failed\n");
    uart_print("caravan_cap: capability EXERCISED -- ");
    uart_print(domain_name(worker));
    uart_print(" read on ");
    uart_print(object_name(.endpoint));
    uart_print(", lease=");
    print_u32(worker.caps[slot].lease);
    uart_print("\n");
    log.append("caravan: worker exercised read on endpoint");

    exercise(worker, slot, right_write) catch
        halt_error("ERROR: exercise write failed\n");
    uart_print("caravan_cap: capability EXERCISED -- ");
    uart_print(domain_name(worker));
    uart_print(" write on ");
    uart_print(object_name(.endpoint));
    uart_print(", lease=");
    print_u32(worker.caps[slot].lease);
    uart_print("\n");
    log.append("caravan: worker exercised write on endpoint");

    // === PROOF 4: Rights wall -- execute refused (RW only) ===
    uart_print("\n-- RIGHTS WALL --\n");

    if (exercise(worker, slot, right_execute)) |_| {
        halt_error("ERROR: execute should be refused on RW cap\n");
    } else |err| {
        assert(err == CapError.CapRightsInsufficient);
        uart_print("caravan_cap: exercise REFUSED -- ");
        uart_print(domain_name(worker));
        uart_print(" execute on ");
        uart_print(object_name(.endpoint));
        uart_print(" (rights insufficient, W xor X)\n");
    }
    log.append("caravan: execute refused -- rights wall");

    // === PROOF 5: Tick leases until expiry ===
    uart_print("\n-- TICK LEASES --\n");

    var tick: u32 = 0;
    while (tick < cap_lease) : (tick += 1) {
        const expired = tick_leases(worker);
        uart_print("caravan_cap: tick ");
        print_u32(tick + 1);
        uart_print(" -- lease=");
        print_u32(worker.caps[slot].lease);
        if (expired > 0) {
            uart_print(", EXPIRED ");
            print_u32(expired);
        }
        uart_print("\n");
    }
    assert(!worker.caps[slot].active);
    assert(worker.caps[slot].lease == 0);
    log.append("caravan: capability expired after lease");

    // === PROOF 6: Exercise after expiry -- refused ===
    uart_print("\n-- EXERCISE AFTER EXPIRY --\n");

    if (exercise(worker, slot, right_read)) |_| {
        halt_error("ERROR: exercise should fail after expiry\n");
    } else |err| {
        assert(err == CapError.CapExpired);
        uart_print("caravan_cap: exercise REFUSED -- ");
        uart_print(domain_name(worker));
        uart_print(" capability expired (lease=0)\n");
    }
    log.append("caravan: exercise refused -- capability expired");

    // === PROOF 7: Revoke an active capability ===
    uart_print("\n-- REVOKE CAPABILITY --\n");

    const slot2 = confer(
        worker,
        .notification,
        right_read,
        10,
        steward.id,
    ) catch halt_error("ERROR: confer slot2 failed\n");
    uart_print("caravan_cap: conferred notification R to ");
    uart_print(domain_name(worker));
    uart_print(", slot=");
    print_u32(slot2);
    uart_print("\n");

    revoke(worker, slot2) catch
        halt_error("ERROR: revoke failed\n");
    uart_print("caravan_cap: capability REVOKED -- ");
    uart_print(domain_name(worker));
    uart_print(" slot=");
    print_u32(slot2);
    uart_print("\n");
    log.append("caravan: capability revoked by steward");

    if (exercise(worker, slot2, right_read)) |_| {
        halt_error("ERROR: exercise after revoke should fail\n");
    } else |err| {
        assert(err == CapError.CapExpired);
        uart_print("caravan_cap: exercise after revoke REFUSED\n");
    }

    // === PROOF 8: Cap table ceiling ===
    uart_print("\n-- CAP TABLE CEILING --\n");

    var fill: u32 = worker.cap_count;
    while (fill < max_caps_per_domain) : (fill += 1) {
        _ = confer(worker, .untyped, right_read, 1, steward.id) catch
            halt_error("ERROR: fill cap table failed\n");
    }
    assert(worker.cap_count == max_caps_per_domain);
    uart_print("caravan_cap: cap table filled to ");
    print_u32(max_caps_per_domain);
    uart_print(" slots\n");

    if (confer(worker, .untyped, right_read, 1, steward.id)) |_| {
        halt_error("ERROR: cap table overflow not refused\n");
    } else |err| {
        assert(err == CapError.CapTableFull);
        uart_print("caravan_cap: REFUSED -- CapTableFull at ");
        print_u32(max_caps_per_domain);
        uart_print(" slots\n");
    }
    log.append("caravan: cap table ceiling enforced");

    // === PROOF 9: Domain registry ceiling ===
    uart_print("\n-- DOMAIN REGISTRY CEILING --\n");

    var dom_fill: u32 = registry.count;
    while (dom_fill < max_domains) : (dom_fill += 1) {
        _ = registry.create("filler") catch
            halt_error("ERROR: fill registry failed\n");
    }
    assert(registry.count == max_domains);

    if (registry.create("overflow")) |_| {
        halt_error("ERROR: registry overflow not refused\n");
    } else |err| {
        assert(err == error.RegistryFull);
        uart_print("caravan_cap: REFUSED -- RegistryFull at ");
        print_u32(max_domains);
        uart_print(" domains\n");
    }
    log.append("caravan: domain registry ceiling enforced");

    // -- Final report
    uart_print("\n========================================\n");
    uart_print("caravan_cap: ALL PROOFS PASSED\n\n");
    uart_print("  domains:    create, isolate, bounded\n");
    uart_print("  confer:     capability granted with lease\n");
    uart_print("  exercise:   both walls checked (cap + rights)\n");
    uart_print("  expire:     lease countdown, auto-expire\n");
    uart_print("  revoke:     active capability withdrawn\n");
    uart_print("  ceilings:   cap table + domain registry\n\n");
    uart_print("  mantra facts: ");
    print_u32(log.count);
    uart_print(", state hash: ");
    print_hex(log.state_hash);
    uart_print("\n  tally used: ");
    print_u32(region.pos);
    uart_print(" of ");
    print_u32(region.cap);
    uart_print(" bytes\n\n");
    uart_print("caravan_cap: Orbit 21 complete\n");
    uart_print("========================================\n");

    halt_pass();
}
