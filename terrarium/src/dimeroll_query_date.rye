const txn_count: u32 = 9;

// =========================================================
// FACT BUILDER
// =========================================================

var fact_buf: [128]u8 = undefined;
var fact_len: u32 = 0;

fn buf_append_str(s: []const u8) void {
    for (s) |c| {
        if (fact_len < 128) {
            fact_buf[fact_len] = c;
            fact_len += 1;
        }
    }
}

fn buf_append_u32(val: u32) void {
    if (val == 0) {
        if (fact_len < 128) {
            fact_buf[fact_len] = '0';
            fact_len += 1;
        }
        return;
    }
    var tmp: [10]u8 = undefined;
    var n: u32 = 0;
    var v = val;
    while (v > 0) : (n += 1) {
        tmp[n] = @intCast(v % 10 + '0');
        v /= 10;
    }
    var i: u32 = n;
    while (i > 0) {
        i -= 1;
        if (fact_len < 128) {
            fact_buf[fact_len] = tmp[i];
            fact_len += 1;
        }
    }
}

fn build_fact(
    txn: *const TransactionRecord,
) []const u8 {
    fact_len = 0;
    buf_append_str(txn.verb.name());
    buf_append_str(":");
    buf_append_str(txn.subject);
    buf_append_str("=qty=");
    buf_append_u32(txn.qty);
    if (txn.has_unit) {
        buf_append_str(",unit=");
        buf_append_str(txn.unit);
    }
    if (txn.has_price) {
        buf_append_str(",price=");
        buf_append_u32(txn.price_cents);
    }
    return fact_buf[0..fact_len];
}

// =========================================================
// QUERY ENGINE -- filter transactions by date range
// =========================================================

const max_results: u32 = 9;

const QueryResult = struct {
    indices: [9]u32,
    count: u32,

    fn init() QueryResult {
        var r: QueryResult = undefined;
        r.count = 0;
        var i: u32 = 0;
        while (i < 9) : (i += 1) {
            r.indices[i] = 0;
        }
        return r;
    }
};

fn query_by_date_range(
    from_day: u32,
    to_day: u32,
) QueryResult {
    // invariant: from_day <= to_day
    assert(from_day <= to_day);
    var result = QueryResult.init();
    var i: u32 = 0;
    while (i < txn_count) : (i += 1) {
        if (transactions[i].day >= from_day
            and transactions[i].day <= to_day)
        {
            assert(result.count < max_results);
            result.indices[result.count] = i;
            result.count += 1;
        }
    }
    return result;
}

// =========================================================
// STRING + PROOF HELPERS
// =========================================================

var proof_count: u32 = 0;
var proof_pass: u32 = 0;

fn check(name: []const u8, ok: bool) void {
    proof_count += 1;
    if (ok) {
        proof_pass += 1;
        uart_print("  PASS: ");
    } else {
        uart_print("  FAIL: ");
    }
    uart_print(name);
    uart_print("\n");
}

fn aurora_pad(s: []const u8, width: u32) void {
    uart_print(s);
    if (s.len < width) {
        var i: u32 = @intCast(s.len);
        while (i < width) : (i += 1) uart_tx(' ');
    }
}

fn aurora_pad_num(v: u32, width: u32) void {
    var buf: [10]u8 = undefined;
    var n: u32 = 0;
    var val = v;
    if (val == 0) {
        n = 1;
        buf[0] = '0';
    } else {
        while (val > 0) : (n += 1) {
            buf[n] = @intCast(val % 10 + '0');
            val /= 10;
        }
    }
    if (n < width) {
        var pad: u32 = width - n;
        while (pad > 0) : (pad -= 1) uart_tx(' ');
    }
    var i: u32 = n;
    while (i > 0) {
        i -= 1;
        uart_tx(buf[i]);
    }
}

// =========================================================
// DISPLAY -- print date-filtered results over UART
// =========================================================

fn display_date_result(
    from_day: u32,
    to_day: u32,
    result: *const QueryResult,
) void {
    uart_print("\n  Query: days ");
    print_u32(from_day);
    uart_print(" to ");
    print_u32(to_day);
    uart_print("\n");
    uart_print(
        "  # | Day | Verb     | Subject  | Qty\n",
    );
    uart_print(
        "  --|-----|----------|----------|------\n",
    );
    var i: u32 = 0;
    while (i < result.count) : (i += 1) {
        const idx = result.indices[i];
        const txn = &transactions[idx];
        uart_print("  ");
        print_u32(i + 1);
        uart_print(" | ");
        aurora_pad_num(txn.day, 3);
        uart_print(" | ");
        aurora_pad(txn.verb.name(), 8);
        uart_print(" | ");
        aurora_pad(txn.subject, 8);
        uart_print(" | ");
        aurora_pad_num(txn.qty, 5);
        uart_print("\n");
    }
    uart_print("  results: ");
    print_u32(result.count);
    uart_print("\n");
}

// =========================================================
// KUMARA SEED + ENTRY
// =========================================================

const kumara_seed = [32]u8{
    0x4B, 0x75, 0x6D, 0x61, 0x72, 0x61, 0x20, 0x73,
    0x65, 0x65, 0x64, 0x20, 0x66, 0x6F, 0x72, 0x20,
    0x66, 0x72, 0x65, 0x65, 0x73, 0x74, 0x61, 0x6E,
    0x64, 0x69, 0x6E, 0x67, 0x20, 0x52, 0x56, 0x49,
};

comptime {
    asm (
        \\.section .text.init,"ax"
        \\.globl _start
        \\_start:
        \\  li sp, 0x80100000
        \\  j kmain
    );
}

export fn kmain() callconv(.c) noreturn {
    uart_print(
        "=== Dimeroll Query Engine: Date Range ===\n\n",
    );

    // Initialize Mantra
    var identity = Identity.init(kumara_seed);
    var log_region = Region.init(
        log_region_base,
        region_budget,
    );
    var replay_region = Region.init(
        replay_region_base,
        region_budget,
    );
    var log = MantraLog.init(
        &log_region,
        &identity,
    );
    var replay_log = MantraLog.init(
        &replay_region,
        &identity,
    );

    // -- PHASE 1: LOG ALL TRANSACTIONS --
    uart_print("-- phase 1: log transactions --\n\n");

    var facts_logged: u32 = 0;
    var ti: u32 = 0;
    while (ti < txn_count) : (ti += 1) {
        const txn = &transactions[ti];
        const fact = build_fact(txn);
        uart_print("[day ");
        print_u32(txn.day);
        uart_print("] ");
        uart_print(txn.verb.name());
        uart_print(" ");
        uart_print(txn.subject);
        uart_print(" ");
        print_u32(txn.qty);
        if (txn.has_unit) {
            uart_print(" ");
            uart_print(txn.unit);
        }
        if (txn.has_price) {
            uart_print(" @");
            print_u32(txn.price_cents);
        }
        uart_print("\n");
        if (log.append(fact)) |_| {
            facts_logged += 1;
        }
    }
    uart_print("\n");
    check(
        "9 transactions logged",
        facts_logged == 9,
    );
    check(
        "Mantra hash 0xe9cf083f",
        log.state_hash == 0xe9cf083f,
    );

    // -- PHASE 2: QUERY BY DATE RANGE --
    uart_print(
        "\n-- phase 2: query by date range --\n",
    );

    // Query: days 8-10 "last 3 days" (expect 2)
    const q_last3 = query_by_date_range(8, 10);
    display_date_result(8, 10, &q_last3);
    check(
        "days 8-10 returns 2 results",
        q_last3.count == 2,
    );
    check(
        "days 8-10[0] is sell tomatoes 15",
        q_last3.indices[0] == 7
            and transactions[q_last3.indices[0]]
                .verb == .sell
            and transactions[q_last3.indices[0]]
                .qty == 15,
    );
    check(
        "days 8-10[1] is note rainfall 25",
        q_last3.indices[1] == 8
            and transactions[q_last3.indices[1]]
                .verb == .note
            and transactions[q_last3.indices[1]]
                .qty == 25,
    );

    // Query: days 1-7 "first week" (expect 7)
    const q_week1 = query_by_date_range(1, 7);
    display_date_result(1, 7, &q_week1);
    check(
        "days 1-7 returns 7 results",
        q_week1.count == 7,
    );
    check(
        "days 1-7[0] is plant tomatoes",
        q_week1.indices[0] == 0
            and transactions[q_week1.indices[0]]
                .verb == .plant
            and transactions[q_week1.indices[0]]
                .qty == 200,
    );
    check(
        "days 1-7[6] is compost leaves",
        q_week1.indices[6] == 6
            and transactions[q_week1.indices[6]]
                .verb == .compost
            and transactions[q_week1.indices[6]]
                .qty == 30,
    );

    // Query: days 3-5 "mid range" (expect 4)
    const q_mid = query_by_date_range(3, 5);
    display_date_result(3, 5, &q_mid);
    check(
        "days 3-5 returns 4 results",
        q_mid.count == 4,
    );
    check(
        "days 3-5[0] is harvest tomatoes 60",
        q_mid.indices[0] == 2
            and transactions[q_mid.indices[0]]
                .verb == .harvest
            and transactions[q_mid.indices[0]]
                .qty == 60,
    );
    check(
        "days 3-5[1] is sell tomatoes 30",
        q_mid.indices[1] == 3
            and transactions[q_mid.indices[1]]
                .verb == .sell
            and transactions[q_mid.indices[1]]
                .qty == 30,
    );
    check(
        "days 3-5[2] is harvest peppers 25",
        q_mid.indices[2] == 4
            and transactions[q_mid.indices[2]]
                .verb == .harvest
            and transactions[q_mid.indices[2]]
                .qty == 25,
    );
    check(
        "days 3-5[3] is sell peppers 10",
        q_mid.indices[3] == 5
            and transactions[q_mid.indices[3]]
                .verb == .sell
            and transactions[q_mid.indices[3]]
                .qty == 10,
    );

    // Query: day 1 only (expect 2)
    const q_day1 = query_by_date_range(1, 1);
    display_date_result(1, 1, &q_day1);
    check(
        "day 1 returns 2 results",
        q_day1.count == 2,
    );
    check(
        "day 1[0] is plant tomatoes",
        q_day1.indices[0] == 0
            and transactions[q_day1.indices[0]]
                .verb == .plant,
    );
    check(
        "day 1[1] is plant peppers",
        q_day1.indices[1] == 1
            and transactions[q_day1.indices[1]]
                .verb == .plant,
    );

    // Query: days 11-15 "empty range" (expect 0)
    const q_empty = query_by_date_range(11, 15);
    check(
        "days 11-15 returns 0 results",
        q_empty.count == 0,
    );

    // -- PHASE 3: COMPLETENESS --
    uart_print(
        "\n-- phase 3: completeness --\n\n",
    );

    const total_found = q_week1.count +
        q_last3.count;
    check(
        "week1 + last3 cover all 9 transactions",
        total_found == 9,
    );

    // -- PHASE 4: REPLAY IDENTITY --
    uart_print(
        "\n-- phase 4: replay identity --\n\n",
    );

    var ri: u32 = 0;
    while (ri < txn_count) : (ri += 1) {
        const fact = build_fact(&transactions[ri]);
        _ = replay_log.append(fact);
    }
    check(
        "replay count matches",
        replay_log.count == log.count,
    );
    check(
        "REPLAY MATCHES: identical state proven",
        replay_log.state_hash == log.state_hash,
    );

    // -- SUMMARY --
    uart_print("\n-- summary --\n\n");
    uart_print("  days 8-10:  ");
    print_u32(q_last3.count);
    uart_print(" results (last 3 days)\n");
    uart_print("  days 1-7:   ");
    print_u32(q_week1.count);
    uart_print(" results (first week)\n");
    uart_print("  days 3-5:   ");
    print_u32(q_mid.count);
    uart_print(" results (mid range)\n");
    uart_print("  day 1:      ");
    print_u32(q_day1.count);
    uart_print(" results (single day)\n");
    uart_print("  days 11-15: ");
    print_u32(q_empty.count);
    uart_print(" results (empty range)\n");
    uart_print("  total:      ");
    print_u32(total_found);
    uart_print(" (all 9 accounted for)\n");
    uart_print("  Mantra:     ");
    print_hex32(log.state_hash);
    uart_print("\n");

    uart_print("\nproofs: ");
    print_u32(proof_pass);
    uart_print("/");
    print_u32(proof_count);
    uart_print("\n");

    if (proof_pass == proof_count) {
        uart_print("ALL PROOFS PASSED\n");
    }

    uart_print("dimeroll_query_date complete\n");

    halt_ok();
}
