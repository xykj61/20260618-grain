const std = @import("std");
const assert = std.debug.assert;

// =========================================================
// HARDWARE -- UART + TEST FINISHER
// =========================================================

const uart_base: usize = 0x10000000;
const test_finisher: usize = 0x00100000;

const log_region_base: usize = 0x80260000;
const replay_region_base: usize = 0x80270000;
const region_budget: u32 = 0x10000;

fn uart_tx(c: u8) void {
    const ptr: *volatile u8 = @ptrFromInt(uart_base);
    ptr.* = c;
}

fn uart_print(s: []const u8) void {
    for (s) |c| uart_tx(c);
}

fn print_u32(val: u32) void {
    if (val == 0) {
        uart_tx('0');
        return;
    }
    var buf: [10]u8 = undefined;
    var n: u32 = 0;
    var v = val;
    while (v > 0) : (n += 1) {
        buf[n] = @intCast(v % 10 + '0');
        v /= 10;
    }
    var i: u32 = n;
    while (i > 0) {
        i -= 1;
        uart_tx(buf[i]);
    }
}

fn print_hex32(val: u32) void {
    uart_print("0x");
    const hex = "0123456789abcdef";
    var shift: u5 = 28;
    while (true) {
        const nib: u4 = @intCast(
            (val >> shift) & 0xF,
        );
        uart_tx(hex[nib]);
        if (shift == 0) break;
        shift -= 4;
    }
}

fn halt_ok() noreturn {
    const p: *volatile u32 = @ptrFromInt(
        test_finisher,
    );
    p.* = 0x5555;
    while (true) {}
}

// =========================================================
// REGION ALLOCATOR
// =========================================================

const Region = struct {
    base: usize,
    budget: u32,
    used: u32,

    fn init(base: usize, budget: u32) Region {
        return .{
            .base = base,
            .budget = budget,
            .used = 0,
        };
    }

    fn alloc(self: *Region, size: u32) ?[*]u8 {
        // invariant: allocation bounded by budget
        assert(size <= self.budget);
        if (self.used + size > self.budget)
            return null;
        const ptr: [*]u8 = @ptrFromInt(
            self.base + self.used,
        );
        self.used += size;
        return ptr;
    }
};

// =========================================================
// DJB2 HASH
// =========================================================

const Djb2 = struct {
    hash: u32,

    fn init() Djb2 {
        return .{ .hash = 5381 };
    }

    fn update(self: *Djb2, data: []const u8) void {
        for (data) |b| {
            self.hash = self.hash *% 33 +% b;
        }
    }

    fn finish(self: *const Djb2) u32 {
        return self.hash;
    }
};

// =========================================================
// IDENTITY (Kumara seed + djb2 signing)
// =========================================================

const Identity = struct {
    seed: [32]u8,

    fn init(seed: [32]u8) Identity {
        return .{ .seed = seed };
    }

    fn sign(
        self: *const Identity,
        data: []const u8,
    ) u32 {
        var h = Djb2.init();
        h.update(&self.seed);
        h.update(data);
        return h.finish();
    }
};

// =========================================================
// MANTRA LOG
// =========================================================

const MantraLog = struct {
    region: *Region,
    identity: *Identity,
    count: u32,
    state_hash: u32,

    fn init(
        region: *Region,
        identity: *Identity,
    ) MantraLog {
        return .{
            .region = region,
            .identity = identity,
            .count = 0,
            .state_hash = 0,
        };
    }

    fn append(
        self: *MantraLog,
        fact: []const u8,
    ) ?u32 {
        // invariant: fact fits in region
        const total: u32 = @intCast(fact.len + 4);
        const ptr = self.region.alloc(total) orelse
            return null;
        const sig = self.identity.sign(fact);
        ptr[0] = @intCast(sig & 0xFF);
        ptr[1] = @intCast((sig >> 8) & 0xFF);
        ptr[2] = @intCast((sig >> 16) & 0xFF);
        ptr[3] = @intCast((sig >> 24) & 0xFF);
        var i: u32 = 0;
        while (i < fact.len) : (i += 1) {
            ptr[4 + i] = fact[i];
        }
        self.state_hash = self.state_hash *% 31 +% sig;
        self.count += 1;
        return self.count - 1;
    }
};

// =========================================================
// TRANSACTION DATA (with day field)
// =========================================================

const GlowVerb = enum(u8) {
    plant = 0,
    harvest = 1,
    sell = 2,
    compost = 3,
    note = 4,

    fn name(self: GlowVerb) []const u8 {
        return switch (self) {
            .plant => "plant",
            .harvest => "harvest",
            .sell => "sell",
            .compost => "compost",
            .note => "note",
        };
    }
};

const TransactionRecord = struct {
    verb: GlowVerb,
    subject: []const u8,
    qty: u32,
    unit: []const u8,
    price_cents: u32,
    has_unit: bool,
    has_price: bool,
    day: u32,
};

