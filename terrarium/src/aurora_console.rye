    .{ 0x3c, 0x42, 0x42, 0x4a, 0x44, 0x3a, 0x00, 0x00 },
    // 0x52 R
    .{ 0x7c, 0x42, 0x42, 0x7c, 0x44, 0x42, 0x00, 0x00 },
