    // 0x44 D
    .{ 0x78, 0x44, 0x42, 0x42, 0x44, 0x78, 0x00, 0x00 },
    // 0x45 E
    .{ 0x7e, 0x40, 0x7c, 0x40, 0x40, 0x7e, 0x00, 0x00 },
    // 0x46 F
    .{ 0x7e, 0x40, 0x7c, 0x40, 0x40, 0x40, 0x00, 0x00 },
    // 0x47 G
    .{ 0x3c, 0x42, 0x40, 0x4e, 0x42, 0x3c, 0x00, 0x00 },
    // 0x48 H
    .{ 0x42, 0x42, 0x7e, 0x42, 0x42, 0x42, 0x00, 0x00 },
