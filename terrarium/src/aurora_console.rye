    .{ 0x40, 0x40, 0x5c, 0x62, 0x42, 0x42, 0x42, 0x00 },
    // 0x69 i
    .{ 0x18, 0x00, 0x38, 0x18, 0x18, 0x18, 0x3c, 0x00 },
    // 0x6A j
    .{ 0x06, 0x00, 0x06, 0x06, 0x06, 0x06, 0x46, 0x3c },
    // 0x6B k
    .{ 0x40, 0x40, 0x44, 0x48, 0x70, 0x48, 0x44, 0x00 },
    // 0x6C l
    .{ 0x38, 0x18, 0x18, 0x18, 0x18, 0x18, 0x3c, 0x00 },
    // 0x6D m
    .{ 0x00, 0x00, 0x76, 0x4a, 0x4a, 0x4a, 0x4a, 0x00 },
    // 0x6E n
    .{ 0x00, 0x00, 0x5c, 0x62, 0x42, 0x42, 0x42, 0x00 },
    // 0x6F o
    .{ 0x00, 0x00, 0x3c, 0x42, 0x42, 0x42, 0x3c, 0x00 },
    // 0x70 p
    .{ 0x00, 0x00, 0x5c, 0x62, 0x62, 0x5c, 0x40, 0x40 },
    // 0x71 q
    .{ 0x00, 0x00, 0x3a, 0x46, 0x46, 0x3a, 0x02, 0x02 },
    // 0x72 r
    .{ 0x00, 0x00, 0x5c, 0x62, 0x40, 0x40, 0x40, 0x00 },
    // 0x73 s
    .{ 0x00, 0x00, 0x3e, 0x40, 0x3c, 0x02, 0x7c, 0x00 },
    // 0x74 t
    .{ 0x10, 0x10, 0x3c, 0x10, 0x10, 0x12, 0x0c, 0x00 },
    // 0x75 u
    .{ 0x00, 0x00, 0x42, 0x42, 0x42, 0x46, 0x3a, 0x00 },
    // 0x76 v
    .{ 0x00, 0x00, 0x42, 0x42, 0x42, 0x24, 0x18, 0x00 },
    // 0x77 w
    .{ 0x00, 0x00, 0x42, 0x42, 0x5a, 0x66, 0x42, 0x00 },
    // 0x78 x
    .{ 0x00, 0x00, 0x42, 0x24, 0x18, 0x24, 0x42, 0x00 },
    // 0x79 y
    .{ 0x00, 0x00, 0x42, 0x42, 0x46, 0x3a, 0x02, 0x3c },
    // 0x7A z
    .{ 0x00, 0x00, 0x7e, 0x04, 0x18, 0x20, 0x7e, 0x00 },
    // 0x7B {
    .{ 0x0c, 0x10, 0x10, 0x60, 0x10, 0x10, 0x0c, 0x00 },
    // 0x7C |
    .{ 0x18, 0x18, 0x18, 0x00, 0x18, 0x18, 0x18, 0x00 },
    // 0x7D }
    .{ 0x30, 0x08, 0x08, 0x06, 0x08, 0x08, 0x30, 0x00 },
    // 0x7E ~
    .{ 0x00, 0x00, 0x32, 0x4c, 0x00, 0x00, 0x00, 0x00 },
};

// -- fw_cfg helpers (from framebuf.rye) ------------------------------

fn fwcfg_select(key: u16) void {
    fwcfg_selector.* = @byteSwap(key);
}

fn fwcfg_read_byte() u8 {
    return fwcfg_data.*;
}

fn fwcfg_read_be16() u16 {
    var val: u16 = 0;
    val = (@as(u16, fwcfg_read_byte()) << 8) |
        @as(u16, fwcfg_read_byte());
    return val;
}

fn fwcfg_read_be32() u32 {
    var val: u32 = 0;
    val = (@as(u32, fwcfg_read_byte()) << 24) |
        (@as(u32, fwcfg_read_byte()) << 16) |
        (@as(u32, fwcfg_read_byte()) << 8) |
        @as(u32, fwcfg_read_byte());
    return val;
}

fn find_ramfb_selector() ?u16 {
    fwcfg_select(0x0019);
    const count = fwcfg_read_be32();
    // invariant: virt machine has at least one fw_cfg entry
    assert(count > 0);
    // invariant: count bounded
    assert(count < 256);

    var i: u32 = 0;
    while (i < count) : (i += 1) {
        _ = fwcfg_read_be32();
        const sel = fwcfg_read_be16();
        _ = fwcfg_read_be16();
        var name: [56]u8 = undefined;
        for (&name) |*b| b.* = fwcfg_read_byte();
        if (str_eq(&name, "etc/ramfb")) return sel;
    }

    return null;
}

fn str_eq(buf: *const [56]u8, target: []const u8) bool {
    if (target.len > 56) return false;
    for (target, 0..) |c, idx| {
        if (buf[idx] != c) return false;
    }
    if (target.len < 56) return buf[target.len] == 0;
    return true;
}

fn configure_ramfb(selector: u16) void {
    // RAMFBCfg (28 bytes, BE): addr, fourcc, flags, w, h, stride
    write_be64(ramfb_cfg_addr + 0, @as(u64, fb_addr));
    write_be32(ramfb_cfg_addr + 8, drm_format_xrgb8888);
    write_be32(ramfb_cfg_addr + 12, 0);
    write_be32(ramfb_cfg_addr + 16, fb_width);
    write_be32(ramfb_cfg_addr + 20, fb_height);
    write_be32(ramfb_cfg_addr + 24, fb_stride);

    // FWCfgDmaAccess (16 bytes, BE): control, length, address
    const control: u32 =
        (@as(u32, selector) << 16) | 0x18;
    write_be32(dma_struct_addr + 0, control);
    write_be32(dma_struct_addr + 4, 28);
    write_be64(dma_struct_addr + 8, @as(u64, ramfb_cfg_addr));

    // Trigger DMA
    fwcfg_dma_hi.* = @byteSwap(@as(u32, 0));
    fwcfg_dma_lo.* = @byteSwap(dma_struct_addr);

    // Poll until QEMU clears the control field
    var polls: u32 = 0;
    while (read_be32(dma_struct_addr + 0) != 0) : (polls += 1) {
        // invariant: DMA completes within bounded polls
        assert(polls < 1_000_000);
    }
}

// -- Big-endian memory accessors ------------------------------------

fn write_be32(addr: u32, val: u32) void {
    const ptr: *volatile u32 = @ptrFromInt(addr);
    ptr.* = @byteSwap(val);
}

fn write_be64(addr: u32, val: u64) void {
    write_be32(addr, @truncate(val >> 32));
    write_be32(addr + 4, @truncate(val));
}

fn read_be32(addr: u32) u32 {
    const ptr: *volatile u32 = @ptrFromInt(addr);
    return @byteSwap(ptr.*);
}

// -- UART helpers ----------------------------------------------------

fn uart_puts(s: []const u8) void {
    for (s) |byte| uart_tx.* = byte;
}

fn print_u32(val: u32) void {
    if (val == 0) {
        uart_tx.* = '0';
        return;
    }
    var buf: [10]u8 = undefined;
    var n = val;
    var i: u32 = 0;
    while (n > 0) {
        buf[i] = @intCast(n % 10 + '0');
        n = n / 10;
        i += 1;
    }
    while (i > 0) {
        i -= 1;
        uart_tx.* = buf[i];
    }
}

fn halt_error(msg: []const u8) noreturn {
    uart_puts(msg);
    test_finisher.* = finisher_pass;
    while (true) {}
}

fn assert(ok: bool) void {
    if (!ok) unreachable;
}
