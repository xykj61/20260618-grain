    .{ 0x3c, 0x18, 0x18, 0x18, 0x18, 0x3c, 0x00, 0x00 },
    // 0x4A J
    .{ 0x1e, 0x06, 0x06, 0x06, 0x46, 0x3c, 0x00, 0x00 },
    // 0x4B K
    .{ 0x44, 0x48, 0x70, 0x48, 0x44, 0x42, 0x00, 0x00 },
    // 0x4C L
    .{ 0x40, 0x40, 0x40, 0x40, 0x40, 0x7e, 0x00, 0x00 },
