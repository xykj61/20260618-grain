    .{ 0x42, 0x66, 0x5a, 0x42, 0x42, 0x42, 0x00, 0x00 },
    // 0x4E N
    .{ 0x42, 0x62, 0x52, 0x4a, 0x46, 0x42, 0x00, 0x00 },
