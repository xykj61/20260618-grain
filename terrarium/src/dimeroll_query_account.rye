const txn_count: u32 = 9;

// =========================================================
// FACT BUILDER
// =========================================================

var fact_buf: [128]u8 = undefined;
var fact_len: u32 = 0;

fn buf_append_str(s: []const u8) void {
    for (s) |c| {
        if (fact_len < 128) {
            fact_buf[fact_len] = c;
            fact_len += 1;
        }
    }
}

fn buf_append_u32(val: u32) void {
    if (val == 0) {
        if (fact_len < 128) {
            fact_buf[fact_len] = '0';
            fact_len += 1;
        }
        return;
    }
    var tmp: [10]u8 = undefined;
    var n: u32 = 0;
    var v = val;
    while (v > 0) : (n += 1) {
        tmp[n] = @intCast(v % 10 + '0');
        v /= 10;
    }
    var i: u32 = n;
    while (i > 0) {
        i -= 1;
        if (fact_len < 128) {
            fact_buf[fact_len] = tmp[i];
            fact_len += 1;
        }
    }
}

fn build_fact(
    txn: *const TransactionRecord,
) []const u8 {
    fact_len = 0;
    buf_append_str(txn.verb.name());
    buf_append_str(":");
    buf_append_str(txn.subject);
    buf_append_str("=qty=");
    buf_append_u32(txn.qty);
    if (txn.has_unit) {
        buf_append_str(",unit=");
        buf_append_str(txn.unit);
    }
    if (txn.has_price) {
        buf_append_str(",price=");
        buf_append_u32(txn.price_cents);
    }
    return fact_buf[0..fact_len];
}

// =========================================================
// QUERY ENGINE -- filter by subject and by account
// =========================================================

const max_results: u32 = 9;

const QueryResult = struct {
    indices: [9]u32,
    count: u32,

    fn init() QueryResult {
        var r: QueryResult = undefined;
        r.count = 0;
        var i: u32 = 0;
        while (i < 9) : (i += 1) {
            r.indices[i] = 0;
        }
        return r;
    }
};

fn str_eq(a: []const u8, b: []const u8) bool {
    if (a.len != b.len) return false;
    var i: usize = 0;
    while (i < a.len) : (i += 1) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

fn query_by_subject(
    subject: []const u8,
) QueryResult {
    // invariant: result count bounded by txn_count
    var result = QueryResult.init();
    var i: u32 = 0;
    while (i < txn_count) : (i += 1) {
        if (str_eq(
            transactions[i].subject,
            subject,
        )) {
            assert(result.count < max_results);
            result.indices[result.count] = i;
            result.count += 1;
        }
    }
    return result;
}

fn query_sells_by_subject(
    subject: []const u8,
) QueryResult {
    // invariant: result count bounded by txn_count
    var result = QueryResult.init();
    var i: u32 = 0;
    while (i < txn_count) : (i += 1) {
        if (transactions[i].verb == .sell
            and str_eq(
                transactions[i].subject,
                subject,
            ))
        {
            assert(result.count < max_results);
            result.indices[result.count] = i;
            result.count += 1;
        }
    }
    return result;
}

fn sum_revenue(
    result: *const QueryResult,
) u32 {
    // invariant: only sell transactions have revenue
    var total: u32 = 0;
    var i: u32 = 0;
    while (i < result.count) : (i += 1) {
        const idx = result.indices[i];
        const txn = &transactions[idx];
        assert(txn.verb == .sell);
        total += txn.qty * txn.price_cents;
    }
    return total;
}

// =========================================================
// PLAIN-TEXT EXPORT -- readable report over UART
// =========================================================

var export_buf: [2048]u8 = undefined;
var export_len: u32 = 0;

fn export_append_str(s: []const u8) void {
    for (s) |c| {
        if (export_len < 2048) {
            export_buf[export_len] = c;
            export_len += 1;
        }
    }
}

fn export_append_u32(val: u32) void {
    if (val == 0) {
        if (export_len < 2048) {
            export_buf[export_len] = '0';
            export_len += 1;
        }
        return;
    }
    var tmp: [10]u8 = undefined;
    var n: u32 = 0;
    var v = val;
    while (v > 0) : (n += 1) {
        tmp[n] = @intCast(v % 10 + '0');
        v /= 10;
    }
    var i: u32 = n;
    while (i > 0) {
        i -= 1;
        if (export_len < 2048) {
            export_buf[export_len] = tmp[i];
            export_len += 1;
        }
    }
}

fn export_append_pad(
    s: []const u8,
    width: u32,
) void {
    export_append_str(s);
    if (s.len < width) {
        var i: u32 = @intCast(s.len);
        while (i < width) : (i += 1) {
            if (export_len < 2048) {
                export_buf[export_len] = ' ';
                export_len += 1;
            }
        }
    }
}

fn export_append_pad_num(
    val: u32,
    width: u32,
) void {
    var tmp: [10]u8 = undefined;
    var n: u32 = 0;
    var v = val;
    if (v == 0) {
        n = 1;
        tmp[0] = '0';
    } else {
        while (v > 0) : (n += 1) {
            tmp[n] = @intCast(v % 10 + '0');
            v /= 10;
        }
    }
    if (n < width) {
        var pad: u32 = width - n;
        while (pad > 0) : (pad -= 1) {
            if (export_len < 2048) {
                export_buf[export_len] = ' ';
                export_len += 1;
            }
        }
    }
    var i: u32 = n;
    while (i > 0) {
        i -= 1;
        if (export_len < 2048) {
            export_buf[export_len] = tmp[i];
            export_len += 1;
        }
    }
}

fn build_account_report(
    subject: []const u8,
    result: *const QueryResult,
    revenue: u32,
) []const u8 {
    export_len = 0;
    export_append_str("--- Cash Flow Report: ");
    export_append_str(subject);
    export_append_str(" ---\n");
    export_append_str(
        " # | Day | Verb     | Qty   "
        ++ "| Unit  | Price | Revenue\n",
    );
    export_append_str(
        "---|-----|----------|-------"
        ++ "|-------|-------|--------\n",
    );
    var i: u32 = 0;
    while (i < result.count) : (i += 1) {
        const idx = result.indices[i];
        const txn = &transactions[idx];
        export_append_str(" ");
        export_append_pad_num(i + 1, 1);
        export_append_str(" | ");
        export_append_pad_num(txn.day, 3);
        export_append_str(" | ");
        export_append_pad(txn.verb.name(), 8);
        export_append_str(" | ");
        export_append_pad_num(txn.qty, 5);
        export_append_str(" | ");
        if (txn.has_unit) {
            export_append_pad(txn.unit, 5);
        } else {
            export_append_str("     ");
        }
        export_append_str(" | ");
        if (txn.has_price) {
            export_append_pad_num(
                txn.price_cents,
                5,
            );
        } else {
            export_append_str("     ");
        }
        export_append_str(" | ");
        if (txn.has_price) {
            export_append_pad_num(
                txn.qty * txn.price_cents,
                7,
            );
        }
        export_append_str("\n");
    }
    export_append_str(
        "---|-----|----------|-------"
        ++ "|-------|-------|--------\n",
    );
    export_append_str(
        " Total revenue:              "
        ++ "                 ",
    );
    export_append_pad_num(revenue, 7);
    export_append_str("\n");
    export_append_str("--- End Report ---\n");
    return export_buf[0..export_len];
}

// =========================================================
// STRING + PROOF HELPERS
// =========================================================

var proof_count: u32 = 0;
var proof_pass: u32 = 0;

fn check(name: []const u8, ok: bool) void {
    proof_count += 1;
    if (ok) {
        proof_pass += 1;
        uart_print("  PASS: ");
    } else {
        uart_print("  FAIL: ");
    }
    uart_print(name);
    uart_print("\n");
}

fn aurora_pad(s: []const u8, width: u32) void {
    uart_print(s);
    if (s.len < width) {
        var i: u32 = @intCast(s.len);
        while (i < width) : (i += 1) uart_tx(' ');
    }
}

fn aurora_pad_num(v: u32, width: u32) void {
    var buf: [10]u8 = undefined;
    var n: u32 = 0;
    var val = v;
    if (val == 0) {
        n = 1;
        buf[0] = '0';
    } else {
        while (val > 0) : (n += 1) {
            buf[n] = @intCast(val % 10 + '0');
            val /= 10;
        }
    }
    if (n < width) {
        var pad: u32 = width - n;
        while (pad > 0) : (pad -= 1) uart_tx(' ');
    }
    var i: u32 = n;
    while (i > 0) {
        i -= 1;
        uart_tx(buf[i]);
    }
}

// =========================================================
// DISPLAY -- print query results over UART
// =========================================================

fn display_subject_result(
    subject: []const u8,
    result: *const QueryResult,
) void {
    uart_print("\n  Query: show all ");
    uart_print(subject);
    uart_print(" transactions\n");
    uart_print(
        "  # | Verb     | Qty   | Unit  | Price\n",
    );
    uart_print(
        "  --|----------|-------|-------|------\n",
    );
    var i: u32 = 0;
    while (i < result.count) : (i += 1) {
        const idx = result.indices[i];
        const txn = &transactions[idx];
        uart_print("  ");
        print_u32(i + 1);
        uart_print(" | ");
        aurora_pad(txn.verb.name(), 8);
        uart_print(" | ");
        aurora_pad_num(txn.qty, 5);
        uart_print(" | ");
        if (txn.has_unit) {
            aurora_pad(txn.unit, 5);
        } else {
            uart_print("     ");
        }
        uart_print(" | ");
        if (txn.has_price) {
            aurora_pad_num(txn.price_cents, 5);
        }
        uart_print("\n");
    }
    uart_print("  results: ");
    print_u32(result.count);
    uart_print("\n");
}

// =========================================================
// KUMARA SEED + ENTRY
// =========================================================

const kumara_seed = [32]u8{
    0x4B, 0x75, 0x6D, 0x61, 0x72, 0x61, 0x20, 0x73,
    0x65, 0x65, 0x64, 0x20, 0x66, 0x6F, 0x72, 0x20,
    0x66, 0x72, 0x65, 0x65, 0x73, 0x74, 0x61, 0x6E,
    0x64, 0x69, 0x6E, 0x67, 0x20, 0x52, 0x56, 0x49,
};

comptime {
    asm (
        \\.section .text.init,"ax"
        \\.globl _start
        \\_start:
        \\  li sp, 0x80100000
        \\  j kmain
    );
}

export fn kmain() callconv(.c) noreturn {
    uart_print(
        "=== Dimeroll Query Engine: Account ===\n\n",
    );

    // Initialize Mantra
    var identity = Identity.init(kumara_seed);
    var log_region = Region.init(
        log_region_base,
        region_budget,
    );
    var replay_region = Region.init(
        replay_region_base,
        region_budget,
    );
    var log = MantraLog.init(
        &log_region,
        &identity,
    );
    var replay_log = MantraLog.init(
        &replay_region,
        &identity,
    );

    // -- PHASE 1: LOG ALL TRANSACTIONS --
    uart_print("-- phase 1: log transactions --\n\n");

    var facts_logged: u32 = 0;
    var ti: u32 = 0;
    while (ti < txn_count) : (ti += 1) {
        const txn = &transactions[ti];
        const fact = build_fact(txn);
        uart_print("[day ");
        print_u32(txn.day);
        uart_print("] ");
        uart_print(txn.verb.name());
        uart_print(" ");
        uart_print(txn.subject);
        uart_print(" ");
        print_u32(txn.qty);
        if (txn.has_unit) {
            uart_print(" ");
            uart_print(txn.unit);
        }
        if (txn.has_price) {
            uart_print(" @");
            print_u32(txn.price_cents);
        }
        uart_print("\n");
        if (log.append(fact)) |_| {
            facts_logged += 1;
        }
    }
    uart_print("\n");
    check(
        "9 transactions logged",
        facts_logged == 9,
    );
    check(
        "Mantra hash 0xe9cf083f",
        log.state_hash == 0xe9cf083f,
    );

    // -- PHASE 2: QUERY BY ACCOUNT --
    uart_print(
        "\n-- phase 2: query by account --\n",
    );

    // Tomatoes: all transactions
    const q_tomatoes = query_by_subject("tomatoes");
    display_subject_result("tomatoes", &q_tomatoes);
    check(
        "tomatoes returns 4 results",
        q_tomatoes.count == 4,
    );
    check(
        "tomatoes[0] is plant 200",
        q_tomatoes.indices[0] == 0
            and transactions[q_tomatoes.indices[0]]
                .verb == .plant
            and transactions[q_tomatoes.indices[0]]
                .qty == 200,
    );
    check(
        "tomatoes[3] is sell 15",
        q_tomatoes.indices[3] == 7
            and transactions[q_tomatoes.indices[3]]
                .verb == .sell
            and transactions[q_tomatoes.indices[3]]
                .qty == 15,
    );

    // Peppers: all transactions
    const q_peppers = query_by_subject("peppers");
    display_subject_result("peppers", &q_peppers);
    check(
        "peppers returns 3 results",
        q_peppers.count == 3,
    );

    // -- PHASE 3: CASH FLOW (sell only) --
    uart_print(
        "\n-- phase 3: cash flow by account --\n",
    );

    // Tomato sales
    const sells_tom = query_sells_by_subject(
        "tomatoes",
    );
    check(
        "tomato sells: 2 transactions",
        sells_tom.count == 2,
    );
    check(
        "tomato sell[0] is sell 30 @250",
        sells_tom.indices[0] == 3
            and transactions[sells_tom.indices[0]]
                .qty == 30
            and transactions[sells_tom.indices[0]]
                .price_cents == 250,
    );
    check(
        "tomato sell[1] is sell 15 @300",
        sells_tom.indices[1] == 7
            and transactions[sells_tom.indices[1]]
                .qty == 15
            and transactions[sells_tom.indices[1]]
                .price_cents == 300,
    );

    const rev_tom = sum_revenue(&sells_tom);
    uart_print("  tomato revenue: ");
    print_u32(rev_tom);
    uart_print(" cents\n");
    check(
        "tomato revenue is 12000",
        rev_tom == 12000,
    );

    // Pepper sales
    const sells_pep = query_sells_by_subject(
        "peppers",
    );
    check(
        "pepper sells: 1 transaction",
        sells_pep.count == 1,
    );

    const rev_pep = sum_revenue(&sells_pep);
    uart_print("  pepper revenue: ");
    print_u32(rev_pep);
    uart_print(" cents\n");
    check(
        "pepper revenue is 3750",
        rev_pep == 3750,
    );

    // Total revenue
    const total_rev = rev_tom + rev_pep;
    uart_print("  total revenue: ");
    print_u32(total_rev);
    uart_print(" cents\n");
    check(
        "total revenue is 15750",
        total_rev == 15750,
    );

    // Non-selling account (no cash flow)
    const sells_leaves = query_sells_by_subject(
        "leaves",
    );
    check(
        "leaves sells: 0 (no cash flow)",
        sells_leaves.count == 0,
    );

    // -- PHASE 4: PLAIN-TEXT EXPORT --
    uart_print(
        "\n-- phase 4: plain-text export --\n\n",
    );

    // Build the tomato cash flow report
    const report_tom = build_account_report(
        "tomatoes",
        &sells_tom,
        rev_tom,
    );

    // Export: transmit entire report over UART
    uart_print("EXPORT_BEGIN\n");
    uart_print(report_tom);
    uart_print("EXPORT_END\n");

    check(
        "export length > 0",
        report_tom.len > 0,
    );
    check(
        "export length bounded",
        report_tom.len <= 2048,
    );

    // Build the pepper report too
    const report_pep = build_account_report(
        "peppers",
        &sells_pep,
        rev_pep,
    );

    uart_print("\nEXPORT_BEGIN\n");
    uart_print(report_pep);
    uart_print("EXPORT_END\n");

    check(
        "pepper export length > 0",
        report_pep.len > 0,
    );

    // -- PHASE 5: REPLAY IDENTITY --
    uart_print(
        "\n-- phase 5: replay identity --\n\n",
    );

    var ri: u32 = 0;
    while (ri < txn_count) : (ri += 1) {
        const fact = build_fact(&transactions[ri]);
        _ = replay_log.append(fact);
    }
    check(
        "replay count matches",
        replay_log.count == log.count,
    );
    check(
        "REPLAY MATCHES: identical state proven",
        replay_log.state_hash == log.state_hash,
    );

    // -- SUMMARY --
    uart_print("\n-- summary --\n\n");
    uart_print("  tomatoes:   ");
    print_u32(q_tomatoes.count);
    uart_print(" total, ");
    print_u32(sells_tom.count);
    uart_print(" sells, revenue ");
    print_u32(rev_tom);
    uart_print("\n");
    uart_print("  peppers:    ");
    print_u32(q_peppers.count);
    uart_print(" total, ");
    print_u32(sells_pep.count);
    uart_print(" sells, revenue ");
    print_u32(rev_pep);
    uart_print("\n");
    uart_print("  total:      revenue ");
    print_u32(total_rev);
    uart_print("\n");
    uart_print("  Mantra:     ");
    print_hex32(log.state_hash);
    uart_print("\n");

    uart_print("\nproofs: ");
    print_u32(proof_pass);
    uart_print("/");
    print_u32(proof_count);
    uart_print("\n");

    if (proof_pass == proof_count) {
        uart_print("ALL PROOFS PASSED\n");
    }

    uart_print("dimeroll_query_account complete\n");

    halt_ok();
}
