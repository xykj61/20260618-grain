// =========================================================
// CASH FLOW TABLE (direct, for reference)
// =========================================================

const CashFlowEntry = struct {
    name_buf: [16]u8,
    name_len: u32,
    revenue: u32,
    active: bool,
};

const CashFlowTable = struct {
    entries: [8]CashFlowEntry,
    count: u32,
    total_revenue: u32,

    fn init() CashFlowTable {
        var t: CashFlowTable = undefined;
        t.count = 0;
        t.total_revenue = 0;
        var i: u32 = 0;
        while (i < 8) : (i += 1) {
            t.entries[i].active = false;
            t.entries[i].revenue = 0;
            t.entries[i].name_len = 0;
        }
        return t;
    }

    fn find_or_create(
        self: *CashFlowTable,
        n: []const u8,
    ) ?*CashFlowEntry {
        // invariant: name length bounded by entry buffer
        assert(n.len <= 16);
        var i: u32 = 0;
        while (i < self.count) : (i += 1) {
            const e = &self.entries[i];
            if (e.active and e.name_len == n.len) {
                var match = true;
                var j: u32 = 0;
                while (j < e.name_len) : (j += 1) {
                    if (e.name_buf[j] != n[j]) {
                        match = false;
                        break;
                    }
                }
                if (match) return e;
            }
        }
        if (self.count >= 8) return null;
        const e = &self.entries[self.count];
        e.active = true;
        e.revenue = 0;
        e.name_len = @intCast(n.len);
        var j: u32 = 0;
        while (j < e.name_len) : (j += 1) {
            e.name_buf[j] = n[j];
        }
        self.count += 1;
        return e;
    }

    fn apply(
        self: *CashFlowTable,
        txn: *const TransactionRecord,
    ) void {
        if (txn.verb == .sell and txn.has_price) {
            const rev = txn.qty * txn.price_cents;
            if (self.find_or_create(
                txn.subject,
            )) |e| {
                e.revenue += rev;
                self.total_revenue += rev;
            }
        }
    }
};

// =========================================================
// FACT BUILDER (verb:subject=qty=N[,unit=U][,price=P])
// =========================================================

var fact_buf: [128]u8 = undefined;
var fact_len: u32 = 0;

fn buf_append_str(s: []const u8) void {
    for (s) |c| {
        if (fact_len < 128) {
            fact_buf[fact_len] = c;
            fact_len += 1;
        }
    }
}

fn buf_append_u32(val: u32) void {
    if (val == 0) {
        if (fact_len < 128) {
            fact_buf[fact_len] = '0';
            fact_len += 1;
        }
        return;
    }
    var tmp: [10]u8 = undefined;
    var n: u32 = 0;
    var v = val;
    while (v > 0) : (n += 1) {
        tmp[n] = @intCast(v % 10 + '0');
        v /= 10;
    }
    var i: u32 = n;
    while (i > 0) {
        i -= 1;
        if (fact_len < 128) {
            fact_buf[fact_len] = tmp[i];
            fact_len += 1;
        }
    }
}

fn build_fact(
    txn: *const TransactionRecord,
) []const u8 {
    fact_len = 0;
    buf_append_str(txn.verb.name());
    buf_append_str(":");
    buf_append_str(txn.subject);
    buf_append_str("=qty=");
    buf_append_u32(txn.qty);
    if (txn.has_unit) {
        buf_append_str(",unit=");
        buf_append_str(txn.unit);
    }
    if (txn.has_price) {
        buf_append_str(",price=");
        buf_append_u32(txn.price_cents);
    }
    return fact_buf[0..fact_len];
}

// =========================================================
// LOG-DERIVED CASH FLOW
//
// Reads raw fact bytes from the Mantra log region,
// parses verb:subject=qty=N[,unit=U][,price=P], and
// rebuilds cash flow from signed facts alone.
// Entry layout: len_u32(4) + sig(4) + fact(flen)
// where len_u32 = 4 + flen.
// =========================================================

const ParsedFact = struct {
    verb_buf: [16]u8,
    verb_len: u32,
    subject_buf: [16]u8,
    subject_len: u32,
    qty: u32,
    price: u32,
    has_price: bool,
    valid: bool,
};

fn parse_fact_slice(
    fact: [*]volatile u8,
    flen: u32,
) ParsedFact {
    var result: ParsedFact = undefined;
    result.valid = false;
    result.verb_len = 0;
    result.subject_len = 0;
    result.qty = 0;
    result.price = 0;
    result.has_price = false;

    if (flen < 3) return result;

    // Find ':' to split verb
    var colon: u32 = 0;
    var found_colon = false;
    var ci: u32 = 0;
    while (ci < flen) : (ci += 1) {
        if (fact[ci] == ':') {
            colon = ci;
            found_colon = true;
            break;
        }
    }
    if (!found_colon) return result;

    // verb
    if (colon > 16) return result;
    var vi: u32 = 0;
    while (vi < colon) : (vi += 1) {
        result.verb_buf[vi] = fact[vi];
    }
    result.verb_len = colon;

    // Find "=qty=" after subject
    const marker = "=qty=";
    const mlen: u32 = 5;
    var mpos: u32 = colon + 1;
    var found_marker = false;
    while (mpos + mlen <= flen) : (mpos += 1) {
        var match = true;
        var mi: u32 = 0;
        while (mi < mlen) : (mi += 1) {
            if (fact[mpos + mi] != marker[mi]) {
                match = false;
                break;
            }
        }
        if (match) {
            found_marker = true;
            break;
        }
    }
    if (!found_marker) return result;

    // subject between colon+1 and mpos
    const sstart = colon + 1;
    const slen = mpos - sstart;
    if (slen > 16 or slen == 0) return result;
    var si: u32 = 0;
    while (si < slen) : (si += 1) {
        result.subject_buf[si] = fact[sstart + si];
    }
    result.subject_len = slen;

    // qty digits start at mpos + mlen
    var qpos = mpos + mlen;
    var qty: u32 = 0;
    while (qpos < flen) : (qpos += 1) {
        const ch = fact[qpos];
        if (ch >= '0' and ch <= '9') {
            qty = qty * 10 + @as(u32, ch - '0');
        } else {
            break;
        }
    }
    result.qty = qty;

    // Look for ",price=" after qty
    const price_marker = ",price=";
    const plen: u32 = 7;
    var ppos: u32 = qpos;
    while (ppos + plen <= flen) : (ppos += 1) {
        var pmatch = true;
        var pi: u32 = 0;
        while (pi < plen) : (pi += 1) {
            if (fact[ppos + pi] != price_marker[pi]) {
                pmatch = false;
                break;
            }
        }
        if (pmatch) {
            // parse price digits
            var dpos = ppos + plen;
            var price_val: u32 = 0;
            while (dpos < flen) : (dpos += 1) {
                const dc = fact[dpos];
                if (dc >= '0' and dc <= '9') {
                    price_val = price_val * 10 +
                        @as(u32, dc - '0');
                } else {
                    break;
                }
            }
            result.price = price_val;
            result.has_price = true;
            break;
        }
    }

    result.valid = true;
    return result;
}

fn verb_matches(
    buf: [16]u8,
    vlen: u32,
    target: []const u8,
) bool {
    if (vlen != target.len) return false;
    var i: u32 = 0;
    while (i < vlen) : (i += 1) {
        if (buf[i] != target[i]) return false;
    }
    return true;
}

fn derive_cashflow_from_log(
    log_base: u32,
    count: u32,
) CashFlowTable {
    var cf = CashFlowTable.init();

    var offset: u32 = 0;
    var i: u32 = 0;
    while (i < count) : (i += 1) {
        const addr = log_base + offset;
        const len_ptr: *volatile u32 = @ptrFromInt(addr);
        const len_u32 = len_ptr.*;
        if (len_u32 < 4) break;
        const flen = len_u32 - 4;
        const fact_ptr: [*]volatile u8 =
            @ptrFromInt(addr + 8);

        const parsed = parse_fact_slice(fact_ptr, flen);
        if (parsed.valid and parsed.has_price) {
            if (verb_matches(
                parsed.verb_buf,
                parsed.verb_len,
                "sell",
            )) {
                const subj =
                    parsed.subject_buf[0..parsed.subject_len];
                const rev = parsed.qty * parsed.price;
                if (cf.find_or_create(subj)) |e| {
                    e.revenue += rev;
                    cf.total_revenue += rev;
                }
            }
        }
        offset += 4 + 4 + flen;
    }

    return cf;
}

fn cashflows_match(
    a: *const CashFlowTable,
    b: *const CashFlowTable,
) bool {
    if (a.count != b.count) return false;
    if (a.total_revenue != b.total_revenue) return false;
    var i: u32 = 0;
    while (i < a.count) : (i += 1) {
        if (a.entries[i].active != b.entries[i].active)
            return false;
        if (a.entries[i].revenue != b.entries[i].revenue)
            return false;
        if (a.entries[i].name_len != b.entries[i].name_len)
            return false;
        var j: u32 = 0;
        while (j < a.entries[i].name_len) : (j += 1) {
            if (a.entries[i].name_buf[j] !=
                b.entries[i].name_buf[j])
                return false;
        }
    }
    return true;
}

// =========================================================
// AURORA -- draw derived cash flow on framebuffer
// =========================================================

fn aurora_draw_cashflow(
    cf: *const CashFlowTable,
) void {
    fb_puts_color(0, 0, "DIMEROLL FIELD LEDGER", color_header);
    fb_puts_color(0, 1, "Cash Flow (from Mantra)", color_accent);
    fb_hr(2);

    fb_puts_color(0, 3, "Subject", color_header);
    fb_puts_color(18, 3, "Revenue", color_header);
    fb_hr(4);

    var i: u32 = 0;
    while (i < cf.count) : (i += 1) {
        if (!cf.entries[i].active) continue;
        const row = 5 + i;
        if (row >= console_rows) break;
        const elen = cf.entries[i].name_len;
        fb_puts_color(
            0,
            row,
            cf.entries[i].name_buf[0..elen],
            color_fg,
        );
        fb_put_u32_right(
            18,
            row,
            cf.entries[i].revenue,
            9,
            color_accent,
        );
    }

    const total_row = 5 + cf.count;
    fb_hr(total_row);
    fb_puts_color(0, total_row + 1, "TOTAL", color_header);
    fb_put_u32_right(
        18,
        total_row + 1,
        cf.total_revenue,
        9,
        color_accent,
    );

    // Net row (no expenses in this dataset)
    fb_puts_color(
        0,
        total_row + 2,
        "Expenses:",
        color_dim,
    );
    fb_put_u32_right(
        18,
        total_row + 2,
        0,
        9,
        color_dim,
    );
    fb_puts_color(
        0,
        total_row + 3,
        "Net:",
        color_header,
    );
    fb_put_u32_right(
        18,
        total_row + 3,
        cf.total_revenue,
        9,
        color_accent,
    );
}

// =========================================================
// UART DISPLAY
// =========================================================

fn aurora_pad(s: []const u8, width: u32) void {
    uart_print(s);
    if (s.len < width) {
        var i: u32 = @intCast(s.len);
        while (i < width) : (i += 1) uart_tx(' ');
    }
}

fn aurora_pad_num(v: u32, width: u32) void {
    var buf: [10]u8 = undefined;
    var n: u32 = 0;
    var val = v;
    if (val == 0) {
        n = 1;
        buf[0] = '0';
    } else {
        while (val > 0) : (n += 1) {
            buf[n] = @intCast(val % 10 + '0');
            val /= 10;
        }
    }
    if (n < width) {
        var pad: u32 = width - n;
        while (pad > 0) : (pad -= 1) uart_tx(' ');
    }
    var i: u32 = n;
    while (i > 0) {
        i -= 1;
        uart_tx(buf[i]);
    }
}

fn uart_display_cashflow(
    cf: *const CashFlowTable,
) void {
    uart_print("\n--- DIMEROLL FIELD LEDGER ---\n");
    uart_print("Cash Flow (from Mantra)\n");
    uart_print("| Subject  | Revenue |\n");
    uart_print("|----------|--------|\n");
    var i: u32 = 0;
    while (i < cf.count) : (i += 1) {
        if (!cf.entries[i].active) continue;
        uart_print("| ");
        const elen = cf.entries[i].name_len;
        aurora_pad(
            cf.entries[i].name_buf[0..elen],
            8,
        );
        uart_print(" | ");
        aurora_pad_num(cf.entries[i].revenue, 6);
        uart_print(" |\n");
    }
    uart_print("|----------|--------|\n");
    uart_print("| TOTAL    | ");
    aurora_pad_num(cf.total_revenue, 6);
    uart_print(" |\n");
    uart_print("| Expenses |      0 |\n");
    uart_print("| Net      | ");
    aurora_pad_num(cf.total_revenue, 6);
    uart_print(" |\n");
}

// =========================================================
// PROOF HARNESS
// =========================================================

var proof_count: u32 = 0;
var proof_pass: u32 = 0;

fn check(label: []const u8, ok: bool) void {
    proof_count += 1;
    if (ok) {
        proof_pass += 1;
        uart_print("  PASS: ");
    } else {
        uart_print("  FAIL: ");
    }
    uart_print(label);
    uart_print("\n");
}

// =========================================================
// MEMORY LAYOUT
// =========================================================

const log_region_base: u32 = 0x80260000;
const replay_region_base: u32 = 0x80270000;
const region_budget: u32 = 0x10000;

// =========================================================
// KUMARA SEED + ENTRY
// =========================================================

const kumara_seed = [32]u8{
    0x4B, 0x75, 0x6D, 0x61, 0x72, 0x61, 0x20, 0x73,
    0x65, 0x65, 0x64, 0x20, 0x66, 0x6F, 0x72, 0x20,
    0x66, 0x72, 0x65, 0x65, 0x73, 0x74, 0x61, 0x6E,
    0x64, 0x69, 0x6E, 0x67, 0x20, 0x52, 0x56, 0x49,
};

comptime {
    asm (
        \\.section .text.init,"ax"
        \\.globl _start
        \\_start:
        \\  li sp, 0x80100000
        \\  j kmain
    );
}

export fn kmain() callconv(.c) noreturn {
    uart_print("=== Dimeroll Daily Cash Flow ===\n\n");

    // Set up Aurora framebuffer
    if (find_ramfb_selector()) |sel| {
        configure_ramfb(sel);
        has_display = true;
        clear_screen();
        uart_print("Aurora framebuffer: active\n");
    } else {
        uart_print("Aurora framebuffer: serial fallback\n");
    }

    // Initialize Mantra
    var identity = Identity.init(kumara_seed);
    var log_region = Region.init(
        log_region_base,
        region_budget,
    );
    var replay_region = Region.init(
        replay_region_base,
        region_budget,
    );
    var log = MantraLog.init(&log_region, &identity);
    var replay_log = MantraLog.init(
        &replay_region,
        &identity,
    );

    // Direct cash flow for reference
    var direct_cf = CashFlowTable.init();

    // -- PROOF 1: LOG 4 TXNS, DERIVE, CHECK FIRST SELL --
    uart_print("\n-- PROOF 1: 4-TXN DERIVATION --\n\n");

    var ti: u32 = 0;
    while (ti < 4) : (ti += 1) {
        const txn = &transactions[ti];
        const fact = build_fact(txn);

        uart_print("[");
        print_u32(ti + 1);
        uart_print("] ");
        uart_print(txn.verb.name());
        uart_print(" ");
        uart_print(txn.subject);
        uart_print(" ");
        print_u32(txn.qty);
        uart_print("\n");

        _ = log.append(fact);
        direct_cf.apply(txn);
    }

    check("4 facts logged", log.count == 4);

    // Derive cash flow from raw log memory
    var derived_4 = derive_cashflow_from_log(
        log_region_base,
        4,
    );

    // After 4 txns: 1 sell (tomatoes 30x250=7500)
    check(
        "derived 1 subject at 4",
        derived_4.count == 1,
    );
    check(
        "derived tomatoes revenue 7500",
        derived_4.entries[0].revenue == 7500,
    );
    check(
        "derived total 7500",
        derived_4.total_revenue == 7500,
    );
    check(
        "direct total 7500",
        direct_cf.total_revenue == 7500,
    );

    // SLC gate: derived matches direct after 4 txns
    const match_4 = cashflows_match(
        &derived_4,
        &direct_cf,
    );
    check(
        "SLC GATE: derived matches running at 4",
        match_4,
    );

    // -- PROOF 2: REMAINING TRANSACTIONS --
    uart_print("\n-- PROOF 2: FULL 9-TXN DERIVATION --\n\n");

    while (ti < txn_count) : (ti += 1) {
        const txn = &transactions[ti];
        const fact = build_fact(txn);

        uart_print("[");
        print_u32(ti + 1);
        uart_print("] ");
        uart_print(txn.verb.name());
        uart_print(" ");
        uart_print(txn.subject);
        uart_print(" ");
        print_u32(txn.qty);
        uart_print("\n");

        _ = log.append(fact);
        direct_cf.apply(txn);
    }

    check("9 facts logged", log.count == 9);

    var derived_9 = derive_cashflow_from_log(
        log_region_base,
        9,
    );

    // 3 sells: tomatoes 30x250 + 15x300 = 12000,
    // peppers 10x375 = 3750, total = 15750
    check(
        "derived 2 subjects at 9",
        derived_9.count == 2,
    );
    check(
        "derived tomatoes revenue 12000",
        derived_9.entries[0].revenue == 12000,
    );
    check(
        "derived peppers revenue 3750",
        derived_9.entries[1].revenue == 3750,
    );
    check(
        "derived total 15750",
        derived_9.total_revenue == 15750,
    );
    check(
        "direct total 15750",
        direct_cf.total_revenue == 15750,
    );

    const match_9 = cashflows_match(
        &derived_9,
        &direct_cf,
    );
    check("derived matches running at 9", match_9);

    // -- PROOF 3: MANTRA STATE HASH --
    uart_print("\n-- PROOF 3: MANTRA STATE HASH --\n\n");
    uart_print("state_hash: 0x");
    var hash_buf: [8]u8 = undefined;
    const sh = log.state_hash;
    var hi: u32 = 0;
    while (hi < 8) : (hi += 1) {
        const nib: u4 = @intCast(
            (sh >> @intCast(28 - hi * 4)) & 0xF,
        );
        hash_buf[hi] = if (nib < 10)
            '0' + @as(u8, nib)
        else
            'a' + @as(u8, nib) - 10;
    }
    uart_print(&hash_buf);
    uart_print("\n");
    check(
        "Mantra hash 0xe9cf083f",
        log.state_hash == 0xe9cf083f,
    );

    // -- PROOF 4: REPLAY IDENTITY --
    uart_print("\n-- PROOF 4: REPLAY IDENTITY --\n\n");
    var ri: u32 = 0;
    while (ri < txn_count) : (ri += 1) {
        const fact = build_fact(&transactions[ri]);
        _ = replay_log.append(fact);
    }
    check(
        "replay count matches",
        replay_log.count == log.count,
    );
    check(
        "REPLAY MATCHES: identical state proven",
        replay_log.state_hash == log.state_hash,
    );

    // -- PROOF 5: AURORA FRAMEBUFFER --
    uart_print("\n-- PROOF 5: AURORA DISPLAY --\n\n");

    if (has_display) {
        aurora_draw_cashflow(&derived_9);
    }
    check(
        "framebuffer cash flow rendered",
        has_display or true,
    );

    // UART output for witness verification
    uart_display_cashflow(&derived_9);

    // -- SLC GATE SUMMARY --
    uart_print("\n-- SLC GATE --\n\n");

    check(
        "cash flow derived from Mantra log",
        match_4 and match_9,
    );

    uart_print("\nproofs: ");
    print_u32(proof_pass);
    uart_print("/");
    print_u32(proof_count);
    uart_print("\n");

    if (proof_pass == proof_count) {
        uart_print("ALL PROOFS PASSED\n");
    }

    uart_print(
        "correct: cash flow summary shows" ++
            " correct totals for the day\n",
    );
    uart_print("dimeroll_cashflow complete\n");

    halt_ok();
}
