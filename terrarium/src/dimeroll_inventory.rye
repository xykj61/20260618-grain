        .qty = 50, .has_price = false,
        .price_cents = 0, .has_unit = true,
        .unit = "seeds",
    },
    .{
        .verb = .harvest, .subject = "tomatoes",
        .qty = 60, .has_price = false,
        .price_cents = 0, .has_unit = true,
        .unit = "kg",
    },
    .{
        .verb = .sell, .subject = "tomatoes",
        .qty = 30, .has_price = true,
        .price_cents = 250, .has_unit = true,
        .unit = "kg",
    },
    .{
        .verb = .harvest, .subject = "peppers",
        .qty = 25, .has_price = false,
        .price_cents = 0, .has_unit = true,
        .unit = "kg",
    },
    .{
        .verb = .sell, .subject = "peppers",
        .qty = 10, .has_price = true,
        .price_cents = 375, .has_unit = true,
        .unit = "kg",
    },
    .{
        .verb = .compost, .subject = "leaves",
        .qty = 30, .has_price = false,
