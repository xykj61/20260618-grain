#!/usr/bin/env rishi
# terrarium/glow_txn_witness.rish
#
# Orbit 26 witness -- Glow transaction grammar
# Builds glow_txn.rye for RV64G and runs on QEMU.
# SLC gate: 5 transaction forms parsed, 27/27 proofs GREEN.

say "== STAGE 1: BUILD glow_txn_g.elf =="

let build = run [
  "env" "RYE_ZIG=vendor/zig-toolchain/zig"
  "rye/bin/rye" "build"
  "terrarium/src/glow_txn.rye"
  "-target" "riscv64-freestanding-none"
  "-fno-entry"
  "-T" "terrarium/layout64.ld"
  "-OReleaseSmall"
  "-mcmodel=medany"
  "-mcpu=generic_rv64+m+a+f+d"
  "-femit-bin=terrarium/.build/glow_txn_g.elf"
]
assert build.ok else "BUILD FAILED: ${build.err}"
say "  build: ok"

say ""
say "== STAGE 2: RUN ON QEMU =="

let qemu = run [
  "sh" "-c"
  "timeout 10 qemu-system-riscv64 -machine virt -bios none -display none -serial stdio -kernel terrarium/.build/glow_txn_g.elf 2>/dev/null"
]
assert qemu.ok else "QEMU FAILED: ${qemu.err}"

assert qemu.out contains "ALL PROOFS PASSED" else "missing ALL PROOFS PASSED"
assert qemu.out contains "correct: 5 of 5 transactions parsed" else "missing 5 of 5"
assert qemu.out contains "Orbit 26 complete" else "missing Orbit 26 complete"
assert qemu.out contains "proofs: 27/27" else "missing 27/27 proofs"

say "  qemu: GREEN"
say "  27/27 proofs, 5 transaction forms parsed"

say ""
say "== STAGE 3: ELF SIZE =="

let size = run ["sh" "-c" "wc -c < terrarium/.build/glow_txn_g.elf"]
assert size.ok else "size check failed"
say "  glow_txn_g.elf: ${size.out} bytes"

say ""
say "== VERDICT: Orbit 26 GREEN =="
say "Glow transaction grammar -- 5 verbs for the field ledger"
