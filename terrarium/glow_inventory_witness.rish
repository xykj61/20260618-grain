#!/usr/bin/env rishi
# glow_inventory_witness.rish -- Orbit 28: running balances inventory
# Build glow_inventory.rye for RV64G and run on QEMU, 21 proofs

say "=== glow_inventory witness (Orbit 28) ==="

let build = run ["env" "RYE_ZIG=vendor/zig-toolchain/zig" "rye/bin/rye" "build" "terrarium/src/glow_inventory.rye" "-target" "riscv64-freestanding-none" "-fno-entry" "-T" "terrarium/layout64.ld" "-OReleaseSmall" "-mcmodel=medany" "-mcpu=generic_rv64+m+a+f+d" "-femit-bin=terrarium/.build/glow_inventory_g.elf"]
assert build.ok else "build failed: ${build.err}"
say "build: ok"

let qemu = run ["timeout" "10" "qemu-system-riscv64" "-machine" "virt" "-bios" "none" "-display" "none" "-serial" "stdio" "-kernel" "terrarium/.build/glow_inventory_g.elf"]
say "qemu exit: ${qemu.code}"

assert qemu.out contains "proofs: 21/21" else "missing proof count"
assert qemu.out contains "ALL PROOFS PASSED" else "proofs did not all pass"
assert qemu.out contains "correct: running balance 135 from 3 tomato transactions" else "missing SLC gate line"
assert qemu.out contains "Orbit 28 complete" else "missing orbit complete"
assert qemu.out contains "REPLAY MATCHES: identical state proven" else "missing replay identity"

say "GREEN: Orbit 28 inventory balances proven on RV64G"
