#!/usr/bin/env rishi
# terrarium/multi_hart64_witness.rish -- Orbit 13 multi-hart boot witness
#
# Proves two harts boot on QEMU with -smp 2, coordinate via atomic
# spinlock, and produce a clean ALL PROOFS PASSED verdict.
#
# 4 stages: CPU features, build, QEMU -smp 2, A-extension census.
#
# Run from the repository root:
#   rishi/bin/rishi run terrarium/multi_hart64_witness.rish

say "=== multi_hart64_witness: Orbit 13 -- multi-hart boot ==="
say ""

# --- stage 1: CPU features probe (RV64IMA via hello64) ----------------
say "--- stage 1: CPU features probe ---"

let features = run ["sh" "-c" "env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye build terrarium/src/hello64.rye -target riscv64-freestanding-none -fno-entry -T terrarium/layout64.ld -OReleaseSmall -mcmodel=medany -mcpu=generic_rv64+m+a -femit-bin=/dev/null 2>&1"]
assert features.ok else "features probe failed -- RV64IMA target rejected"

say "  features probe: RV64IMA target accepted"
say ""

# --- stage 2: build multi_hart.rye -----------------------------------
say "--- stage 2: build multi_hart.rye ---"

let prep = run ["sh" "-c" "mkdir -p terrarium/.build"]
assert prep.ok else "mkdir failed"

let build = run ["sh" "-c" "env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye build terrarium/src/multi_hart.rye -target riscv64-freestanding-none -fno-entry -T terrarium/layout64.ld -OReleaseSmall -mcmodel=medany -mcpu=generic_rv64+m+a -femit-bin=terrarium/.build/multi_hart64.elf 2>&1"]
assert build.ok else "build failed:\n${build.out}"

let size = run ["sh" "-c" "wc -c < terrarium/.build/multi_hart64.elf | tr -d ' '"]
assert size.ok else "size check failed"

say "  build GREEN"
say ""

# --- stage 3: run on QEMU with -smp 2 --------------------------------
say "--- stage 3: run on QEMU with -smp 2 ---"

let qemu = run ["timeout" "10" "qemu-system-riscv64" "-machine" "virt" "-bios" "none" "-smp" "2" "-display" "none" "-serial" "stdio" "-kernel" "terrarium/.build/multi_hart64.elf"]

# proof 1: hart 0 identity
assert qemu.out contains "primary hart alive" else "hart 0 did not wake"
say "  proof 1: hart 0 wakes as primary GREEN"

# proof 2: gate release
assert qemu.out contains "gate released" else "gate was not released"
say "  proof 2: gate release via atomicStore GREEN"

# proof 3: hart 1 wakes and computes
assert qemu.out contains "secondary hart released" else "hart 1 did not wake"
assert qemu.out contains "work done: 7 * 6 = 42" else "hart 1 did not compute 42"
assert qemu.out contains "hart 1 work verified (42)" else "hart 0 did not verify hart 1 work"
say "  proof 3: hart 1 released, computed 42, verified GREEN"

# proof 4: both harts signal done
assert qemu.out contains "done_count: 2" else "both harts did not signal done"
say "  proof 4: done_count=2 via amoadd GREEN"

# proof 5: ticket lock state
assert qemu.out contains "all tickets served" else "ticket lock deadlocked"
say "  proof 5: ticket lock -- all tickets served GREEN"

# overall verdict
assert qemu.out contains "ALL PROOFS PASSED" else "missing ALL PROOFS PASSED"
assert qemu.out contains "Orbit 13 complete" else "missing orbit 13 verdict"
say "  QEMU verdict: ALL PROOFS PASSED"
say ""

# --- stage 4: A-extension instruction census --------------------------
say "--- stage 4: A-extension instruction census ---"

let census = run ["sh" "-c" "sh terrarium/multi_hart64_helper.sh census 2>&1"]
assert census.ok else "census failed:\n${census.out}"

assert census.out contains "census_lr=" else "missing lr.w count"
assert census.out contains "census_sc=" else "missing sc.w count"
assert census.out contains "census_amoadd=" else "missing amoadd.w count"
assert census.out contains "census_fence=" else "missing fence count"
assert census.out contains "census_total=" else "missing total count"

say "  A-extension census:"
say "${census.out}"
say ""

# --- verdict ----------------------------------------------------------
say "=== ALL STAGES GREEN ==="
say "  stage 1: CPU features probe -- RV64IMA accepted"
say "  stage 2: build -- ELF emitted"
say "  stage 3: QEMU -smp 2 -- two harts coordinated, 5 proofs passed"
say "  stage 4: A-ext census -- lr.w, sc.w, amoadd.w, fence confirmed"
say "  Orbit 13: multi-hart boot with atomic spinlock -- GREEN"
