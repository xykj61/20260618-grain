#!/usr/bin/env rishi
# dimeroll_tx_witness.rish -- Orbit 30: transaction language integration
# Quest 2.1 closing gate: all five verbs, both balance types,
# Mantra replay identity, and Aurora display on RV64G.

say "=== dimeroll_tx witness (Orbit 30) ==="

let build = run ["env" "RYE_ZIG=vendor/zig-toolchain/zig" "rye/bin/rye" "build" "terrarium/src/dimeroll_tx.rye" "-target" "riscv64-freestanding-none" "-fno-entry" "-T" "terrarium/layout64.ld" "-OReleaseSmall" "-mcmodel=medany" "-mcpu=generic_rv64+m+a+f+d" "-femit-bin=terrarium/.build/dimeroll_tx_g.elf"]
assert build.ok else "build failed: ${build.err}"
say "build: ok"

let qemu = run ["timeout" "10" "qemu-system-riscv64" "-machine" "virt" "-bios" "none" "-display" "none" "-serial" "stdio" "-kernel" "terrarium/.build/dimeroll_tx_g.elf"]
say "qemu exit: ${qemu.code}"

assert qemu.out contains "proofs:" else "missing proof count"
assert qemu.out contains "ALL PROOFS PASSED" else "proofs did not all pass"
assert qemu.out contains "correct: Quest 2.1 complete" else "missing SLC gate line"
assert qemu.out contains "Orbit 30 complete" else "missing orbit complete"
assert qemu.out contains "REPLAY MATCHES: identical state proven" else "missing replay identity"
assert qemu.out contains "DIMEROLL FIELD LEDGER" else "missing Aurora ledger header"
assert qemu.out contains "Inventory on Hand" else "missing Aurora inventory display"
assert qemu.out contains "Cash Flow Summary" else "missing Aurora cash flow display"
assert qemu.out contains "| TOTAL    |   15750 |" else "missing Aurora total revenue"

say "GREEN: Orbit 30 Quest 2.1 closing gate proven on RV64G"
