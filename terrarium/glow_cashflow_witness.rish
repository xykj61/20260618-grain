#!/usr/bin/env rishi
# glow_cashflow_witness.rish -- Orbit 29: running balances cash flow

say "=== glow_cashflow witness (Orbit 29) ==="

let build = run ["env" "RYE_ZIG=vendor/zig-toolchain/zig" "rye/bin/rye" "build" "terrarium/src/glow_cashflow.rye" "-target" "riscv64-freestanding-none" "-fno-entry" "-T" "terrarium/layout64.ld" "-OReleaseSmall" "-mcmodel=medany" "-mcpu=generic_rv64+m+a+f+d" "-femit-bin=terrarium/.build/glow_cashflow_g.elf"]
assert build.ok else "build failed: ${build.err}"
say "build: ok"

let qemu = run ["timeout" "10" "qemu-system-riscv64" "-machine" "virt" "-bios" "none" "-display" "none" "-serial" "stdio" "-kernel" "terrarium/.build/glow_cashflow_g.elf"]
say "qemu exit: ${qemu.code}"

assert qemu.out contains "proofs: 29/29" else "missing proof count"
assert qemu.out contains "ALL PROOFS PASSED" else "proofs did not all pass"
assert qemu.out contains "correct: sell updates both inventory 95 and revenue 12000" else "missing SLC gate line"
assert qemu.out contains "Orbit 29 complete" else "missing orbit complete"
assert qemu.out contains "REPLAY MATCHES: identical state proven" else "missing replay identity"

say "GREEN: Orbit 29 cash flow balances proven on RV64G"
