#!/usr/bin/env rishi
# dimeroll_query_account_witness -- Movement 39
# Query by account + plain-text export over UART.
# SLC gate: account query correct; export arrives
# at host as readable text.

say "dimeroll_query_account_witness: begin"

# -- build --
say "step 1: build RV64G module"
let build = run ["env" "RYE_ZIG=vendor/zig-toolchain/zig" "rye/bin/rye" "build" "terrarium/src/dimeroll_query_account.rye" "-target" "riscv64-freestanding-none" "-fno-entry" "-T" "terrarium/layout64.ld" "-OReleaseSmall" "-mcmodel=medany" "-mcpu=generic_rv64+m+a+f+d" "-femit-bin=terrarium/.build/dimeroll_query_account_g.elf"]
assert build.ok else "build failed"
say "build ok"

# -- run in QEMU --
say "step 2: run in QEMU"
let qemu = run ["timeout" "10" "qemu-system-riscv64" "-machine" "virt" "-bios" "none" "-display" "none" "-serial" "stdio" "-kernel" "terrarium/.build/dimeroll_query_account_g.elf"]
assert qemu.ok else "QEMU run failed"
say "qemu ok"

# -- check proofs --
say "step 3: verify proofs"
assert qemu.out contains "ALL PROOFS PASSED" else "missing ALL PROOFS PASSED"
assert qemu.out contains "proofs: 19/19" else "expected 19/19 proofs"
say "19/19 proofs confirmed"

# -- check Mantra hash --
say "step 4: verify Mantra hash"
assert qemu.out contains "Mantra hash 0xe9cf083f" else "Mantra hash mismatch"
assert qemu.out contains "REPLAY MATCHES" else "replay identity failed"
say "Mantra hash and replay confirmed"

# -- check account queries --
say "step 5: verify account queries"
assert qemu.out contains "tomatoes returns 4 results" else "tomato query wrong"
assert qemu.out contains "peppers returns 3 results" else "pepper query wrong"
say "account queries confirmed"

# -- check cash flow --
say "step 6: verify cash flow"
assert qemu.out contains "tomato revenue is 12000" else "tomato revenue wrong"
assert qemu.out contains "pepper revenue is 3750" else "pepper revenue wrong"
assert qemu.out contains "total revenue is 15750" else "total revenue wrong"
assert qemu.out contains "leaves sells: 0" else "leaves should have no sells"
say "cash flow confirmed"

# -- check plain-text export --
say "step 7: verify plain-text export"
assert qemu.out contains "EXPORT_BEGIN" else "missing EXPORT_BEGIN"
assert qemu.out contains "EXPORT_END" else "missing EXPORT_END"
assert qemu.out contains "Cash Flow Report: tomatoes" else "missing tomato report"
assert qemu.out contains "Cash Flow Report: peppers" else "missing pepper report"
assert qemu.out contains "End Report" else "missing End Report"
assert qemu.out contains "export length > 0" else "export empty"
say "plain-text export confirmed"

# -- check completion --
say "step 8: verify completion"
assert qemu.out contains "dimeroll_query_account complete" else "missing completion marker"

say "dimeroll_query_account_witness: GREEN"
