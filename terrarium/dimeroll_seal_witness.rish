#!/usr/bin/env rishi
# dimeroll_seal_witness.rish
#
# dimeroll_seal witness -- Amphora daily seal over Mantra log
# 3 stages: build, QEMU run, 14 proof assertions
# GREEN means the SLC gate holds: daily transactions sealed
# into a content-addressed vessel, verified, tamper-detected,
# wire-transmitted, and replay-proven.

say "=== dimeroll_seal witness ==="
say ""

# -----------------------------------------------------------
# STAGE 1 -- build
# -----------------------------------------------------------

say "-- stage 1: build --"

let build = run ["sh" "-c" "cd /Users/bhagavan851c05a/20260618-grain && env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye build terrarium/src/dimeroll_seal.rye -target riscv64-freestanding-none -fno-entry -T terrarium/layout64.ld -OReleaseSmall -mcmodel=medany -mcpu=generic_rv64+m+a+f+d -femit-bin=terrarium/.build/dimeroll_seal_g.elf 2>&1"]
assert build.ok else "build failed: ${build.err}"
say "  build: ok"

let size = run ["sh" "-c" "wc -c < /Users/bhagavan851c05a/20260618-grain/terrarium/.build/dimeroll_seal_g.elf"]
assert size.ok else "size check failed"
say "  elf size: ${size.out} bytes"

# -----------------------------------------------------------
# STAGE 2 -- QEMU run
# -----------------------------------------------------------

say ""
say "-- stage 2: QEMU run --"

let qemu = run ["sh" "-c" "cd /Users/bhagavan851c05a/20260618-grain && timeout 10 qemu-system-riscv64 -machine virt -bios none -display none -serial stdio -kernel terrarium/.build/dimeroll_seal_g.elf 2>/dev/null"]
assert qemu.ok else "QEMU run failed: ${qemu.err}"
say "  qemu: ok"

# -----------------------------------------------------------
# STAGE 3 -- proof assertions
# -----------------------------------------------------------

say ""
say "-- stage 3: proof assertions --"

assert qemu.out contains "proofs: 16/16" else "expected 16/16 proofs"
say "  proofs: 16/16"

assert qemu.out contains "ALL PROOFS PASSED" else "not all proofs passed"
say "  ALL PROOFS PASSED"

assert qemu.out contains "Mantra hash 0xe9cf083f" else "hash mismatch"
say "  Mantra hash: 0xe9cf083f"

assert qemu.out contains "9 facts logged" else "fact count mismatch"
say "  9 facts logged: ok"

assert qemu.out contains "seal: 0xb3db1acd" else "seal hash mismatch"
say "  seal hash: 0xb3db1acd"

assert qemu.out contains "vessel verification passed" else "verification failed"
say "  vessel verification: ok"

assert qemu.out contains "tampered vessel fails verification" else "tamper detect failed"
say "  tamper detection: ok"

assert qemu.out contains "restored vessel passes verification" else "restore failed"
say "  vessel restore: ok"

assert qemu.out contains "DSEAL:0xb3db1acd,359,9" else "wire protocol mismatch"
say "  DSEAL wire protocol: ok"

assert qemu.out contains "REPLAY MATCHES: identical state proven" else "replay mismatch"
say "  replay identity: ok"

assert qemu.out contains "DIMEROLL FIELD LEDGER" else "missing ledger header"
say "  ledger header: ok"

assert qemu.out contains "VERIFIED" else "missing verified status"
say "  verified status: ok"

assert qemu.out contains "TRANSMITTED" else "missing transmitted status"
say "  transmitted status: ok"

assert qemu.out contains "dimeroll_seal complete" else "completion marker missing"
say "  dimeroll_seal complete"

say ""
say "=== dimeroll_seal witness: GREEN ==="
