#!/usr/bin/env rishi
# terrarium/preempt_witness.rish -- Orbit 14 preemptive scheduler witness
#
# Proves timer-driven preemptive context switching between two domains
# on a single hart, with correct output from both.
#
# 4 stages: CPU features, build, QEMU run, trap instruction census.
#
# Run from the repository root:
#   rishi/bin/rishi run terrarium/preempt_witness.rish

say "=== preempt_witness: Orbit 14 -- preemptive scheduling ==="
say ""

# --- stage 1: CPU features probe (RV64IMA via hello64) ----------------
say "--- stage 1: CPU features probe ---"

let features = run ["sh" "-c" "env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye build terrarium/src/hello64.rye -target riscv64-freestanding-none -fno-entry -T terrarium/layout64.ld -OReleaseSmall -mcmodel=medany -mcpu=generic_rv64+m+a -femit-bin=/dev/null 2>&1"]
assert features.ok else "features probe failed -- RV64IMA target rejected"

say "  features probe: RV64IMA target accepted"
say ""

# --- stage 2: build preempt.rye ---------------------------------------
say "--- stage 2: build preempt.rye ---"

let prep = run ["sh" "-c" "mkdir -p terrarium/.build"]
assert prep.ok else "mkdir failed"

let build = run ["sh" "-c" "env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye build terrarium/src/preempt.rye -target riscv64-freestanding-none -fno-entry -T terrarium/layout64.ld -OReleaseSmall -mcmodel=medany -mcpu=generic_rv64+m+a -femit-bin=terrarium/.build/preempt64.elf 2>&1"]
assert build.ok else "build failed:\n${build.out}"

let size = run ["sh" "-c" "wc -c < terrarium/.build/preempt64.elf | tr -d ' '"]
assert size.ok else "size check failed"

say "  build GREEN -- ELF size: ${size.out} bytes"
say ""

# --- stage 3: run on QEMU ---------------------------------------------
say "--- stage 3: run on QEMU ---"

let qemu = run ["timeout" "10" "qemu-system-riscv64" "-machine" "virt" "-bios" "none" "-display" "none" "-serial" "stdio" "-kernel" "terrarium/.build/preempt64.elf"]

# proof 1: timer armed
assert qemu.out contains "timer armed: GREEN" else "timer was not armed"
say "  proof 1: timer armed GREEN"

# proof 2: domain A checksum
assert qemu.out contains "domain A: GREEN" else "domain A checksum failed"
say "  proof 2: domain A checksum (15) GREEN"

# proof 3: domain B checksum
assert qemu.out contains "domain B: GREEN" else "domain B checksum failed"
say "  proof 3: domain B checksum (515) GREEN"

# proof 4: preemption verified
assert qemu.out contains "preemption verified: GREEN" else "preemption not verified"
say "  proof 4: preemption verified (>5 switches) GREEN"

# proof 5: register integrity
assert qemu.out contains "register integrity: GREEN" else "register integrity failed"
say "  proof 5: register integrity GREEN"

# overall verdict
assert qemu.out contains "ALL PROOFS PASSED" else "missing ALL PROOFS PASSED"
assert qemu.out contains "Orbit 14 complete" else "missing orbit 14 verdict"
say "  QEMU verdict: ALL PROOFS PASSED"
say ""

# --- stage 4: trap instruction census ---------------------------------
say "--- stage 4: trap instruction census ---"

let census = run ["sh" "-c" "sh terrarium/preempt_helper.sh census 2>&1"]
assert census.ok else "census failed:\n${census.out}"

assert census.out contains "census_mret=" else "missing mret count"
assert census.out contains "census_csrrw=" else "missing csrrw count"
assert census.out contains "census_csr_total=" else "missing csr total"

say "  trap instruction census:"
say "${census.out}"
say ""

# --- verdict ----------------------------------------------------------
say "=== ALL STAGES GREEN ==="
say "  stage 1: CPU features probe -- RV64IMA accepted"
say "  stage 2: build -- ELF emitted"
say "  stage 3: QEMU -- 5 proofs passed, preemptive scheduling verified"
say "  stage 4: trap census -- mret, csr*, sd, ld confirmed"
say "  Orbit 14: preemptive scheduling foundation -- GREEN"
