#!/usr/bin/env rishi
# dimeroll_inventory_witness.rish -- Orbit 32: inventory summary
# Proves inventory derived from Mantra log matches running balances

let src = "terrarium/src/dimeroll_inventory.rye"
let elf = "terrarium/.build/dimeroll_inventory_g.elf"
let layout = "terrarium/layout64.ld"

say "=== Orbit 32: Inventory Summary Witness ==="
say ""

# Stage 1: build
say "-- stage 1: build --"
let build = run ["sh" "-c" "env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye build terrarium/src/dimeroll_inventory.rye -target riscv64-freestanding-none -fno-entry -T terrarium/layout64.ld -OReleaseSmall -mcmodel=medany -mcpu=generic_rv64+m+a+f+d -femit-bin=terrarium/.build/dimeroll_inventory_g.elf 2>&1"]
assert build.ok else "build failed: ${build.err}"
say "  PASS: build succeeded"

# Stage 2: run on QEMU
say ""
say "-- stage 2: QEMU run --"
let qemu = run ["sh" "-c" "timeout 10 qemu-system-riscv64 -machine virt -bios none -display none -serial stdio -kernel terrarium/.build/dimeroll_inventory_g.elf 2>/dev/null"]
assert qemu.ok else "QEMU run failed: ${qemu.err}"
say "  PASS: QEMU run succeeded"

# Stage 3: proof assertions
say ""
say "-- stage 3: proof assertions --"
assert qemu.out contains "proofs: 18/18" else "expected 18/18 proofs"
say "  PASS: 18/18 proofs"
assert qemu.out contains "ALL PROOFS PASSED" else "expected ALL PROOFS PASSED"
say "  PASS: ALL PROOFS PASSED"
assert qemu.out contains "Mantra hash 0xe9cf083f" else "expected Mantra hash 0xe9cf083f"
say "  PASS: Mantra hash 0xe9cf083f"
assert qemu.out contains "REPLAY MATCHES: identical state proven" else "expected replay identity"
say "  PASS: replay identity proven"
assert qemu.out contains "SLC GATE: derived matches running at 5" else "expected SLC gate"
say "  PASS: SLC gate -- derived matches running at 5"
assert qemu.out contains "Inventory (from Mantra)" else "expected inventory display"
say "  PASS: inventory display rendered"
assert qemu.out contains "tomatoes" else "expected tomatoes in inventory"
say "  PASS: tomatoes in inventory"
assert qemu.out contains "peppers" else "expected peppers in inventory"
say "  PASS: peppers in inventory"
assert qemu.out contains "leaves" else "expected leaves in inventory"
say "  PASS: leaves in inventory"
assert qemu.out contains "Orbit 32 complete" else "expected Orbit 32 complete"
say "  PASS: Orbit 32 complete"

say ""
say "=== Orbit 32 witness GREEN ==="
