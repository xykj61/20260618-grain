#!/usr/bin/env rishi
# dimeroll_query_verb_witness.rish
#
# Movement 36 witness -- Query by verb
# Builds and runs dimeroll_query_verb on RV64G QEMU.
# 19 proofs: 2 Mantra, 12 verb filters, 1 completeness,
# 2 replay, plus structural checks.

say "=== dimeroll_query_verb witness ==="
say ""

say "-- build --"

let build = run ["sh" "-c" "cd /Users/bhagavan851c05a/20260618-grain && env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye build terrarium/src/dimeroll_query_verb.rye -target riscv64-freestanding-none -fno-entry -T terrarium/layout64.ld -OReleaseSmall -mcmodel=medany -mcpu=generic_rv64+m+a+f+d -femit-bin=terrarium/.build/dimeroll_query_verb_g.elf 2>&1"]
assert build.ok else "build failed: ${build.err}"
say "  build: ok"

say ""
say "-- run on QEMU --"

let qemu = run ["sh" "-c" "cd /Users/bhagavan851c05a/20260618-grain && timeout 10 qemu-system-riscv64 -machine virt -bios none -display none -serial stdio -kernel terrarium/.build/dimeroll_query_verb_g.elf 2>/dev/null"]
assert qemu.ok else "QEMU failed: ${qemu.err}"

assert qemu.out contains "proofs: 19/19" else "expected 19/19 proofs"
assert qemu.out contains "ALL PROOFS PASSED" else "not all proofs passed"
assert qemu.out contains "Mantra hash 0xe9cf083f" else "Mantra hash mismatch"

say ""
say "-- verb filter checks --"

assert qemu.out contains "harvest returns 2 results" else "harvest count wrong"
assert qemu.out contains "sell returns 3 results" else "sell count wrong"
assert qemu.out contains "plant returns 2 results" else "plant count wrong"
assert qemu.out contains "compost returns 1 result" else "compost count wrong"
assert qemu.out contains "note returns 1 result" else "note count wrong"

assert qemu.out contains "all verbs cover all 9 transactions" else "completeness check failed"
assert qemu.out contains "REPLAY MATCHES: identical state proven" else "replay failed"

assert qemu.out contains "dimeroll_query_verb complete" else "completion marker missing"

say "  harvest:  2 results"
say "  sell:     3 results"
say "  plant:    2 results"
say "  compost:  1 result"
say "  note:     1 result"
say "  total:    9 (all verbs cover all transactions)"
say "  Mantra:   0xe9cf083f"
say "  replay:   identical state proven"

say ""
say "=== dimeroll_query_verb witness: GREEN ==="
