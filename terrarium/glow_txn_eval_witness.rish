#!/usr/bin/env rishi
# terrarium/glow_txn_eval_witness.rish
#
# Orbit 27 witness -- Transaction evaluation and Mantra logging
# Builds glow_txn_eval.rye for RV64G and runs on QEMU.
# SLC gate: 5 transactions log as 5 signed Mantra facts,
# replay identity proven.

say "== STAGE 1: BUILD glow_txn_eval_g.elf =="

let build = run ["env" "RYE_ZIG=vendor/zig-toolchain/zig" "rye/bin/rye" "build" "terrarium/src/glow_txn_eval.rye" "-target" "riscv64-freestanding-none" "-fno-entry" "-T" "terrarium/layout64.ld" "-OReleaseSmall" "-mcmodel=medany" "-mcpu=generic_rv64+m+a+f+d" "-femit-bin=terrarium/.build/glow_txn_eval_g.elf"]
assert build.ok else "BUILD FAILED: ${build.err}"
say "  build: ok"

say ""
say "== STAGE 2: RUN ON QEMU =="

let qemu = run ["sh" "-c" "timeout 10 qemu-system-riscv64 -machine virt -bios none -display none -serial stdio -kernel terrarium/.build/glow_txn_eval_g.elf 2>/dev/null"]
assert qemu.ok else "QEMU FAILED: ${qemu.err}"

assert qemu.out contains "ALL PROOFS PASSED" else "missing ALL PROOFS PASSED"
assert qemu.out contains "correct: 5 of 5 signed Mantra facts" else "missing 5 of 5"
assert qemu.out contains "Orbit 27 complete" else "missing Orbit 27 complete"
assert qemu.out contains "REPLAY MATCHES: identical state proven" else "missing replay identity"

say "  qemu: GREEN"
say "  26 proofs, 5 signed Mantra facts, replay identity proven"

say ""
say "== STAGE 3: ELF SIZE =="

let size = run ["sh" "-c" "wc -c < terrarium/.build/glow_txn_eval_g.elf"]
assert size.ok else "size check failed"
say "  glow_txn_eval_g.elf: ${size.out} bytes"

say ""
say "== VERDICT: Orbit 27 GREEN =="
say "Transaction evaluation and Mantra logging -- book of account"
