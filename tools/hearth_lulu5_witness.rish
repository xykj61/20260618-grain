# hearth_lulu5_witness.rish — hearth-display cellular preference.
#
#   rishi/bin/rishi run tools/hearth_lulu5_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "linengrow/bin/hearth_lulu5_witness"

let build = run ["sh" "-c" "mkdir -p linengrow/bin && env RYE_ZIG=${zig} rye/bin/rye build linengrow/hearth_lulu5_witness.rye -femit-bin=${bin}"]
assert build.ok else "hearth-display cellular preference witness build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "hearth-display cellular preference witness exited non-zero"
assert selftest.out contains "GREEN" else "hearth-display not GREEN"
assert selftest.out contains "waymark hearth-display" else "hearth-display missing waymark claim"
assert selftest.out contains "cell lines" else "hearth-display missing cell-line claim"

say "GREEN: hearth-display Hearth cellular preference witness passed."
