# docs_geode_teacher_witness.rish -- the teaching shelf declares Teacher at the Door.
#
#   rishi/bin/rishi run tools/d/docs_geode_teacher_witness.rish

say "docs-geode-teacher: Language EN -- a learner's page names the open door."
say "docs-geode-teacher: Style Gauge Meter -- the folder's register is counted, one line per page."
say "docs-geode-teacher: Lens TAME -- safety first: a declaration the next render can overwrite is fixed in the generator too."

let pen = run ["sh" "tools/fixtures/d/docs_geode_teacher_control.sh"]
say pen.out
assert pen.ok else "docs-geode-teacher: the control must complete"
assert pen.out contains "control_verdict=ok" else "docs-geode-teacher: the planted readings must agree with the scan"

let living = run ["sh" "tools/fixtures/d/docs_geode_teacher_scan.sh"]
say living.out
assert living.ok else "docs-geode-teacher: the living shelf must agree"
assert living.out contains "verdict=ok" else "docs-geode-teacher: every docs-geode page declares Teacher at the Door"
