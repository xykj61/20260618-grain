# tube3_resin_fetch_witness.rish -- glow-publishing: sealed Manifest resin fetch.
#
# glow-publishing publish -> Amphora digest wire -> Comlink seal -> verify before admit.
# See linengrow/tube3_resin_fetch.rye.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/t/tube3_resin_fetch_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "linengrow/bin/tube3_resin_fetch_witness"

let build = run ["sh" "-c" "mkdir -p linengrow/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh linengrow/tube3_resin_fetch_witness.rye -femit-bin=${bin}"]
assert build.ok else "glow-publishing resin-fetch witness build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "glow-publishing resin-fetch witness exited non-zero"
assert selftest.out contains "GREEN" else "glow-publishing resin-fetch witness not GREEN"
assert selftest.out contains "welcome fetch" else "glow-publishing missing the welcome fetch path"
assert selftest.out contains "bad Comlink seal" else "glow-publishing missing the bad-seal refusal"
assert selftest.out contains "digest mismatch" else "glow-publishing missing the digest-mismatch refusal"
assert selftest.out contains "unpublished digest" else "glow-publishing missing the published-set gate"

say "GREEN: glow-publishing resin-fetch witness passed."
