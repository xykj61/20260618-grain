# tablecloth_named_serve_witness.rish -- Tablecloth matches resolved to spoken names.
#
# Proves the resolution half of "served over Comlink, resolved to a spoken name": a
# query's matches resolve through the shared name registry to WHO -- the spoken name a
# point wears -- via names.rye's public sign_claim (the helper that unblocks claiming a
# name from outside that module). A point with no name resolves named=false, never a
# fabricated name.
#
# Build first:  rye build tablecloth/named_serve.rye -femit-bin=tablecloth/bin/named_serve
#   rishi/bin/rishi run tools/t/tablecloth_named_serve_witness.rish

# Build the binary this witness proves, rather than assuming a previous lap left one behind.
# tablecloth/bin/ is gitignored (.gitignore:191), so a clone carries none of these binaries: this
# witness named its build in the header comment above and then invoked the path, which died on a
# missing file rather than on a Tablecloth fact. The repair its Comlink sibling already carried.
let zig = "vendor/zig-toolchain/zig"
let build = run ["sh" "-c" "mkdir -p tablecloth/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh tablecloth/named_serve.rye -femit-bin=tablecloth/bin/named_serve"]
assert build.ok else "tablecloth named_serve: build failed -- ${build.err_brief}"

let st = run ["tablecloth/bin/named_serve" "selftest"]
assert st.ok else "tablecloth named_serve selftest must exit 0"
assert (st.err contains "GREEN") else "tablecloth named_serve must report GREEN"
assert (st.err contains "resolves each match to WHO") else "a named query resolves matches to who"
assert (st.err contains "not merely a number") else "a search returns a name, not just a number"
assert (st.err contains "named=false, never a fabricated name") else "an unnamed point resolves honestly, never fabricated"
assert (st.err contains "public sign_claim") else "names are claimed via names.rye public sign_claim"
assert (st.err contains "both ways") else "the registry resolves name-to-point and point-to-name"

say "GREEN: tablecloth named_serve — a query's matches resolved to spoken names over the shared registry: who, not just which number, witnessed."
