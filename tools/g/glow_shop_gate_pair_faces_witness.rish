# glow_shop_gate_pair_faces_witness.rish -- glow-language pair-faces (parse + metal after 338b).
#
#   rishi/bin/rishi run tools/g/glow_shop_gate_pair_faces_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "glow/bin/lower_shop_gate_witness"

let build = run ["sh" "-c" "mkdir -p glow/bin glow/.cache && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh glow/lower_shop_gate_witness.rye -femit-bin=${bin}"]
assert build.ok else "lower_shop_gate_witness build failed: ${build.err_brief}${build.out_brief}"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "lower_shop_gate_witness exited non-zero"
assert selftest.out contains "GREEN" else "lower_shop_gate_witness not GREEN"
assert selftest.out contains "bartis_pair" else "glow-language missing bartis_pair emit"
assert selftest.out contains "pair-faces eq" else "glow-language missing pair-faces eq claim"
assert selftest.out contains "pair-faces gth" else "glow-language missing pair-faces gth claim"
assert selftest.out contains "BodyFaceMismatch" else "glow-language missing stranger-face refuse"
assert selftest.out contains "lone bracket" else "glow-language missing lone-bracket refuse"
assert selftest.out contains "gate-pair-eq-faces.glow" else "glow-language missing eq fixture claim"
assert selftest.out contains "gate-pair-gth-faces.glow" else "glow-language missing gth fixture claim"

# Standing laps stay warm beside the relational gate.
let argv = run ["rishi/bin/rishi" "run" "tools/g/glow_shop_gate_argv_witness.rish"]
assert argv.ok else "glow_shop_gate_argv_witness must stay GREEN beside glow-language"

let a2 = run ["rishi/bin/rishi" "run" "tools/g/glow_tend_a2_suite.rish"]
assert a2.ok else "glow_tend_a2_suite must stay GREEN beside glow-language"

say "GREEN: glow-language pair-faces — parse · metal bartis_pair · stranger/lone refuses · argv+a2 warm."
