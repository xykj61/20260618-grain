# setu6_device_lab_witness.rish -- usb-hearth: device-wire lab harness.
#
#   rishi/bin/rishi run tools/s/setu6_device_lab_witness.rish
#
# Host iface classify + lab.kyri:
#   rishi/bin/rishi run tools/s/setu6_lab_probe_onpath_host.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "linengrow/bin/setu6_device_lab_witness"
let check = "linengrow/bin/setu6_device_lab_check"

let build = run ["sh" "-c" "mkdir -p linengrow/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh linengrow/setu6_device_lab_witness.rye -femit-bin=${bin}"]
assert build.ok else "usb-hearth lab witness build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "usb-hearth witness exited non-zero"
assert selftest.out contains "GREEN" else "usb-hearth not GREEN"
assert selftest.out contains "stand-in lab ready" else "usb-hearth missing stand-in fixture"
assert selftest.out contains "armed when iface" else "usb-hearth missing armed fixture"

let build_check = run ["sh" "-c" "env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh linengrow/setu6_device_lab_check.rye -femit-bin=${check}"]
assert build_check.ok else "usb-hearth lab check build failed"
let stand = run ["sh" "-c" "${check} 2>&1"]
assert stand.ok else "usb-hearth stand-in check failed"
assert stand.out contains "stand-in" else "usb-hearth check missing stand-in"
assert stand.out contains "GREEN" else "usb-hearth check not GREEN"
say "${stand.out_brief}"

say "GREEN: usb-hearth device-wire lab witness passed (device-free)."
