# setu1_lane_ping_witness.rish — usb-hearth device-free: usb_desk lane ping.
#
#   rishi/bin/rishi run tools/s/setu1_lane_ping_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "linengrow/bin/setu1_lane_ping_witness"

let build = run ["sh" "-c" "mkdir -p linengrow/bin && env RYE_ZIG=${zig} rye/bin/rye build linengrow/setu1_lane_ping_witness.rye -femit-bin=${bin}"]
assert build.ok else "usb-hearth lane ping witness build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "usb-hearth lane ping witness exited non-zero"
assert selftest.out contains "GREEN" else "usb-hearth not GREEN"
assert selftest.out contains "waymark usb-hearth" else "usb-hearth missing waymark claim"
assert selftest.out contains "local wire refuses" else "usb-hearth missing local refuse claim"
assert selftest.out contains "usb_desk Comlink ping" else "usb-hearth missing seal claim"
assert selftest.out contains "sealed bytes reopen" else "usb-hearth missing hold claim"

say "GREEN: usb-hearth lane ping witness passed (device-free)."
