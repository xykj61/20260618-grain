# seva_jabs2_glass_audience_witness.rish -- seva-broadcast glass audience strip.
#
#   rishi/bin/rishi run tools/s/seva_jabs2_glass_audience_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "linengrow/bin/seva_jabs2_glass_audience_witness"

let build = run ["sh" "-c" "mkdir -p linengrow/bin && env RYE_ZIG=${zig} rye/bin/rye build linengrow/seva_jabs2_glass_audience_witness.rye -femit-bin=${bin}"]
assert build.ok else "seva-broadcast glass audience witness build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "seva-broadcast glass audience witness exited non-zero"
assert selftest.out contains "GREEN" else "seva-broadcast glass audience witness not GREEN"
assert selftest.out contains "audience" else "seva-broadcast glass missing audience claim"
assert selftest.out contains "layout rows" else "seva-broadcast glass missing layout-word claim"
assert selftest.out contains "Dexter submit" else "seva-broadcast glass missing live chat-face claim"
assert selftest.out contains "bare ret" else "seva-broadcast glass missing bare-ret chat claim"

say "GREEN: seva-broadcast glass audience witness passed."
