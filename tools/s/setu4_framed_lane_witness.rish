# setu4_framed_lane_witness.rish — usb-hearth: NCM-framed ping over live UDP.
#
#   rishi/bin/rishi run tools/s/setu4_framed_lane_witness.rish
#
# Optional host gadget probe (SKIP when no usb0/ncm):
#   rishi/bin/rishi run tools/s/setu4_gadget_probe_onpath_host.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "linengrow/bin/setu4_framed_lane"

let build = run ["sh" "-c" "mkdir -p linengrow/bin && env RYE_ZIG=${zig} rye/bin/rye build linengrow/setu4_framed_lane.rye -lc -femit-bin=${bin}"]
assert build.ok else "usb-hearth framed lane build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "usb-hearth selftest exited non-zero"
assert selftest.out contains "GREEN" else "usb-hearth selftest not GREEN"
assert selftest.out contains "waymark usb-hearth" else "usb-hearth missing waymark"

let demo = run ["sh" "-c" "${bin} demo 2>&1"]
assert demo.ok else "usb-hearth demo exited non-zero"
assert demo.out contains "GREEN" else "usb-hearth demo not GREEN"
assert demo.out contains "live localhost UDP" else "usb-hearth demo missing live UDP claim"

say "GREEN: usb-hearth framed lane witness passed (live UDP stand-in)."
