# seva_b1_glass_carriage_witness.rish -- seva-broadcast welcome path on glass.
#
#   rishi/bin/rishi run tools/s/seva_b1_glass_carriage_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "linengrow/bin/seva_b1_glass_carriage_witness"

let build = run ["sh" "-c" "mkdir -p linengrow/bin && env RYE_ZIG=${zig} rye/bin/rye build linengrow/seva_b1_glass_carriage_witness.rye -femit-bin=${bin}"]
assert build.ok else "seva-broadcast glass carriage witness build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "seva-broadcast glass carriage witness exited non-zero"
assert selftest.out contains "GREEN" else "seva-broadcast glass carriage not GREEN"
assert selftest.out contains "welcome carriage roots match" else "seva-broadcast glass missing carriage claim"
assert selftest.out contains "seva-broadcast carriage" else "seva-broadcast glass missing Skate line claim"

say "GREEN: seva-broadcast glass carriage witness passed — welcome path paints."
