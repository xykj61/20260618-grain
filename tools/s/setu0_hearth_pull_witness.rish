# setu0_hearth_pull_witness.rish — usb-hearth device-free: Desk parses pulled hearth.
#
#   rishi/bin/rishi run tools/s/setu0_hearth_pull_witness.rish
#
# On-device pull (host terminal, adb attached):
#   rishi/bin/rishi run tools/s/setu0_hearth_pull_onpath_host.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "linengrow/bin/setu0_hearth_pull_witness"

let build = run ["sh" "-c" "mkdir -p linengrow/bin && env RYE_ZIG=${zig} rye/bin/rye build linengrow/setu0_hearth_pull_witness.rye -femit-bin=${bin}"]
assert build.ok else "usb-hearth hearth pull witness build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "usb-hearth hearth pull witness exited non-zero"
assert selftest.out contains "GREEN" else "usb-hearth not GREEN"
assert selftest.out contains "waymark usb-hearth" else "usb-hearth missing waymark claim"
assert selftest.out contains "fixture pointer" else "usb-hearth missing fixture claim"

say "GREEN: usb-hearth Hearth pull-parse witness passed (device-free)."
