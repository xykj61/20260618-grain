# setu3_ncm_frame_witness.rish -- usb-hearth device-free: NCM-shaped frame.
#
#   rishi/bin/rishi run tools/s/setu3_ncm_frame_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "linengrow/bin/setu3_ncm_frame_witness"

let build = run ["sh" "-c" "mkdir -p linengrow/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh linengrow/setu3_ncm_frame_witness.rye -femit-bin=${bin}"]
assert build.ok else "usb-hearth NCM frame witness build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "usb-hearth NCM frame witness exited non-zero"
assert selftest.out contains "GREEN" else "usb-hearth not GREEN"
assert selftest.out contains "waymark usb-hearth" else "usb-hearth missing waymark"
assert selftest.out contains "NCM-shaped wrap" else "usb-hearth missing wrap claim"
assert selftest.out contains "bad ethertype refused" else "usb-hearth missing refuse claim"

say "GREEN: usb-hearth NCM frame witness passed (device-free)."
