# setu2_lane_wire_witness.rish -- usb-hearth: lane ping over hosted UDP.
#
#   rishi/bin/rishi run tools/s/setu2_lane_wire_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "linengrow/bin/setu2_lane_wire"

let build = run ["sh" "-c" "mkdir -p linengrow/bin && env RYE_ZIG=${zig} rye/bin/rye build linengrow/setu2_lane_wire.rye -lc -femit-bin=${bin}"]
assert build.ok else "usb-hearth lane wire build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "usb-hearth selftest exited non-zero"
assert selftest.out contains "GREEN" else "usb-hearth selftest not GREEN"
assert selftest.out contains "waymark usb-hearth" else "usb-hearth missing waymark"

let demo = run ["sh" "-c" "${bin} demo 2>&1"]
assert demo.ok else "usb-hearth demo exited non-zero"
assert demo.out contains "GREEN" else "usb-hearth demo not GREEN"
assert demo.out contains "localhost UDP" else "usb-hearth demo missing UDP claim"

say "GREEN: usb-hearth lane wire witness passed (hosted UDP stand-in)."
