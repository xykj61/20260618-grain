# setu5_device_payload_witness.rish — usb-hearth: framed ping as device-wire payload.
#
#   rishi/bin/rishi run tools/s/setu5_device_payload_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "linengrow/bin/setu5_device_payload_witness"
let check = "linengrow/bin/setu5_device_payload_check"

let build = run ["sh" "-c" "mkdir -p linengrow/bin tools/.cache/setu0 && env RYE_ZIG=${zig} rye/bin/rye build linengrow/setu5_device_payload_witness.rye -femit-bin=${bin}"]
assert build.ok else "usb-hearth device payload witness build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "usb-hearth witness exited non-zero"
assert selftest.out contains "GREEN" else "usb-hearth not GREEN"
assert selftest.out contains "waymark usb-hearth" else "usb-hearth missing waymark"
assert selftest.out contains "fits device max_frame" else "usb-hearth missing bound claim"

let build_check = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build linengrow/setu5_device_payload_check.rye -femit-bin=${check}"]
assert build_check.ok else "usb-hearth check build failed"
let write = run ["sh" "-c" "${check} 2>&1"]
assert write.ok else "usb-hearth check failed"
assert write.out contains "GREEN" else "usb-hearth check not GREEN"
assert write.out contains "lane_frame.bin" else "usb-hearth missing hold path"

say "GREEN: usb-hearth device payload witness passed (device-free)."
