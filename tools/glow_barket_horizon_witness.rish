# glow_barket_horizon_witness.rish — barket horizon wording artifact (glow-language).
#
# Proves the glow-language wording brief and living barket name still exist, and that
# tokenize (glow-language) is GREEN. Untokenized claim retired when glow-language landed.
#
#   rishi/bin/rishi run tools/glow_barket_horizon_witness.rish

let tame = "context/TAME_GUIDANCE.md"
let brief = "active-designing/20260720-040700_stoa102-barket-horizon-wording.md"
let lexicon = "context/LEXICON.md"
let readme = "glow/README.md"

# TAME still carries glow-language barket horizon note (wording seat).
let tame_pin = run ["sh" "-c" "grep -F 'glow-language' ${tame}"]
assert tame_pin.ok else "TAME missing glow-language barket horizon"
let tame_barket = run ["sh" "-c" "grep -F 'barket' ${tame}"]
assert tame_barket.ok else "TAME missing barket spoken name"

# Horizon brief exists and names barket + wet hold.
let brief_ok = run ["sh" "-c" "test -f ${brief} && grep -F 'barket' ${brief} && grep -F 'wet' ${brief}"]
assert brief_ok.ok else "glow-language barket horizon brief missing or incomplete"
let brief_stoa = run ["sh" "-c" "grep -F 'glow-language' ${brief}"]
assert brief_stoa.ok else "glow-language brief must name glow-language"

# Lexicon + README name barket.
let lex_barket = run ["sh" "-c" "grep -F 'barket' ${lexicon}"]
assert lex_barket.ok else "LEXICON missing barket"
let readme_h = run ["sh" "-c" "grep -F 'barket' ${readme}"]
assert readme_h.ok else "glow/README must name barket"

# Parse lap GREEN (sibling-binds tokenize); lower still held.
let parse = run ["sh" "-c" "rishi/bin/rishi run tools/glow_barket_parse_witness.rish"]
assert parse.ok else "glow_barket_parse_witness failed under horizon artifact check"
assert parse.out contains "GREEN" else "glow_barket_parse_witness not GREEN"

say "GREEN: Glow barket horizon wording artifact — glow-language brief held; parse GREEN (glow-language–112)."
