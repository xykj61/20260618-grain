# tools/hunk_part_filter_witness.rish — narrow the marketplace to the parts that match a query (open-image).
#
# Chapter A (Hardware & Right-to-Repair) · waymark open-image · parts-marketplace journey · rung open-image.
# Design read: active-designing/20260813-234337_hunk-part-filter-narrow-the-catalog-exploration.md
# Teacher, thanked clean-room: McMaster-Carr's narrowing sidebar — a wall of parts becomes the seven you want
# (concept only, siloed).
#
# open-image bound honest facts beside each window; open-image painted the catalog as a shelf; open-image let it page. This rung
# lets a keeper NARROW the catalog: image/part_filter.rye `filter_catalog` reads a whole PartCatalog and a Query and
# builds a fresh sub-catalog holding exactly the matching parts, in held order, over the same shared sheet — so the
# result is an ordinary PartCatalog that paints, pages, and round-trips by every law already proven. The selftest
# narrows five parts by material, by part-number prefix, by a price ceiling and floor; proves each result keeps
# exactly the matches in held order, a match-all query reproduces the catalog byte-for-byte, a match-none query
# yields a real empty catalog, a filter composes, and an over-long query text refuses by name. Price is a fact
# compared, never moved — no network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/hunk_part_filter_witness.rish

say "hunk-part-filter: Language EN — open-image narrows a PartCatalog to the parts that match a query, building a fresh sub-catalog that paints, pages, and round-trips like any other catalog."
say "hunk-part-filter: Style Radiant — a real marketplace is not read front to back but narrowed; the filter loses no match and admits no stranger, and the narrowed catalog is an ordinary catalog, not a new kind of thing."
say "hunk-part-filter: Lens TAME — pure composition over public APIs; price is a fact compared, never a balance moved; the query text is bounded; positive invariants per fn; refusal by name; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/part_filter"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/part_filter.rye -femit-bin=${bin}"]
assert build.ok else "hunk-part-filter: build failed — ${build.err}"

# Write the selftest output to a file and grep the file — the GREEN line carries an apostrophe-free run, yet the
# file round-trip matches the sibling open-image witnesses' discipline.
let outfile = "image/bin/part_filter.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "hunk-part-filter: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "hunk-part-filter: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN part-filter' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "hunk-part-filter: selftest did not print the GREEN part-filter line"

# open-image stays GREEN — the facts the filter reads (facts_at, entry, part_of, render_part_catalog, parse_part_catalog)
# are the ones part_catalog proved. A filtered catalog is only trustworthy because the catalog under it is.
let cat = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/part_catalog.rye -femit-bin=image/bin/part_catalog && image/bin/part_catalog selftest > image/bin/part_catalog.out 2>&1"]
assert cat.ok else "hunk-part-filter: open-image part_catalog re-run failed — see image/bin/part_catalog.out"
let cat_green = run ["sh" "-c" "grep -q 'GREEN part-catalog' image/bin/part_catalog.out && echo yes"]
assert (trim cat_green.out) == "yes" else "hunk-part-filter: open-image part_catalog did not stay GREEN"

say "hunk-part-filter: GREEN — a marketplace narrows to the parts a keeper wants, the filter losing no match and admitting no stranger; open-image facts underneath stay GREEN. open-image lands."
