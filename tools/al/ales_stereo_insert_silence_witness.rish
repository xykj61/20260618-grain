# tools/al/ales_stereo_insert_silence_witness.rish -- stereo_insert_silence: opening a silent gap carried into stereo, both channels in lockstep, validate-both-before-either (lotus-audio).
#
# Chapter: the Six-Chapter double-seat, Chapter C thread (Lotus - the creative suite) - waymark lotus-audio - rung lotus-audio.
# Design read: active-designing/date/20260815/20260815-022429_fill-ales123-lotus-stereo-insert-silence.md
# Stands on: lotus/insert_silence.rye (lotus-audio -- the mono gap-opening gesture run once per channel), lotus/pan.rye (lotus-audio -- the StereoClip, two mono Clips left/right, and its balance
# invariant), lotus/stereo_cut.rye (lotus-audio -- the stereo span-remove this rung inverts), lotus/timeline.rye (lotus-audio -- the Clip, its max_clip bound, and the EditError reused whole), lotus/meter.rye
# (lotus-audio -- the peak/RMS meter). A Lotus master is a StereoClip whose defining invariant is that left and right hold the same length so the channels stay aligned in time; opening a gap for a
# downbeat lands it in both speakers at once. This rung carries lotus-audio's insert_silence into stereo the way lotus-audio carried duplicate and lotus-audio carried silence_span: run the proven mono
# insert_silence on each channel over the same span. It is the growth-twin of stereo_silence_span -- silence written in place (length holds) versus silence made room for (length grows).
#
# lotus/stereo_insert_silence.rye opens count silent samples at at in both channels, validating BOTH channels before either is mutated (because mono insert_silence can fault only with BadRange
# or ClipFull and the channels enter equal-length over the same fixed buffer, the two checks are made once against the shared length up front) so a refusal never desynchronises the channels. The
# crux is four laws. THE STEREO INSERT LAW: each channel equals lotus-audio's mono insert_silence on that channel byte for byte, both grown by count, the gap all zero. THE BALANCE / INVARIANT LAW:
# left.len == right.len after, both grown by count. THE INVERSE LAW: insert_silence(at, count) then lotus-audio's stereo_cut(at, count) returns both channels. THE ATOMICITY / DEGENERATE LAW: a
# refusal leaves both channels untouched and balanced, count 0 the identity, at = len appending at the tail, a grow past the buffer ClipFull.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_stereo_insert_silence_witness.rish

say "ales-stereo-insert-silence: Language EN — stereo_insert_silence opens count samples of silence at position at in both channels of a StereoClip, so the Insert → Silence gesture lotus-audio named for a mono clip now lands on a real stereo master. A Lotus master is two Clips heard together, one per speaker, whose defining invariant is that left and right hold the same length so the two channels stay aligned in time; opening a gap for a downbeat, a countdown, or an alignment lands it in both speakers at once. It is the growth-twin of lotus-audio's stereo_silence_span — where silence_span writes zeros over an existing span and the length holds, insert_silence opens new zero seats and the length grows: silence written in place versus silence made room for. It carries lotus-audio's proven mono insert_silence into stereo — the same at and count on each channel — so the gap opens identically in both and the stereo image stays balanced."
say "ales-stereo-insert-silence: Style Radiant — the rule is stated positively: run the mono insert_silence per channel over its public API, validating both channels before either is mutated (because mono insert_silence can fault only with BadRange or ClipFull and the channels enter equal-length over the same fixed buffer, the two checks are made once against the shared length up front), so a refusal never leaves one channel grown and the other not. The crux stands out as four laws: the stereo insert law (each channel equals lotus-audio's mono insert_silence on that channel byte for byte, both grown by count, the gap all zero and every existing sample kept), the balance / invariant law (left.len == right.len after the edit, both grown by exactly count, the stereo image staying aligned), the inverse law (insert_silence(at, count) then lotus-audio's stereo_cut(at, count) returns both channels to the original byte for byte — the lossless round-trip lifted from mono lotus-audio), and the atomicity / degenerate law (any refusal leaves both channels byte for byte untouched and still balanced, count 0 the identity on both, at = len appending silence at the tail, a bad insertion point BadRange, a grow past the buffer ClipFull)."
say "ales-stereo-insert-silence: Lens TAME — two bounded i16 Clips (left, right) whose gap is opened in lockstep; the insertion point is checked against the common channel length once up front (at against len) and the grow is checked without underflow (count against max_clip - len), so every refusal comes by name before any write and the channels can never desynchronise; insert_silence shifts the tail high-index-first with no second buffer, so the grow is exact and bounded by max_clip; it reuses lotus-audio's EditError whole and lotus-audio's insert_silence per channel over its public API, inventing no new primitive; the stereo insert law is proven against lotus-audio's own insert_silence run per channel, and the inverse law sets it against lotus-audio's stereo_cut so the round-trip is lossless; siloed to lotus/, no real sample rate, no network, no keys, no funds, no device, no speaker."

let zig = "vendor/zig-toolchain/zig"
# THE BINARY LANDS IN A PEN, NEVER A SHARED PATH IN THE TREE (REDS %700). A fixed path is
# one name every run in this checkout writes: one run EXECUTES it while another's linker
# opens it, and the linker refuses with ETXTBSY -- so the guard answers differently on
# bytes nobody changed. `printf %s` trims the newline a bare capture would keep.
let pen = run ["sh" "-c" "printf %s $(mktemp -d)"]
assert pen.ok else "could not make a build pen: ${pen.err}"
let bin = "${pen.out}/stereo_insert_silence"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh lotus/stereo_insert_silence.rye -femit-bin=${bin}"]
assert build.ok else "ales-stereo-insert-silence: build failed — ${build.err}"

let outfile = "lotus/bin/stereo_insert_silence.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-stereo-insert-silence: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-stereo-insert-silence: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-stereo-insert-silence' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-stereo-insert-silence: selftest did not print the GREEN ales-stereo-insert-silence line"

# The pen is swept here rather than left for the next run to meet.
let pen_swept = run ["sh" "-c" "rm -rf ${pen.out}"]
assert pen_swept.ok else "the build pen outlived its witness: ${pen_swept.err}"
