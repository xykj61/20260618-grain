# tools/al/ales_cue_seal_witness.rish -- the cue sheet, sealed (lotus-audio).
#
# Chapter: the Six-Chapter double-seat, Chapter C thread (Lotus - the creative suite) - waymark lotus-audio - rung lotus-audio.
# Design read: active-designing/date/20260814/20260814-153033_fill-ales37-lotus-cue-seal.md
# Stands on: lotus/cue_sheet.rye (lotus-audio) -- render_sheet / parse_sheet reused whole as the sealed body; lotus/markers.rye (lotus-audio) --
# the Markers track sealed and rebuilt. Mirrors lotus/rack_seal.rye (lotus-audio) and the Sha256 verify-before-trust of lotus/wire.rye (lotus-audio).
#
# lotus/cue_seal.rye seals an lotus-audio cue sheet with a Sha256 content digest and refuses to parse a record whose digest does not match
# its body -- the wire's verify-before-trust (and the lotus-audio rack seal) handed to the saveable arrangement map. The crux: a sealed cue
# sheet parses back to exactly the same markers track ONLY when its digest matches its body -- seal_sheet renders the plain lotus-audio
# record as the body and writes a Sha256 over exactly those bytes, and verify_and_parse recomputes the digest and hands the body to
# cue_sheet.parse_sheet only on a match (which then bounds each position against the master), so a hand-edited position, a truncated
# tail, or a changed name is caught at the gate before a single marker is trusted. The selftest proves: a sealed four-marker track
# round-trips whole; a flipped body byte and a truncated tail refuse DigestMismatch; a plain record, a missing, short, or non-hex digest
# line refuses BadRecord; a seal into a too-small buffer refuses Overflow. The seal proves a sheet arrived whole, not who wrote it -- no
# signature, no keys, no network, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_cue_seal_witness.rish

say "ales-cue-seal: Language EN — lotus-audio gives the lotus-audio cue sheet a Sha256 content digest, so a keeper's saved arrangement map verifies before it is trusted: a hand-edited marker position, a truncated file, a changed name is caught at the gate rather than parsed as some other arrangement — the same verify-before-trust the lotus-audio rack seal keeps for the held audio, revealing the seal as a law for any travels-as-text record."
say "ales-cue-seal: Style Radiant — the law is stated positively: a sealed cue sheet parses back to exactly the same markers track ONLY when its digest matches its body — seal_sheet wraps lotus-audio whole and hashes exactly the rendered body, and verify_and_parse checks the digest BEFORE trust and hands the body to cue_sheet.parse_sheet only on a match, so no corrupt record ever reaches the parser."
say "ales-cue-seal: Lens TAME — cue_sheet.render_sheet / parse_sheet reused whole (the seal adds only the digest layer, no new grammar); the one honest difference from the rack seal is that parse_sheet bounds positions against a master, so verify_and_parse passes the master through; a malformed header or digest line refuses BadRecord (structural), a body that no longer matches its digest refuses DigestMismatch (content), each before a marker is parsed; siloed to lotus/, no signature, no key, no network, no funds, no device, no meter, no speaker."

let zig = "vendor/zig-toolchain/zig"
# THE BINARY LANDS IN A PEN, NEVER A SHARED PATH IN THE TREE (REDS %700). A fixed path is
# one name every run in this checkout writes: one run EXECUTES it while another's linker
# opens it, and the linker refuses with ETXTBSY -- so the guard answers differently on
# bytes nobody changed. `printf %s` trims the newline a bare capture would keep.
let pen = run ["sh" "-c" "printf %s $(mktemp -d)"]
assert pen.ok else "could not make a build pen: ${pen.err}"
let bin = "${pen.out}/cue_seal"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh lotus/cue_seal.rye -femit-bin=${bin}"]
assert build.ok else "ales-cue-seal: build failed — ${build.err}"

let outfile = "lotus/bin/cue_seal.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-cue-seal: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-cue-seal: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-cue-seal' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-cue-seal: selftest did not print the GREEN ales-cue-seal line"

say "ales-cue-seal: GREEN — a keeper's saved arrangement map verifies before it is trusted: seal_sheet writes a Sha256 over exactly the lotus-audio body, verify_and_parse refuses DigestMismatch on any edited position or truncated tail before a single marker is parsed and BadRecord on a malformed seal, a sealed four-marker track round-trips whole, and a too-small buffer refuses Overflow. With both the rack sheet (lotus-audio) and the cue sheet sealed, verify-before-trust is shown to be general; the next purely-local rung is a session file bundling the rack and the cue sheet over one master. The SIGNED carry (via a Kumara key) and the lotus-audio-wire carry stay module seams for Keaton's word."

# The pen is swept here rather than left for the next run to meet.
let pen_swept = run ["sh" "-c" "rm -rf ${pen.out}"]
assert pen_swept.ok else "the build pen outlived its witness: ${pen_swept.err}"
