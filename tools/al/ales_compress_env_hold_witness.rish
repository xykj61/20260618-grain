# tools/al/ales_compress_env_hold_witness.rish -- an attack/HOLD/release compressor: the breathing compressor given the stage between its knobs (lotus-audio).
#
# Chapter: the Six-Chapter double-seat, Chapter C thread (Lotus - the creative suite) - waymark lotus-audio - rung lotus-audio.
# Design read: active-designing/date/20260814/20260814-181719_fill-ales58-lotus-attack-hold-release-compressor.md
# Stands on: lotus/timeline.rye (lotus-audio -- the Clip, sample_min/sample_max, max_clip, the range law shape); lotus/compress.rye (lotus-audio --
# the softened ceiling this drives over time, re-proven below); lotus/hold_env.rye (lotus-audio -- the HELD time base, re-proven below); lotus/
# compress_env.rye (lotus-audio -- the un-held attack/release compressor this reduces to at a hold of zero, re-proven below).
#
# lotus/compress_env_hold.rye drives lotus-audio's softened ceiling from lotus-audio's HELD follower: each sample advances the held follower one
# step (attack rising and rearming the hold, the peak pinned while the countdown lasts, the release only once it expires), and when the
# held envelope crosses the threshold its excess is divided by the ratio and that gain applied to the raw sample. The selftest proves:
# silence stays silence; a hold of zero reduces to the plain lotus-audio attack/release compressor byte-for-byte (proven by running both
# tools on one signal); unit ratio is the identity everywhere; a loud signal has its magnitude reduced with the sign held and never
# expanding; a nonzero hold keeps the gain reduction engaged across a brief duck (it does not pump, the knob monotone); the state
# carries so a span in two pieces equals the whole once; a bad threshold refuses BadThreshold, a sub-unity ratio BadRatio, an illegal
# coefficient BadCoeff, a hold past max_clip BadHold, an out-of-range span BadRange. Purely local -- no network, no keys, no funds, no
# real device, no sample rate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_compress_env_hold_witness.rish

say "ales-compress-env-hold: Language EN — lotus-audio spends the lotus-audio hold proof for the compressor: lotus-audio gave the compressor a patient sense of time, yet an un-held compressor still lets its gain jump back toward unity the moment a loud passage momentarily ducks below the threshold (it pumps, and the ear hears the gain breathe). This rung swaps the plain follower for the HELD one, so on a fall away from a peak the envelope pins the peak above the threshold and the gain reduction stays engaged through the duck — the level stays steady. It is the mirror of lotus-audio's held gate: the gate's hold keeps the door open across a dip, the compressor's keeps the gain reduction engaged across a duck."
say "ales-compress-env-hold: Style Radiant — the law is stated positively: a hold of zero IS the plain lotus-audio attack/release compressor byte-for-byte (the zero-hold limit, proven by running both tools on one signal), unit ratio is the identity everywhere, a nonzero hold keeps the gain reduction engaged across a brief duck (it does not pump, the knob monotone), and the state carries — env and hold_left both — so a span in two pieces equals the whole once, the seam invisible (lotus-audio's lesson)."
say "ales-compress-env-hold: Lens TAME — bounded Clip, u32 span, i16 samples, i64 envelope, u32 hold counter; threshold checked in [1, sample_max], ratio at least unity with a nonzero denominator, both coefficients in (0, 1] by the follower's one proven rule, the hold bounded by max_clip, all before any write; the compressed envelope kept within [threshold, envelope] so the gain sits in (0, 1] and every written magnitude is at most the input's, fitting i16; the branch is e > threshold >= 1 so the divide is always safe (no zero-envelope case, unlike the gate); a bad threshold refuses BadThreshold, a sub-unity ratio BadRatio, an illegal coefficient BadCoeff, a hold past max_clip BadHold, an out-of-range span BadRange; siloed to lotus/, no network, no keys, no funds, no device, no sample rate."

let zig = "vendor/zig-toolchain/zig"
# THE BINARY LANDS IN A PEN, NEVER A SHARED PATH IN THE TREE (REDS %700). A fixed path is
# one name every run in this checkout writes: one run EXECUTES it while another's linker
# opens it, and the linker refuses with ETXTBSY -- so the guard answers differently on
# bytes nobody changed. `printf %s` trims the newline a bare capture would keep.
let pen = run ["sh" "-c" "printf %s $(mktemp -d)"]
assert pen.ok else "could not make a build pen: ${pen.err}"
let bin = "${pen.out}/compress_env_hold"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh lotus/compress_env_hold.rye -femit-bin=${bin}"]
assert build.ok else "ales-compress-env-hold: build failed — ${build.err}"

let outfile = "lotus/bin/compress_env_hold.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-compress-env-hold: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-compress-env-hold: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-compress-env-hold' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-compress-env-hold: selftest did not print the GREEN ales-compress-env-hold line"

# This rung composes three parents over their public APIs -- re-prove lotus-audio's held follower, lotus-audio's compressor, and lotus-audio's un-held
# compressor still stand green under it.
let h = run ["sh" "-c" "env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh lotus/hold_env.rye -femit-bin=lotus/bin/hold_env && lotus/bin/hold_env selftest 2>&1 | grep -q 'GREEN ales-hold-env' && echo yes"]
assert (trim h.out) == "yes" else "ales-compress-env-hold: the lotus-audio held follower regressed under the attack/hold/release compressor"

let c = run ["sh" "-c" "env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh lotus/compress.rye -femit-bin=lotus/bin/compress && lotus/bin/compress selftest 2>&1 | grep -q 'GREEN ales-compress' && echo yes"]
assert (trim c.out) == "yes" else "ales-compress-env-hold: the lotus-audio compressor regressed under the attack/hold/release compressor"

let ce = run ["sh" "-c" "env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh lotus/compress_env.rye -femit-bin=lotus/bin/compress_env && lotus/bin/compress_env selftest 2>&1 | grep -q 'GREEN ales-compress-env' && echo yes"]
assert (trim ce.out) == "yes" else "ales-compress-env-hold: the lotus-audio attack/release compressor regressed under the attack/hold/release compressor"

say "ales-compress-env-hold: GREEN — an attack/HOLD/release compressor drives lotus-audio's softened ceiling from lotus-audio's HELD envelope, each sample advancing the held follower one step and, when the held envelope crosses the threshold, dividing its excess by the ratio and applying that gain to the raw sample; a hold of zero is the plain lotus-audio compressor byte-for-byte, unit ratio is the identity everywhere, a loud signal's magnitude reduces with the sign held, a nonzero hold keeps the gain reduction engaged across a brief duck (the knob monotone, no pumping), the state carries so a span in two pieces equals the whole once; a bad threshold refuses BadThreshold, a sub-unity ratio BadRatio, an illegal coefficient BadCoeff, a hold past max_clip BadHold, an out-of-range span BadRange, each leaving the clip untouched; the lotus-audio held follower, lotus-audio compressor, and lotus-audio compressor selftests stay GREEN. The compressor now holds too — the limiter (lotus-audio) takes the same swap next, a short rung reading the same proven env_step_hold; the lookahead delay for a true brickwall stays Keaton's hand."

# The pen is swept here rather than left for the next run to meet.
let pen_swept = run ["sh" "-c" "rm -rf ${pen.out}"]
assert pen_swept.ok else "the build pen outlived its witness: ${pen_swept.err}"
