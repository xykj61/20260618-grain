# tools/hunk_sprite_witness.rish — the single-sprite marketplace index renders on metal (open-image, sprite quest opens).
#
# Chapter A (Hardware & Right-to-Repair) · waymark open-image · Open Image journey · rung open-image.
# Design read: active-designing/date/20260813/20260813-201500_hunk-sprite-marketplace-index-exploration.md
# Teacher, thanked clean-room: McMaster-Carr's one-sprite-sheet render trick (concept only, siloed).
#
# The open-image–open-image quest built the open image module (codec · content address · painted · cropped). This rung
# opens Chapter A's parts-marketplace trick over it: `image/sprite.rye` `SpriteIndex` binds each product name to
# a bounded rectangle — a window — into ONE decoded sheet, and `render` returns that window as a fresh open
# image by reusing open-image's own `photos.crop`. The selftest indexes three products into one 8×8 tagged sheet and
# proves each renders exactly its own window, that disjoint windows carry different pixels (no product leaks a
# neighbor's bytes), that the one sheet is shared and unmutated across every render, and that a rendered product
# is still an open image that re-encodes and round-trips byte-for-byte. Unknown name, out-of-bounds window,
# empty window, duplicate name, and overlong name each refuse by name. No network, no key, no funds — one
# decode serves every product, McMaster-Carr's speed trick over the tree's own open module.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/hunk_sprite_witness.rish

say "hunk-sprite: Language EN — open-image opens Chapter A's parts-marketplace trick over the open module: one decoded sheet, each product a bounded window into it, rendered by reusing open-image's crop."
say "hunk-sprite: Style Radiant — one sprite decoded once serves every product; a render is a read of the same bytes, and a rendered product is still an open image that re-encodes and round-trips."
say "hunk-sprite: Lens TAME — u32 window coordinates bound-checked in u64 at add time so a render can never fail on bounds; the catalog names its ceiling; copy_disjoint for names; positive invariants per fn; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/sprite"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/sprite.rye -femit-bin=${bin}"]
assert build.ok else "hunk-sprite: build failed — ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "hunk-sprite: selftest exited non-zero — ${selftest.out}"

let out = trim selftest.out
say "hunk-sprite: ${out}"

assert selftest.out contains "GREEN image-sprite" else "hunk-sprite: selftest did not print the GREEN sprite line"

assert selftest.out contains "decoded once" else "hunk-sprite: the selftest did not prove one sheet decoded once serving every product"

assert selftest.out contains "each renders exactly its window" else "hunk-sprite: the selftest did not prove each product renders exactly its window"

assert selftest.out contains "disjoint windows carry different pixels" else "hunk-sprite: the selftest did not prove disjoint windows carry different pixels"

# open-image stays GREEN — the sprite index reuses photos.crop; the crop verb underneath must still hold.
let photos = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/photos.rye -femit-bin=image/bin/photos && image/bin/photos selftest 2>&1"]
assert photos.ok else "hunk-sprite: open-image photos re-run failed — ${photos.out}"
assert photos.out contains "GREEN image-photos" else "hunk-sprite: open-image photos selftest did not stay GREEN"

say "hunk-sprite: GREEN — the marketplace sprite index renders each product from one decoded sheet on metal; open-image crop underneath stays GREEN. open-image lands."
