# hearth_lulu3_witness.rish — hearth-display short home_id editor.
#
#   rishi/bin/rishi run tools/h/hearth_lulu3_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "linengrow/bin/hearth_lulu3_witness"

let build = run ["sh" "-c" "mkdir -p linengrow/bin && env RYE_ZIG=${zig} rye/bin/rye build linengrow/hearth_lulu3_witness.rye -femit-bin=${bin}"]
assert build.ok else "hearth-display home_id editor witness build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "hearth-display home_id editor witness exited non-zero"
assert selftest.out contains "GREEN" else "hearth-display not GREEN"
assert selftest.out contains "waymark hearth-display" else "hearth-display missing waymark claim"
assert selftest.out contains "home line" else "hearth-display missing home-line claim"
assert selftest.out contains "hearth_home pointer" else "hearth-display missing pointer claim"

say "GREEN: hearth-display Hearth home_id editor witness passed."
