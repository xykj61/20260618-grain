# hearth_lulu0_witness.rish -- hearth-display Hearth Kyri mold.
#
#   rishi/bin/rishi run tools/h/hearth_lulu0_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "linengrow/bin/hearth_lulu0_witness"

let build = run ["sh" "-c" "mkdir -p linengrow/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh linengrow/hearth_lulu0_witness.rye -femit-bin=${bin}"]
assert build.ok else "hearth-display hearth witness build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "hearth-display hearth witness exited non-zero"
assert selftest.out contains "GREEN" else "hearth-display not GREEN"
assert selftest.out contains "waymark hearth-display" else "hearth-display missing waymark claim"
assert selftest.out contains "preset sizes" else "hearth-display missing preset-size claim"
assert selftest.out contains "refuses bad home_id" else "hearth-display missing home_id refuse claim"
assert selftest.out contains "kd/hearth.kyri" else "hearth-display missing path claim"
assert selftest.out contains "Kyri round-trip" else "hearth-display missing Kyri round-trip claim"
assert selftest.out contains "unknown preset refused" else "hearth-display missing unknown-preset claim"

say "GREEN: hearth-display Hearth Kyri mold witness passed."
