# hearth_lulu2_witness.rish -- hearth-display thin Settings preset list.
#
#   rishi/bin/rishi run tools/h/hearth_lulu2_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "linengrow/bin/hearth_lulu2_witness"

let build = run ["sh" "-c" "mkdir -p linengrow/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh linengrow/hearth_lulu2_witness.rye -femit-bin=${bin}"]
assert build.ok else "hearth-display hearth list witness build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "hearth-display hearth list witness exited non-zero"
assert selftest.out contains "GREEN" else "hearth-display not GREEN"
assert selftest.out contains "waymark hearth-display" else "hearth-display missing waymark claim"
assert selftest.out contains "four-line list" else "hearth-display missing list claim"
assert selftest.out contains "long-press threshold" else "hearth-display missing long-press claim"
assert selftest.out contains "hold-open release skips cycle" else "hearth-display missing hold-open claim"

say "GREEN: hearth-display Hearth Settings list witness passed."
