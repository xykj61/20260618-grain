# tube1_admission_witness.rish — glow-publishing: admit iff manifest caps match a grant.
#
# Pool's door re-aimed at a glow-publishing Manifest. Device-free; composes landed
# tube_manifest.rye + pool_host_seam.rye. See linengrow/tube1_admission.rye.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/tube1_admission_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "linengrow/bin/tube1_admission_witness"

let build = run ["sh" "-c" "mkdir -p linengrow/bin && env RYE_ZIG=${zig} rye/bin/rye build linengrow/tube1_admission_witness.rye -femit-bin=${bin}"]
assert build.ok else "glow-publishing admission witness build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "glow-publishing admission witness exited non-zero"
assert selftest.out contains "GREEN" else "glow-publishing admission witness not GREEN"
assert selftest.out contains "welcome path" else "glow-publishing missing the matching-grant welcome path"
assert selftest.out contains "NotAdmitted" else "glow-publishing missing the unwelcome NotAdmitted path"
assert selftest.out contains "read-only grant" else "glow-publishing missing the rights-mismatch path"
assert selftest.out contains "Storage Scope admits" else "glow-publishing missing scoped welcome path"
assert selftest.out contains "revoked Storage Scope" else "glow-publishing missing scoped revoke path"
assert selftest.out contains "Contact Scopes stack" else "glow-publishing missing contact-scope stack path"
assert selftest.out contains "Contact Scope weaker" else "glow-publishing missing contact-rights refuse"
assert selftest.out contains "Network Grant admits" else "glow-publishing missing network welcome path"
assert selftest.out contains "denied Network Grant" else "glow-publishing missing network deny path"
assert selftest.out contains "revoked Network Grant" else "glow-publishing missing network revoke path"
assert selftest.out contains "Sensors Grant admits" else "glow-publishing missing sensors welcome path"
assert selftest.out contains "denied Sensors Grant" else "glow-publishing missing sensors deny path"
assert selftest.out contains "revoked Sensors Grant" else "glow-publishing missing sensors revoke path"

say "GREEN: glow-publishing admission witness passed — grant + Storage + Contact + Network + Sensors."
