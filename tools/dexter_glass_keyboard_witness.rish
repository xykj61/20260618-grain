# dexter_glass_keyboard_witness.rish — glass-keyboard tables + glass-keyboard paint/hit.
#
#   rishi/bin/rishi run tools/dexter_glass_keyboard_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "linengrow/bin/dexter_glass_keyboard_witness"

let build = run ["sh" "-c" "mkdir -p linengrow/bin && env RYE_ZIG=${zig} rye/bin/rye build linengrow/dexter_glass_keyboard_witness.rye -femit-bin=${bin}"]
assert build.ok else "glass-keyboard keyboard witness build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "glass-keyboard keyboard witness exited non-zero"
assert selftest.out contains "GREEN" else "glass-keyboard not GREEN"
assert selftest.out contains "waymark glass-keyboard" else "glass-keyboard missing waymark claim"
assert selftest.out contains "letters QWERTY" else "glass-keyboard missing letters claim"
assert selftest.out contains "numbers page" else "glass-keyboard missing numbers claim"
assert selftest.out contains "symbols page" else "glass-keyboard missing symbols claim"
assert selftest.out contains "letters paint lines" else "glass-keyboard missing paint claim"
assert selftest.out contains "hit boxes" else "glass-keyboard missing hit-box claim"

say "GREEN: glass-keyboard+glass-keyboard — layout tables and letters paint/hit under waymark glass-keyboard."
