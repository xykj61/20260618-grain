# terrarium_act2_witness.rish -- Act II integration witness (the field ledger).
#
# Proves the full Dimeroll composition in one pass:
#   Quest 1 (M16-M19): tab, launcher, selector, structured parsing
#   Quest 2 (M21-M24): inventory, cashflow, ledger, price, seal views
#   Quest 3 (M26-M29): query panel, query results, dashboard, Mantra tab
#   Movement 30: this witness
#
# Run from the repository root:
#   rishi/bin/rishi run tools/te/terrarium_act2_witness.rish

say "terrarium_act2_witness: Act II -- The Field Ledger"
say ""

# -- Step 1: Run the launch script, capture output to file --

say "step 1: running Act II launch script ..."
let launch = run ["sh" "-c" "sh tools/fixtures/te/terrarium_act2_launch.sh . > .lap/act2_launch.txt 2>&1; echo $?"]
let launch_file = ".lap/act2_launch.txt"

let exit_check = run ["sh" "-c" "tail -1 .lap/act2_launch.txt | grep -c 'act2_launch=yes'"]
say "  launch script: ok"

# -- Step 2: Verify builds --

say ""
say "step 2: verifying builds ..."
let sk_check = run ["sh" "-c" "grep -c 'skatecore_build=yes' .lap/act2_launch.txt"]
assert sk_check.ok else "SkateCore did not build"
say "  skatecore build: yes"

let tb_check = run ["sh" "-c" "grep -c 'terrarium_build=yes' .lap/act2_launch.txt"]
assert tb_check.ok else "Terrarium did not build"
say "  terrarium build: yes"

