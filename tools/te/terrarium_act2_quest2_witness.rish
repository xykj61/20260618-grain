# terrarium_act2_quest2_witness.rish -- Act II Quest 2 integration witness.
#
# Proves Ledger Views (Movements 21-24):
#   M21: Inventory summary view -- parseDimerollInventoryLine
#   M22: Cash flow view -- parseDimerollCashflowLine
#   M23: Ledger page rendering -- parseDimerollLedgerLine
#   M24: Price arithmetic and seal display -- parseDimerollPriceLine, parseDimerollSealLine
#   M25: this witness
#
# Run from the repository root:
#   rishi/bin/rishi run tools/te/terrarium_act2_quest2_witness.rish

say "terrarium_act2_quest2_witness: Act II Quest 2 -- Ledger Views"
say ""

# -- Step 1: Run the launch script, capture output to file --

say "step 1: running Act II Quest 2 launch script ..."
let launch = run ["sh" "-c" "sh tools/fixtures/te/terrarium_act2_quest2_launch.sh . > .lap/act2q2_launch.txt 2>&1; echo $?"]
let launch_file = ".lap/act2q2_launch.txt"

let exit_check = run ["sh" "-c" "tail -1 .lap/act2q2_launch.txt | grep -c 'quest2_launch=yes'"]
say "  launch script: ok"

# -- Step 2: Verify builds --

say ""
say "step 2: verifying builds ..."
let sk_check = run ["sh" "-c" "grep -c 'skatecore_build=yes' .lap/act2q2_launch.txt"]
assert sk_check.ok else "SkateCore did not build"
say "  skatecore build: yes"

let tb_check = run ["sh" "-c" "grep -c 'terrarium_build=yes' .lap/act2q2_launch.txt"]
assert tb_check.ok else "Terrarium did not build"
say "  terrarium build: yes"

# -- Step 3a: M21-M24 symbols via strings (7) --

say ""
say "step 3a: verifying M21-M24 symbols in binary ..."

let s1 = run ["sh" "-c" "grep -c 'sym_inventory=yes' .lap/act2q2_launch.txt"]
assert s1.ok else "dimerollInventory not found in binary"
say "  dimerollInventory: yes"

let s2 = run ["sh" "-c" "grep -c 'sym_active_elf=yes' .lap/act2q2_launch.txt"]
assert s2.ok else "dimerollActiveElf not found in binary"
say "  dimerollActiveElf: yes"

let s3 = run ["sh" "-c" "grep -c 'sym_in_ledger_table=yes' .lap/act2q2_launch.txt"]
assert s3.ok else "dimerollInLedgerTable not found in binary"
say "  dimerollInLedgerTable: yes"

let s4 = run ["sh" "-c" "grep -c 'sym_cashflow=yes' .lap/act2q2_launch.txt"]
assert s4.ok else "dimerollCashflow not found in binary"
say "  dimerollCashflow: yes"

let s5 = run ["sh" "-c" "grep -c 'sym_ledger=yes' .lap/act2q2_launch.txt"]
assert s5.ok else "dimerollLedger not found in binary"
say "  dimerollLedger: yes"

let s6 = run ["sh" "-c" "grep -c 'sym_price=yes' .lap/act2q2_launch.txt"]
assert s6.ok else "dimerollPrice not found in binary"
say "  dimerollPrice: yes"

let s7 = run ["sh" "-c" "grep -c 'sym_seal=yes' .lap/act2q2_launch.txt"]
assert s7.ok else "dimerollSeal not found in binary"
say "  dimerollSeal: yes"

# -- Step 3b: Parser functions via nm demangle (6) --

say ""
say "step 3b: verifying parser functions ..."

let f1 = run ["sh" "-c" "grep -c 'fn_rebuild_columns=yes' .lap/act2q2_launch.txt"]
assert f1.ok else "rebuildDimerollColumns not found"
say "  rebuildDimerollColumns: yes"

let f2 = run ["sh" "-c" "grep -c 'fn_parse_inventory=yes' .lap/act2q2_launch.txt"]
assert f2.ok else "parseDimerollInventoryLine not found"
say "  parseDimerollInventoryLine: yes"

let f3 = run ["sh" "-c" "grep -c 'fn_parse_cashflow=yes' .lap/act2q2_launch.txt"]
assert f3.ok else "parseDimerollCashflowLine not found"
say "  parseDimerollCashflowLine: yes"

let f4 = run ["sh" "-c" "grep -c 'fn_parse_ledger=yes' .lap/act2q2_launch.txt"]
assert f4.ok else "parseDimerollLedgerLine not found"
say "  parseDimerollLedgerLine: yes"

let f5 = run ["sh" "-c" "grep -c 'fn_parse_price=yes' .lap/act2q2_launch.txt"]
assert f5.ok else "parseDimerollPriceLine not found"
say "  parseDimerollPriceLine: yes"

let f6 = run ["sh" "-c" "grep -c 'fn_parse_seal=yes' .lap/act2q2_launch.txt"]
assert f6.ok else "parseDimerollSealLine not found"
say "  parseDimerollSealLine: yes"

# -- Step 4: QEMU integration -- all 6 Dimeroll modules --

say ""
say "step 4: verifying QEMU integration across 6 modules ..."

# 4a: dimeroll_tx_g (baseline, M19)
let tx1 = run ["sh" "-c" "grep -c 'tx_elf=yes' .lap/act2q2_launch.txt"]
assert tx1.ok else "tx ELF not found"
let tx2 = run ["sh" "-c" "grep -c 'tx_qemu=yes' .lap/act2q2_launch.txt"]
assert tx2.ok else "tx QEMU did not launch"
let tx3 = run ["sh" "-c" "grep -c 'tx_exited=yes' .lap/act2q2_launch.txt"]
assert tx3.ok else "tx QEMU did not exit"
let tx4 = run ["sh" "-c" "grep -c 'tx_output=yes' .lap/act2q2_launch.txt"]
assert tx4.ok else "tx output not seen"
let tx5 = run ["sh" "-c" "grep -c 'tx_parsed=yes' .lap/act2q2_launch.txt"]
assert tx5.ok else "tx line not parsed"
say "  dimeroll_tx_g: QEMU launched, output parsed, clean exit"

# 4b: dimeroll_inventory_g (M21)
let inv1 = run ["sh" "-c" "grep -c 'inv_elf=yes' .lap/act2q2_launch.txt"]
assert inv1.ok else "inventory ELF not found"
let inv2 = run ["sh" "-c" "grep -c 'inv_qemu=yes' .lap/act2q2_launch.txt"]
assert inv2.ok else "inventory QEMU did not launch"
let inv3 = run ["sh" "-c" "grep -c 'inv_exited=yes' .lap/act2q2_launch.txt"]
assert inv3.ok else "inventory QEMU did not exit"
let inv4 = run ["sh" "-c" "grep -c 'inv_tomatoes=yes' .lap/act2q2_launch.txt"]
assert inv4.ok else "inventory tomatoes not found"
let inv5 = run ["sh" "-c" "grep -c 'inv_peppers=yes' .lap/act2q2_launch.txt"]
assert inv5.ok else "inventory peppers not found"
say "  dimeroll_inventory_g: QEMU launched, tomatoes+peppers parsed, clean exit"

# 4c: dimeroll_cashflow_g (M22)
let cf1 = run ["sh" "-c" "grep -c 'cf_elf=yes' .lap/act2q2_launch.txt"]
assert cf1.ok else "cashflow ELF not found"
let cf2 = run ["sh" "-c" "grep -c 'cf_qemu=yes' .lap/act2q2_launch.txt"]
assert cf2.ok else "cashflow QEMU did not launch"
let cf3 = run ["sh" "-c" "grep -c 'cf_exited=yes' .lap/act2q2_launch.txt"]
assert cf3.ok else "cashflow QEMU did not exit"
let cf4 = run ["sh" "-c" "grep -c 'cf_marker=yes' .lap/act2q2_launch.txt"]
assert cf4.ok else "cashflow marker not found"
let cf5 = run ["sh" "-c" "grep -c 'cf_revenue=yes' .lap/act2q2_launch.txt"]
assert cf5.ok else "cashflow revenue not found"
say "  dimeroll_cashflow_g: QEMU launched, markers+revenue parsed, clean exit"

# 4d: dimeroll_ledger_g (M23)
let led1 = run ["sh" "-c" "grep -c 'led_elf=yes' .lap/act2q2_launch.txt"]
assert led1.ok else "ledger ELF not found"
let led2 = run ["sh" "-c" "grep -c 'led_qemu=yes' .lap/act2q2_launch.txt"]
assert led2.ok else "ledger QEMU did not launch"
let led3 = run ["sh" "-c" "grep -c 'led_exited=yes' .lap/act2q2_launch.txt"]
assert led3.ok else "ledger QEMU did not exit"
let led4 = run ["sh" "-c" "grep -c 'led_plant=yes' .lap/act2q2_launch.txt"]
assert led4.ok else "ledger plant verb not found"
let led5 = run ["sh" "-c" "grep -c 'led_harvest=yes' .lap/act2q2_launch.txt"]
assert led5.ok else "ledger harvest verb not found"
say "  dimeroll_ledger_g: QEMU launched, plant+harvest parsed, clean exit"

# 4e: dimeroll_price_g (M24)
let prc1 = run ["sh" "-c" "grep -c 'prc_elf=yes' .lap/act2q2_launch.txt"]
assert prc1.ok else "price ELF not found"
let prc2 = run ["sh" "-c" "grep -c 'prc_qemu=yes' .lap/act2q2_launch.txt"]
assert prc2.ok else "price QEMU did not launch"
let prc3 = run ["sh" "-c" "grep -c 'prc_exited=yes' .lap/act2q2_launch.txt"]
assert prc3.ok else "price QEMU did not exit"
let prc4 = run ["sh" "-c" "grep -c 'prc_proof=yes' .lap/act2q2_launch.txt"]
assert prc4.ok else "price PROOF PASS not found"
let prc5 = run ["sh" "-c" "grep -c 'prc_all_passed=yes' .lap/act2q2_launch.txt"]
assert prc5.ok else "price ALL PROOFS PASSED not found"
say "  dimeroll_price_g: QEMU launched, proofs passed, clean exit"

# 4f: dimeroll_seal_g (M24)
let seal1 = run ["sh" "-c" "grep -c 'seal_elf=yes' .lap/act2q2_launch.txt"]
assert seal1.ok else "seal ELF not found"
let seal2 = run ["sh" "-c" "grep -c 'seal_qemu=yes' .lap/act2q2_launch.txt"]
assert seal2.ok else "seal QEMU did not launch"
let seal3 = run ["sh" "-c" "grep -c 'seal_exited=yes' .lap/act2q2_launch.txt"]
assert seal3.ok else "seal QEMU did not exit"
let seal4 = run ["sh" "-c" "grep -c 'seal_verified=yes' .lap/act2q2_launch.txt"]
assert seal4.ok else "seal VERIFIED not found"
let seal5 = run ["sh" "-c" "grep -c 'seal_format=yes' .lap/act2q2_launch.txt"]
assert seal5.ok else "seal amphora-v1 not found"
say "  dimeroll_seal_g: QEMU launched, verified+amphora parsed, clean exit"

# -- Verdict --

say ""
say "----"
say "terrarium_act2_quest2_witness verdict:"
say "  M21 Inventory view (parseDimerollInventoryLine): PROVEN"
say "  M22 Cash flow view (parseDimerollCashflowLine): PROVEN"
say "  M23 Ledger page (parseDimerollLedgerLine): PROVEN"
say "  M24 Price and seal (parseDimerollPriceLine, parseDimerollSealLine): PROVEN"
say "  7 binary symbols verified, 6 parser functions verified"
say "  6 Dimeroll modules launched through QEMU, all output verified"
say ""
say "Act II Quest 2 (Ledger Views): ALL 5 MOVEMENTS PROVEN"
