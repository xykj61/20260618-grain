# tools/gen/chapter/sunn15_journey_close_witness.rish — source-identity journey close.
#
#   rishi/bin/rishi run tools/gen/chapter/sunn15_journey_close_witness.rish
#
# Choir still GREEN · handback CONSUMED · Equinox finishing edge named.

say "sunn15: Language EN — source-identity closes; Equinox resumes at e50."
say "sunn15: Style Radiant — handback consumed · nested surface waits."
say "sunn15: Lens TAME — source-identity · close · return_equinox_e50 CONSUMED."

let choir = run ["rishi/bin/rishi" "run" "tools/gen/chapter/sunn14_witness_choir.rish"]
say choir.out
assert choir.ok else "sunn15: sunn14 choir RED"
assert choir.out contains "GREEN: sunn14" else "sunn15: choir missing GREEN"

let rb = read-file "tools/gen/chapter/recursion_block.brix"
assert rb contains "coords_sunn_status source-identity-15 GREEN · CLOSED" else "sunn15: recursion want source-identity CLOSED"
assert rb contains "return_equinox_e50 CONSUMED 20260730.161633" else "sunn15: recursion want handback CONSUMED"
assert rb contains "coords_equinox_status OPEN e49 GREEN · e50 next" else "sunn15: recursion want Equinox OPEN"
assert (rb contains "coords_sunn_status source-identity-14 GREEN · source-identity next · OPEN") == false else "sunn15: recursion must not keep source-identity OPEN next"

let counsel = read-file "counsel/20260730-161633_sunn-handback-return-equinox-e50.md"
assert counsel contains "return_equinox_e50` **CONSUMED**" else "sunn15: counsel want handback CONSUMED"
assert counsel contains "source-identity Journey** | **CLOSED**" else "sunn15: counsel want source-identity CLOSED"
assert counsel contains "e50 next" else "sunn15: counsel want e50 next"

let rem = read-file "work-in-progress/REMEMBER.md"
assert rem contains "source-identity Journey** **CLOSED**" else "sunn15: REMEMBER want source-identity CLOSED"
assert rem contains "return_equinox_e50` **CONSUMED**" else "sunn15: REMEMBER want handback CONSUMED"
assert rem contains "Equinox Chapter (deca)** **OPEN**" else "sunn15: REMEMBER want Equinox OPEN"
assert rem contains "e50 next" else "sunn15: REMEMBER want e50 next"

let src = read-file "SOURCE.md"
assert src contains "source-identity" else "sunn15: SOURCE want source-identity stamp"
assert src contains "Keaton Livermore" else "sunn15: SOURCE want Livermore"
assert src contains "standing writing voice is **Riyo**" else "sunn15: SOURCE want Riyo writing"

let lex = read-file "context/LEXICON.md"
assert lex contains "CLOSED" else "sunn15: LEXICON source-identity want CLOSED"
assert lex contains "return_equinox_e50 CONSUMED" else "sunn15: LEXICON want handback CONSUMED"

say "GREEN: sunn15 — source-identity-15 CLOSED · return_equinox_e50 CONSUMED · Equinox OPEN e50"
