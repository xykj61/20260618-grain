# hearth_lulu1_witness.rish — hearth-display apply Hearth preset to Skate metrics.
#
#   rishi/bin/rishi run tools/hearth_lulu1_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "linengrow/bin/hearth_lulu1_witness"

let build = run ["sh" "-c" "mkdir -p linengrow/bin && env RYE_ZIG=${zig} rye/bin/rye build linengrow/hearth_lulu1_witness.rye -femit-bin=${bin}"]
assert build.ok else "hearth-display hearth apply witness build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "hearth-display hearth apply witness exited non-zero"
assert selftest.out contains "GREEN" else "hearth-display not GREEN"
assert selftest.out contains "waymark hearth-display" else "hearth-display missing waymark claim"
assert selftest.out contains "panel_max reads window" else "hearth-display missing panel_max claim"
assert selftest.out contains "scaled_540 clamps" else "hearth-display missing scaled_540 clamp claim"
assert selftest.out contains "enlarges glyphs" else "hearth-display missing enlarge-glyphs claim"
assert selftest.out contains "mantrapod_floor scale 2" else "hearth-display missing floor claim"

say "GREEN: hearth-display Hearth apply witness passed."
