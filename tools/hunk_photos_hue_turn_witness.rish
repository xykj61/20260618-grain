# tools/hunk_photos_hue_turn_witness.rish — the Photos app turns hue on metal (open-image).
#
# Chapter A (Hardware & Right-to-Repair) · waymark open-image · journey Photos app · rung open-image.
# Design read: active-designing/date/20260813/20260813-172645_hunk-photos-hue-turn-exploration.md (the Photos-app journey).
# Teacher, thanked clean-room: the everyday iCloud Photos / Google Photos hue slider (concept only, siloed).
#
# open-image gave the Photos app its color (saturation) and named a hue rotation the next horizon — harder to bound
# cleanly in integer math. This rung lands the color wheel's three exactly-integer stops: `image/photos.rye`
# `hue_turn` rotates every pixel's hue by exactly 120·thirds degrees as a cyclic permutation of the three color
# channels — no trig, no rounding, no clamp. The selftest proves a zero turn recovers the source byte-for-byte,
# three turns compose to the identity, turn(2) equals two single thirds, a pure red walks red->green->blue->red
# (the +120 direction), every pixel keeps its max and min channel (HSV value and chroma preserved), an
# already-gray pixel is a fixed point at every turn, alpha passes through untouched, the hue-turned image still
# re-encodes and round-trips as an open image, and a degenerate image refuses by name. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/hunk_photos_hue_turn_witness.rish

say "hunk-photos-hue-turn: Language EN — open-image turns the Photos app's hue: a pure bounded channel-permutation over the decoded grid that returns a fresh open image, the source untouched, at the color wheel's three exact stops."
say "hunk-photos-hue-turn: Style Radiant — a hue-turned image is still an open image: it re-encodes and round-trips byte-for-byte, so hue tuning stands on the open module the quest built, never a proprietary one; the general-angle turn stays a named horizon."
say "hunk-photos-hue-turn: Lens TAME — the 120-degree turn is an exact integer channel permutation, no trig and no rounding; value and chroma are preserved by construction; the modulo is total so any thirds is valid; alpha passes through; positive invariants per fn; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/photos"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/photos.rye -femit-bin=${bin}"]
assert build.ok else "hunk-photos-hue-turn: build failed — ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "hunk-photos-hue-turn: selftest exited non-zero — ${selftest.out}"

let out = trim selftest.out

assert selftest.out contains "GREEN image-photos-hue-turn" else "hunk-photos-hue-turn: selftest did not print the GREEN hue-turn line"

assert selftest.out contains "a zero turn byte-identical" else "hunk-photos-hue-turn: the zero turn was not proven byte-identical"

assert selftest.out contains "three turns compose to the identity" else "hunk-photos-hue-turn: the order-three composition was not proven"

assert selftest.out contains "red->green->blue->red" else "hunk-photos-hue-turn: the +120 direction was not proven"

assert selftest.out contains "HSV value and chroma preserved" else "hunk-photos-hue-turn: value and chroma preservation was not proven"

assert selftest.out contains "already-gray pixel is a fixed point" else "hunk-photos-hue-turn: the gray fixed point was not proven"

assert selftest.out contains "alpha passes through untouched" else "hunk-photos-hue-turn: alpha pass-through was not proven"

assert selftest.out contains "hue-turned image re-encodes and round-trips" else "hunk-photos-hue-turn: a hue-turned image did not round-trip as an open image"

# open-image crop, open-image orient, open-image scale, open-image adjust, and open-image saturate selftests still run in the same binary.
assert selftest.out contains "GREEN image-photos:" else "hunk-photos-hue-turn: open-image crop selftest no longer GREEN beneath"
assert selftest.out contains "GREEN image-photos-orient" else "hunk-photos-hue-turn: open-image orient selftest no longer GREEN beneath"
assert selftest.out contains "GREEN image-photos-scale" else "hunk-photos-hue-turn: open-image scale selftest no longer GREEN beneath"
assert selftest.out contains "GREEN image-photos-adjust" else "hunk-photos-hue-turn: open-image adjust selftest no longer GREEN beneath"
assert selftest.out contains "GREEN image-photos-saturate" else "hunk-photos-hue-turn: open-image saturate selftest no longer GREEN beneath"

say "hunk-photos-hue-turn: GREEN — the Photos app turns hue over the open grid; pure, exact-integer, value and chroma preserved, alpha untouched, refusal named; open-image crop, open-image orient, open-image scale, open-image adjust, and open-image saturate still GREEN beneath."
