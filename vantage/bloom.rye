//! vantage/bloom.rye -- Bloom tab data model, extracted from
//! terrarium/app/main.swift on 20261107.
//!
//! Platform-agnostic: defines the galaxy manifest, title
//! extraction, separator format, and navigation bounds.
//! The platform shell (Swift/WASM) handles file I/O and
//! rendering; this module owns the content structure.
//!
//!   rye build vantage/bloom.rye -femit-bin=vantage/bin/bloom
//!   vantage/bin/bloom selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const bloom_version = "20261107.150000";

// -- Bounds: explicit widths per TAME
pub const max_galaxies: u32 = 16;
pub const max_files_per_galaxy: u32 = 16;
pub const max_lessons: u32 = 128;
pub const max_title_len: u32 = 256;

// -- Galaxy: one content collection in the Bloom tab
pub const Galaxy = struct {
    name: []const u8,
    directory: []const u8,
    files: []const []const u8,
    separator_title: []const u8,
    separator_body: []const u8,
};

// -- The manifest: 7 galaxies in display order.
