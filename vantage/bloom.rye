// -- Derived totals (comptime)
pub const total_files: u32 = count_files();
pub const separator_count: u32 =
    galaxy_count - 1;
pub const total_lessons: u32 =
    total_files + separator_count;

fn count_files() u32 {
    var n: u32 = 0;
    for (galaxies) |g| {
        // invariant: file list fits the bound
        assert(g.files.len <= max_files_per_galaxy);
        n += @intCast(g.files.len);
    }
    // invariant: total lessons fit the bound
    assert(n + galaxy_count - 1 <= max_lessons);
    return n;
}

// -- Title extraction: strip markdown heading prefix.
// Matches Swift's replacingOccurrences(of: "# ", with: "")
// on the first line. In practice this strips the leading
// "# " from a markdown heading.
pub fn extract_title(
    content: []const u8,
) []const u8 {
    const first_line = blk: {
        if (std.mem.indexOfScalar(
            u8,
            content,
            '\n',
        )) |nl| {
            break :blk content[0..nl];
        }
        break :blk content;
    };
    // invariant: first_line is at most content length
    assert(first_line.len <= content.len);
    if (std.mem.startsWith(u8, first_line, "# ")) {
        return first_line[2..];
    }
    return first_line;
}

// -- Navigation bounds
pub fn can_prev(index: u32) bool {
    return index > 0;
}

pub fn can_next(
    index: u32,
    lesson_count: u32,
) bool {
    // invariant: lesson_count is positive
    assert(lesson_count > 0);
    return index < lesson_count - 1;
}

// -- Display title: "Title  (N of M)"
// Writes into caller-provided buffer.
pub fn format_display_title(
    buf: []u8,
    title: []const u8,
    index: u32,
    total: u32,
) []const u8 {
    // invariant: index is within bounds
    assert(index < total);
    const result = std.fmt.bufPrint(
        buf,
        "{s}  ({d} of {d})",
        .{ title, index + 1, total },
    ) catch {
        return title;
    };
    return result;
}

// -- Galaxy path: "bloom/<directory>/<file>"
pub fn galaxy_file_path(
    buf: []u8,
    root: []const u8,
    directory: []const u8,
    file: []const u8,
) []const u8 {
    const result = std.fmt.bufPrint(
        buf,
        "{s}/bloom/{s}/{s}",
        .{ root, directory, file },
    ) catch {
        return "";
    };
    return result;
}

// -- FFI bridge: C-compatible exports for the platform shell.
// Each function uses callconv(.c) so Swift (or any C caller)
// can link against the compiled library. String returns are
// null-terminated pointers into static comptime data.

export fn bloom_galaxy_count() callconv(.c) u32 {
    return galaxy_count;
}

export fn bloom_total_files() callconv(.c) u32 {
    return total_files;
}

export fn bloom_separator_count() callconv(.c) u32 {
    return separator_count;
}

export fn bloom_total_lessons() callconv(.c) u32 {
    return total_lessons;
}

export fn bloom_galaxy_name(
    index: u32,
) callconv(.c) [*:0]const u8 {
    if (index >= galaxy_count) return "";
    return @ptrCast(galaxies[index].name.ptr);
}

export fn bloom_galaxy_directory(
    index: u32,
) callconv(.c) [*:0]const u8 {
    if (index >= galaxy_count) return "";
    return @ptrCast(
        galaxies[index].directory.ptr,
    );
}

export fn bloom_galaxy_file_count(
    index: u32,
) callconv(.c) u32 {
    if (index >= galaxy_count) return 0;
    return @intCast(galaxies[index].files.len);
}

export fn bloom_galaxy_file_name(
    galaxy_idx: u32,
    file_idx: u32,
) callconv(.c) [*:0]const u8 {
    if (galaxy_idx >= galaxy_count) return "";
    const g = galaxies[galaxy_idx];
    if (file_idx >= g.files.len) return "";
    return @ptrCast(g.files[file_idx].ptr);
}

export fn bloom_galaxy_separator_title(
    index: u32,
) callconv(.c) [*:0]const u8 {
    if (index >= galaxy_count) return "";
    const t = galaxies[index].separator_title;
    if (t.len == 0) return "";
    return @ptrCast(t.ptr);
}

export fn bloom_galaxy_separator_body(
    index: u32,
) callconv(.c) [*:0]const u8 {
    if (index >= galaxy_count) return "";
    const b = galaxies[index].separator_body;
    if (b.len == 0) return "";
    return @ptrCast(b.ptr);
}

export fn bloom_can_prev_ffi(
    index: u32,
) callconv(.c) bool {
    return can_prev(index);
}

export fn bloom_can_next_ffi(
    index: u32,
    count: u32,
) callconv(.c) bool {
    if (count == 0) return false;
    return can_next(index, count);
}

// -- Selftest: proves the data model matches the Swift
// original.
pub fn selftest() void {
    // 1. Galaxy count
    assert(galaxy_count == 7);
    assert(galaxies.len == 7);

    // 2. File counts per galaxy
    assert(galaxies[0].files.len == 10);
    assert(galaxies[1].files.len == 7);
    assert(galaxies[2].files.len == 6);
    assert(galaxies[3].files.len == 4);
    assert(galaxies[4].files.len == 4);
    assert(galaxies[5].files.len == 4);
    assert(galaxies[6].files.len == 9);

    // 3. Total files: 10+7+6+4+4+4+9 = 44
    assert(total_files == 44);

    // 4. Separators: one before each galaxy except first
    assert(separator_count == 6);

    // 5. Total lessons: 44 files + 6 separators = 50
    assert(total_lessons == 50);

    // 6. Galaxy names match Swift ordering
    assert(std.mem.eql(
        u8,
        galaxies[0].name,
        "Curriculum",
    ));
    assert(std.mem.eql(
        u8,
        galaxies[1].name,
        "Lineage Teachings",
    ));
    assert(std.mem.eql(
        u8,
        galaxies[2].name,
        "Ecology",
    ));
    assert(std.mem.eql(
        u8,
        galaxies[3].name,
        "Operational Guides",
    ));
    assert(std.mem.eql(
        u8,
        galaxies[4].name,
        "Essays",
    ));
    assert(std.mem.eql(
        u8,
        galaxies[5].name,
        "Terrarium Tutorials",
    ));
    assert(std.mem.eql(
        u8,
        galaxies[6].name,
        "Network Demos",
    ));

    // 7. First galaxy has no separator
    assert(galaxies[0].separator_title.len == 0);
    assert(galaxies[0].separator_body.len == 0);

    // 8. Subsequent galaxies have separators
    for (galaxies[1..]) |g| {
        assert(g.separator_title.len > 0);
        assert(g.separator_body.len > 0);
    }

    // 9. Title extraction
    const t1 = extract_title(
        "# Hello World\nBody text",
    );
    assert(std.mem.eql(u8, t1, "Hello World"));

    const t2 = extract_title("No heading\nBody");
    assert(std.mem.eql(u8, t2, "No heading"));

    const t3 = extract_title("# Single line");
    assert(std.mem.eql(u8, t3, "Single line"));

    const t4 = extract_title("");
    assert(t4.len == 0);

    // 10. Navigation bounds
    assert(!can_prev(0));
    assert(can_prev(1));
    assert(can_prev(49));
    assert(can_next(0, 50));
    assert(can_next(48, 50));
    assert(!can_next(49, 50));

    // 11. Display title format
    var buf: [512]u8 = undefined;
    const dt = format_display_title(
        &buf,
        "Hello",
        0,
        50,
    );
    assert(std.mem.eql(u8, dt, "Hello  (1 of 50)"));

    const dt2 = format_display_title(
        &buf,
        "Last",
        49,
        50,
    );
    assert(std.mem.eql(u8, dt2, "Last  (50 of 50)"));

    // 12. Separator titles match Swift format
    assert(std.mem.eql(
        u8,
        galaxies[1].separator_title,
        "--- Lineage Teachings ---",
    ));
    assert(std.mem.eql(
        u8,
        galaxies[6].separator_title,
        "--- Network Demos ---",
    ));

    // 13. Galaxy directories match filesystem
    assert(std.mem.eql(
        u8,
        galaxies[0].directory,
        "curriculum",
    ));
    assert(std.mem.eql(
        u8,
        galaxies[5].directory,
        "terrarium-lessons",
    ));
    assert(std.mem.eql(
        u8,
        galaxies[6].directory,
        "demos",
    ));

    // 14. Galaxy file path
    var pbuf: [512]u8 = undefined;
    const p = galaxy_file_path(
        &pbuf,
        "/repo",
        "curriculum",
        "stage-01-meeting-the-dragons.md",
    );
    assert(std.mem.eql(
        u8,
        p,
        "/repo/bloom/curriculum"
            ++ "/stage-01-meeting-the-dragons.md",
    ));

    // 15. First curriculum file matches Swift
    assert(std.mem.eql(
        u8,
        galaxies[0].files[0],
        "stage-01-meeting-the-dragons.md",
    ));
    assert(std.mem.eql(
        u8,
        galaxies[0].files[9],
        "stage-10-the-technical-vision.md",
    ));

    print("vantage-bloom selftest GREEN"
        ++ " -- 15 claims\n", .{});
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args
        .toSlice(garden);
    if (args.len >= 2 and std.mem.eql(
        u8,
        args[1],
        "selftest",
    )) {
        selftest();
        return 0;
    }
    print("usage: bloom selftest\n", .{});
    return 0;
}
