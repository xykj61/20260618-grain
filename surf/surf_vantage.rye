const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const c = std.c;
const rf = @import("relay_format.rye");

pub const bridge_version = "20261108.213500";

// --- Ed25519 identity at the std seam ---------------------------------------

const Ed25519 = std.crypto.sign.Ed25519;
const Sha3 = std.crypto.hash.sha3.Sha3_256;

const seed_len: u32 = 32;
const pubkey_len: u32 = 32;
const sig_len: u32 = 64;
const digest_len: u32 = 32;
const hex_len: u32 = 64;

const hex_chars = "0123456789abcdef";

fn hex_encode(bytes: []const u8, out: []u8) void {
    for (bytes, 0..) |b, i| {
        out[i * 2] = hex_chars[b >> 4];
        out[i * 2 + 1] = hex_chars[b & 0x0f];
    }
}

// --- event: the signed fact -------------------------------------------------

const max_content_len: u32 = 4096;
const max_events: u32 = 256;

const Event = struct {
    pubkey: [pubkey_len]u8,
    created_at: u64,
    kind: u32,
    content: [max_content_len]u8,
    content_len: u32,
    signature: [sig_len]u8,
    id: [hex_len]u8,
    used: bool,
};

// invariant: feed holds at most max_events.
var feed: [max_events]Event = undefined;
var feed_count: u32 = 0;
var initialized: bool = false;

// --- follow list: pubkeys this identity subscribes to ----------------------

const max_follows: u32 = 64;

// invariant: follows holds at most max_follows pubkeys.
var follows: [max_follows][pubkey_len]u8 = undefined;
var follow_count: u32 = 0;

// --- C exports: init --------------------------------------------------------

export fn surf_init() callconv(.c) void {
    feed_count = 0;
    var i: u32 = 0;
    while (i < max_events) : (i += 1) {
        feed[i].used = false;
    }
    follow_count = 0;
    initialized = true;
}

// --- C exports: keypair from seed -------------------------------------------

// invariant: seed is 32 bytes, pubkey_out receives 32 bytes, secret_out 64.
export fn surf_keypair_from_seed(
    seed_ptr: [*]const u8,
    pubkey_out: [*]u8,
    secret_out: [*]u8,
) callconv(.c) i32 {
    const seed: [seed_len]u8 = seed_ptr[0..seed_len].*;
    const kp = Ed25519.KeyPair.generateDeterministic(seed) catch
        return -1;
    @memcpy(pubkey_out[0..pubkey_len], &kp.public_key.bytes);
    @memcpy(secret_out[0..sig_len], &kp.secret_key.bytes);
    return 0;
}

// --- C exports: event id (content hash) -------------------------------------

// invariant: id is SHA3-256 of (pubkey ++ kind_be ++ created_at_be ++ content).
fn compute_event_id(
    pubkey: *const [pubkey_len]u8,
    kind: u32,
    created_at: u64,
    content: []const u8,
    id_out: *[hex_len]u8,
) void {
    var hasher = Sha3.init(.{});
    hasher.update(pubkey);
    const kind_be = std.mem.toBytes(std.mem.nativeTo(u32, kind, .big));
    hasher.update(&kind_be);
    const ts_be = std.mem.toBytes(std.mem.nativeTo(u64, created_at, .big));
    hasher.update(&ts_be);
    hasher.update(content);
    var raw: [digest_len]u8 = undefined;
    hasher.final(&raw);
    hex_encode(&raw, id_out);
}

export fn surf_event_id(
    pubkey_ptr: [*]const u8,
    kind: u32,
    created_at: u64,
    content_ptr: [*]const u8,
    content_len: u32,
    id_out: [*]u8,
) callconv(.c) void {
    const clen = if (content_len > max_content_len)
        max_content_len
    else
        content_len;
    var id: [hex_len]u8 = undefined;
    compute_event_id(
        pubkey_ptr[0..pubkey_len],
        kind,
        created_at,
        content_ptr[0..clen],
        &id,
    );
    @memcpy(id_out[0..hex_len], &id);
}

// --- C exports: sign event --------------------------------------------------

// invariant: signs the event id bytes with the secret key.
export fn surf_sign_event(
    id_ptr: [*]const u8,
    secret_ptr: [*]const u8,
    sig_out: [*]u8,
) callconv(.c) i32 {
    const secret_bytes: [sig_len]u8 = secret_ptr[0..sig_len].*;
    const secret = Ed25519.SecretKey.fromBytes(secret_bytes) catch return -1;
    const kp = Ed25519.KeyPair.fromSecretKey(secret) catch return -2;
    const sig = kp.sign(id_ptr[0..hex_len], null) catch return -3;
    @memcpy(sig_out[0..sig_len], &sig.toBytes());
    return 0;
}

// --- C exports: verify event ------------------------------------------------

export fn surf_verify_event(
    id_ptr: [*]const u8,
    sig_ptr: [*]const u8,
    pubkey_ptr: [*]const u8,
) callconv(.c) bool {
    const sig_bytes: [sig_len]u8 = sig_ptr[0..sig_len].*;
    const sig = Ed25519.Signature.fromBytes(sig_bytes);
    const pk_bytes: [pubkey_len]u8 = pubkey_ptr[0..pubkey_len].*;
    const pk = Ed25519.PublicKey.fromBytes(pk_bytes) catch return false;
    sig.verify(id_ptr[0..hex_len], pk) catch return false;
    return true;
}

// --- C exports: feed operations ---------------------------------------------

// invariant: adds a signed event to the feed. returns 0 ok, -1 full, -2 content too long.
export fn surf_feed_add(
    pubkey_ptr: [*]const u8,
    kind: u32,
    created_at: u64,
    content_ptr: [*]const u8,
    content_len: u32,
    sig_ptr: [*]const u8,
    id_ptr: [*]const u8,
) callconv(.c) i32 {
    if (content_len > max_content_len) return -2;
    if (feed_count >= max_events) return -1;

    var e = &feed[feed_count];
    @memcpy(&e.pubkey, pubkey_ptr[0..pubkey_len]);
    e.created_at = created_at;
    e.kind = kind;
    @memcpy(e.content[0..content_len], content_ptr[0..content_len]);
    e.content_len = content_len;
    @memcpy(&e.signature, sig_ptr[0..sig_len]);
    @memcpy(&e.id, id_ptr[0..hex_len]);
    e.used = true;
    feed_count += 1;
    return 0;
}

export fn surf_feed_count() callconv(.c) u32 {
    return feed_count;
}

// invariant: writes events as newline-separated records to buffer.
// format: "id pubkey_hex kind created_at content_len\n" per event.
export fn surf_feed_list(
    buf_ptr: [*]u8,
    buf_len: u32,
) callconv(.c) u32 {
    var pos: u32 = 0;
    var i: u32 = 0;
    while (i < feed_count) : (i += 1) {
        if (!feed[i].used) continue;
        var pk_hex: [pubkey_len * 2]u8 = undefined;
        hex_encode(&feed[i].pubkey, &pk_hex);
        // "id pk_hex kind created_at content_len\n"
        const needed = hex_len + 1 + pk_hex.len + 1 + 10 + 1 + 20 + 1 + 10 + 1;
        if (pos + needed > buf_len) return 0;
        @memcpy(buf_ptr[pos .. pos + hex_len], &feed[i].id);
        pos += hex_len;
        buf_ptr[pos] = ' ';
        pos += 1;
        @memcpy(buf_ptr[pos .. pos + pk_hex.len], &pk_hex);
        pos += @intCast(pk_hex.len);
        buf_ptr[pos] = ' ';
        pos += 1;
        const rest = std.fmt.bufPrint(
            buf_ptr[pos..buf_len],
            "{d} {d} {d}\n",
            .{ feed[i].kind, feed[i].created_at, feed[i].content_len },
        ) catch return 0;
        pos += @intCast(rest.len);
    }
    return pos;
}

// --- C exports: get event content -------------------------------------------

// invariant: copies content of event at index into buf. returns content_len or 0.
export fn surf_feed_get_content(
    index: u32,
    buf_ptr: [*]u8,
    buf_len: u32,
) callconv(.c) u32 {
    if (index >= feed_count) return 0;
    if (!feed[index].used) return 0;
    const clen = feed[index].content_len;
    if (clen > buf_len) return 0;
    @memcpy(buf_ptr[0..clen], feed[index].content[0..clen]);
    return clen;
}

// --- C exports: get event fields --------------------------------------------

// invariant: copies pubkey, kind, created_at, sig, id for event at index.
export fn surf_feed_get_event(
    index: u32,
    pubkey_out: [*]u8,
    kind_out: *u32,
    created_at_out: *u64,
    sig_out: [*]u8,
    id_out: [*]u8,
) callconv(.c) i32 {
    if (index >= feed_count) return -1;
    if (!feed[index].used) return -1;
    const e = &feed[index];
    @memcpy(pubkey_out[0..pubkey_len], &e.pubkey);
    kind_out.* = e.kind;
    created_at_out.* = e.created_at;
    @memcpy(sig_out[0..sig_len], &e.signature);
    @memcpy(id_out[0..hex_len], &e.id);
    return 0;
}

// --- C exports: feed serialization ------------------------------------------

// format: u32 count, then per event:
//   pubkey(32) kind(4,be) created_at(8,be) content_len(4,be)
//   content(content_len) sig(64) id(64)
const event_fixed: u32 = pubkey_len + 4 + 8 + 4 + sig_len + hex_len;

// invariant: serializes feed to buf. returns bytes written or 0 on overflow.
export fn surf_feed_serialize(
    buf_ptr: [*]u8,
    buf_len: u32,
) callconv(.c) u32 {
    if (buf_len < 4) return 0;
    const count_be = std.mem.toBytes(
        std.mem.nativeTo(u32, feed_count, .big),
    );
    @memcpy(buf_ptr[0..4], &count_be);
    var pos: u32 = 4;

    var i: u32 = 0;
    while (i < feed_count) : (i += 1) {
        if (!feed[i].used) continue;
        const e = &feed[i];
        const needed = event_fixed + e.content_len;
        if (pos + needed > buf_len) return 0;

        @memcpy(buf_ptr[pos .. pos + pubkey_len], &e.pubkey);
        pos += pubkey_len;
        const k_be = std.mem.toBytes(
            std.mem.nativeTo(u32, e.kind, .big),
        );
        @memcpy(buf_ptr[pos .. pos + 4], &k_be);
        pos += 4;
        const ts_be = std.mem.toBytes(
            std.mem.nativeTo(u64, e.created_at, .big),
        );
        @memcpy(buf_ptr[pos .. pos + 8], &ts_be);
        pos += 8;
        const cl_be = std.mem.toBytes(
            std.mem.nativeTo(u32, e.content_len, .big),
        );
        @memcpy(buf_ptr[pos .. pos + 4], &cl_be);
        pos += 4;
        @memcpy(
            buf_ptr[pos .. pos + e.content_len],
            e.content[0..e.content_len],
        );
        pos += e.content_len;
        @memcpy(buf_ptr[pos .. pos + sig_len], &e.signature);
        pos += sig_len;
        @memcpy(buf_ptr[pos .. pos + hex_len], &e.id);
        pos += hex_len;
    }
    return pos;
}

// invariant: deserializes feed from buf. returns 0 ok, -1 on parse error.
export fn surf_feed_deserialize(
    buf_ptr: [*]const u8,
    buf_len: u32,
) callconv(.c) i32 {
    if (buf_len < 4) return -1;
    const count_bytes: [4]u8 = buf_ptr[0..4].*;
    const count = std.mem.nativeTo(
        u32,
        std.mem.bytesAsValue(u32, &count_bytes).*,
        .big,
    );
    if (count > max_events) return -1;

    surf_init();
    var pos: u32 = 4;
    var i: u32 = 0;
    while (i < count) : (i += 1) {
        if (pos + pubkey_len + 4 + 8 + 4 > buf_len) return -1;
        var e = &feed[feed_count];
        @memcpy(&e.pubkey, buf_ptr[pos .. pos + pubkey_len]);
        pos += pubkey_len;
        var k_bytes: [4]u8 = undefined;
        @memcpy(&k_bytes, buf_ptr[pos .. pos + 4]);
        e.kind = std.mem.nativeTo(
            u32,
            std.mem.bytesAsValue(u32, &k_bytes).*,
            .big,
        );
        pos += 4;
        var ts_bytes: [8]u8 = undefined;
        @memcpy(&ts_bytes, buf_ptr[pos .. pos + 8]);
        e.created_at = std.mem.nativeTo(
            u64,
            std.mem.bytesAsValue(u64, &ts_bytes).*,
            .big,
        );
        pos += 8;
        var cl_bytes: [4]u8 = undefined;
        @memcpy(&cl_bytes, buf_ptr[pos .. pos + 4]);
        e.content_len = std.mem.nativeTo(
            u32,
            std.mem.bytesAsValue(u32, &cl_bytes).*,
            .big,
        );
        pos += 4;
        if (e.content_len > max_content_len) return -1;
        if (pos + e.content_len + sig_len + hex_len > buf_len)
            return -1;
        @memcpy(
            e.content[0..e.content_len],
            buf_ptr[pos .. pos + e.content_len],
        );
        pos += e.content_len;
        @memcpy(&e.signature, buf_ptr[pos .. pos + sig_len]);
        pos += sig_len;
        @memcpy(&e.id, buf_ptr[pos .. pos + hex_len]);
        pos += hex_len;
        e.used = true;
        feed_count += 1;
    }
    return 0;
}

// --- C exports: follow list ------------------------------------------------

// invariant: adds pubkey to follow list. returns 0 ok, -1 full, -2 already following.
export fn surf_follow(
    pubkey_ptr: [*]const u8,
) callconv(.c) i32 {
    const pk: [pubkey_len]u8 = pubkey_ptr[0..pubkey_len].*;
    var i: u32 = 0;
    while (i < follow_count) : (i += 1) {
        if (std.mem.eql(u8, &follows[i], &pk)) return -2;
    }
    if (follow_count >= max_follows) return -1;
    follows[follow_count] = pk;
    follow_count += 1;
    return 0;
}

// invariant: removes pubkey from follow list. returns 0 ok, -1 not found.
export fn surf_unfollow(
    pubkey_ptr: [*]const u8,
) callconv(.c) i32 {
    const pk: [pubkey_len]u8 = pubkey_ptr[0..pubkey_len].*;
    var i: u32 = 0;
    while (i < follow_count) : (i += 1) {
        if (std.mem.eql(u8, &follows[i], &pk)) {
            var j: u32 = i;
            while (j + 1 < follow_count) : (j += 1) {
                follows[j] = follows[j + 1];
            }
            follow_count -= 1;
            return 0;
        }
    }
    return -1;
}

export fn surf_follow_count() callconv(.c) u32 {
    return follow_count;
}

export fn surf_follow_is_following(
    pubkey_ptr: [*]const u8,
) callconv(.c) bool {
    const pk: [pubkey_len]u8 = pubkey_ptr[0..pubkey_len].*;
    var i: u32 = 0;
    while (i < follow_count) : (i += 1) {
        if (std.mem.eql(u8, &follows[i], &pk)) return true;
    }
    return false;
}

// --- C exports: filtered feed (by follow list) -----------------------------

fn is_followed(pubkey: *const [pubkey_len]u8) bool {
    var i: u32 = 0;
    while (i < follow_count) : (i += 1) {
        if (std.mem.eql(u8, &follows[i], pubkey)) return true;
    }
    return false;
}

// invariant: counts feed events whose author is in the follow list.
export fn surf_feed_count_followed() callconv(.c) u32 {
    var count: u32 = 0;
    var i: u32 = 0;
    while (i < feed_count) : (i += 1) {
        if (!feed[i].used) continue;
        if (is_followed(&feed[i].pubkey)) count += 1;
    }
    return count;
}

// invariant: copies content of the nth followed event into buf.
// returns content_len or 0 on out-of-range / overflow.
export fn surf_feed_get_content_followed(
    index: u32,
    buf_ptr: [*]u8,
    buf_len: u32,
) callconv(.c) u32 {
    var seen: u32 = 0;
    var i: u32 = 0;
    while (i < feed_count) : (i += 1) {
        if (!feed[i].used) continue;
        if (!is_followed(&feed[i].pubkey)) continue;
        if (seen == index) {
            const clen = feed[i].content_len;
            if (clen > buf_len) return 0;
            @memcpy(buf_ptr[0..clen], feed[i].content[0..clen]);
            return clen;
        }
        seen += 1;
    }
    return 0;
}

// invariant: returns the feed-global index of the nth followed event,
// or max_events (sentinel) if out of range.
export fn surf_feed_followed_global_index(
    followed_index: u32,
) callconv(.c) u32 {
    var seen: u32 = 0;
    var i: u32 = 0;
    while (i < feed_count) : (i += 1) {
        if (!feed[i].used) continue;
        if (!is_followed(&feed[i].pubkey)) continue;
        if (seen == followed_index) return i;
        seen += 1;
    }
    return max_events;
}

// --- C exports: follow list serialization ----------------------------------

// format: u32 count, then count * pubkey_len bytes.
export fn surf_follow_serialize(
    buf_ptr: [*]u8,
    buf_len: u32,
) callconv(.c) u32 {
    const needed = 4 + follow_count * pubkey_len;
    if (needed > buf_len) return 0;
    const count_be = std.mem.toBytes(
        std.mem.nativeTo(u32, follow_count, .big),
    );
    @memcpy(buf_ptr[0..4], &count_be);
    var pos: u32 = 4;
    var i: u32 = 0;
    while (i < follow_count) : (i += 1) {
        @memcpy(buf_ptr[pos .. pos + pubkey_len], &follows[i]);
        pos += pubkey_len;
    }
    return pos;
}

// invariant: deserializes follow list from buf. returns 0 ok, -1 on error.
export fn surf_follow_deserialize(
    buf_ptr: [*]const u8,
    buf_len: u32,
) callconv(.c) i32 {
    if (buf_len < 4) return -1;
    const count_bytes: [4]u8 = buf_ptr[0..4].*;
    const count = std.mem.nativeTo(
        u32,
        std.mem.bytesAsValue(u32, &count_bytes).*,
        .big,
    );
    if (count > max_follows) return -1;
    if (4 + count * pubkey_len > buf_len) return -1;
    follow_count = 0;
    var pos: u32 = 4;
    var i: u32 = 0;
    while (i < count) : (i += 1) {
        @memcpy(&follows[follow_count], buf_ptr[pos .. pos + pubkey_len]);
        follow_count += 1;
        pos += pubkey_len;
    }
    return 0;
}

// --- selftest ---------------------------------------------------------------

fn prove_keypair_deterministic() !void {
    var seed: [seed_len]u8 = undefined;
    for (&seed, 0..) |*b, i| b.* = @intCast(i);
    var pk1: [pubkey_len]u8 = undefined;
    var sk1: [sig_len]u8 = undefined;
    var pk2: [pubkey_len]u8 = undefined;
    var sk2: [sig_len]u8 = undefined;
    if (surf_keypair_from_seed(&seed, &pk1, &sk1) != 0)
        return error.KeypairFailed;
    if (surf_keypair_from_seed(&seed, &pk2, &sk2) != 0)
        return error.KeypairFailed;
    if (!std.mem.eql(u8, &pk1, &pk2))
        return error.PubkeyNotDeterministic;
    if (!std.mem.eql(u8, &sk1, &sk2))
        return error.SecretNotDeterministic;
}

fn prove_sign_and_verify() !void {
    var seed: [seed_len]u8 = undefined;
    for (&seed, 0..) |*b, i| b.* = @intCast(i);
    var pk: [pubkey_len]u8 = undefined;
    var sk: [sig_len]u8 = undefined;
    _ = surf_keypair_from_seed(&seed, &pk, &sk);

    const content = "hello surf";
    const kind: u32 = 1;
    const ts: u64 = 1700000000;
    var id: [hex_len]u8 = undefined;
    surf_event_id(&pk, kind, ts, content.ptr, content.len, &id);

    var sig: [sig_len]u8 = undefined;
    if (surf_sign_event(&id, &sk, &sig) != 0)
        return error.SignFailed;
    if (!surf_verify_event(&id, &sig, &pk))
        return error.VerifyRejectedValid;
}

fn prove_verify_rejects_tamper() !void {
    var seed: [seed_len]u8 = undefined;
    for (&seed, 0..) |*b, i| b.* = @intCast(i);
    var pk: [pubkey_len]u8 = undefined;
    var sk: [sig_len]u8 = undefined;
    _ = surf_keypair_from_seed(&seed, &pk, &sk);

    const content = "authentic post";
    var id: [hex_len]u8 = undefined;
    surf_event_id(&pk, 1, 1700000000, content.ptr, content.len, &id);

    var sig: [sig_len]u8 = undefined;
    _ = surf_sign_event(&id, &sk, &sig);

    // tamper with one id byte
    var bad_id = id;
    bad_id[0] ^= 0xff;
    if (surf_verify_event(&bad_id, &sig, &pk))
        return error.VerifyAcceptedTampered;
}

fn prove_event_id_deterministic() !void {
    var seed: [seed_len]u8 = undefined;
    for (&seed, 0..) |*b, i| b.* = @intCast(i);
    var pk: [pubkey_len]u8 = undefined;
    var sk: [sig_len]u8 = undefined;
    _ = surf_keypair_from_seed(&seed, &pk, &sk);

    const content = "same content";
    var id1: [hex_len]u8 = undefined;
    var id2: [hex_len]u8 = undefined;
    surf_event_id(&pk, 1, 1700000000, content.ptr, content.len, &id1);
    surf_event_id(&pk, 1, 1700000000, content.ptr, content.len, &id2);
    if (!std.mem.eql(u8, &id1, &id2))
        return error.EventIdNotDeterministic;
}

fn prove_feed_add_and_count() !void {
    surf_init();
    var seed: [seed_len]u8 = undefined;
    for (&seed, 0..) |*b, i| b.* = @intCast(i);
    var pk: [pubkey_len]u8 = undefined;
    var sk: [sig_len]u8 = undefined;
    _ = surf_keypair_from_seed(&seed, &pk, &sk);

    const content = "first post";
    var id: [hex_len]u8 = undefined;
    surf_event_id(&pk, 1, 1700000000, content.ptr, content.len, &id);
    var sig: [sig_len]u8 = undefined;
    _ = surf_sign_event(&id, &sk, &sig);

    const rc = surf_feed_add(&pk, 1, 1700000000, content.ptr, content.len, &sig, &id);
    if (rc != 0) return error.FeedAddFailed;
    if (surf_feed_count() != 1) return error.FeedCountNotOne;
}

fn prove_feed_list() !void {
    surf_init();
    var seed: [seed_len]u8 = undefined;
    for (&seed, 0..) |*b, i| b.* = @intCast(i);
    var pk: [pubkey_len]u8 = undefined;
    var sk: [sig_len]u8 = undefined;
    _ = surf_keypair_from_seed(&seed, &pk, &sk);

    const c1 = "post one";
    const c2 = "post two";
    var id1: [hex_len]u8 = undefined;
    var id2: [hex_len]u8 = undefined;
    surf_event_id(&pk, 1, 1700000001, c1.ptr, c1.len, &id1);
    surf_event_id(&pk, 1, 1700000002, c2.ptr, c2.len, &id2);
    var sig1: [sig_len]u8 = undefined;
    var sig2: [sig_len]u8 = undefined;
    _ = surf_sign_event(&id1, &sk, &sig1);
    _ = surf_sign_event(&id2, &sk, &sig2);
    _ = surf_feed_add(&pk, 1, 1700000001, c1.ptr, c1.len, &sig1, &id1);
    _ = surf_feed_add(&pk, 1, 1700000002, c2.ptr, c2.len, &sig2, &id2);

    if (surf_feed_count() != 2) return error.FeedCountNotTwo;
    var buf: [8192]u8 = undefined;
    const len = surf_feed_list(&buf, 8192);
    if (len == 0) return error.ListEmpty;
}

fn prove_feed_get_content() !void {
    surf_init();
    var seed: [seed_len]u8 = undefined;
    for (&seed, 0..) |*b, i| b.* = @intCast(i);
    var pk: [pubkey_len]u8 = undefined;
    var sk: [sig_len]u8 = undefined;
    _ = surf_keypair_from_seed(&seed, &pk, &sk);

    const content = "readable content";
    var id: [hex_len]u8 = undefined;
    surf_event_id(&pk, 1, 1700000000, content.ptr, content.len, &id);
    var sig: [sig_len]u8 = undefined;
    _ = surf_sign_event(&id, &sk, &sig);
    _ = surf_feed_add(&pk, 1, 1700000000, content.ptr, content.len, &sig, &id);

    var buf: [max_content_len]u8 = undefined;
    const got = surf_feed_get_content(0, &buf, max_content_len);
    if (got != content.len) return error.ContentLenMismatch;
    if (!std.mem.eql(u8, buf[0..got], content))
        return error.ContentMismatch;
}

fn prove_serialize_roundtrip() !void {
    surf_init();
    var seed: [seed_len]u8 = undefined;
    for (&seed, 0..) |*b, i| b.* = @intCast(i);
    var pk: [pubkey_len]u8 = undefined;
    var sk: [sig_len]u8 = undefined;
    _ = surf_keypair_from_seed(&seed, &pk, &sk);

    const c1 = "round trip one";
    const c2 = "round trip two";
    var id1: [hex_len]u8 = undefined;
    var id2: [hex_len]u8 = undefined;
    surf_event_id(&pk, 1, 1700000001, c1.ptr, c1.len, &id1);
    surf_event_id(&pk, 1, 1700000002, c2.ptr, c2.len, &id2);
    var sig1: [sig_len]u8 = undefined;
    var sig2: [sig_len]u8 = undefined;
    _ = surf_sign_event(&id1, &sk, &sig1);
    _ = surf_sign_event(&id2, &sk, &sig2);
    _ = surf_feed_add(&pk, 1, 1700000001, c1.ptr, c1.len, &sig1, &id1);
    _ = surf_feed_add(&pk, 1, 1700000002, c2.ptr, c2.len, &sig2, &id2);

    // invariant: serialize captures both events.
    var buf: [65536]u8 = undefined;
    const written = surf_feed_serialize(&buf, 65536);
    if (written == 0) return error.SerializeFailed;

    // invariant: deserialize restores both events intact.
    if (surf_feed_deserialize(&buf, written) != 0)
        return error.DeserializeFailed;
    if (surf_feed_count() != 2) return error.RoundtripCountNotTwo;

    var content_buf: [max_content_len]u8 = undefined;
    const got = surf_feed_get_content(0, &content_buf, max_content_len);
    if (got != c1.len) return error.RoundtripContent0Len;
    if (!std.mem.eql(u8, content_buf[0..got], c1))
        return error.RoundtripContent0Mismatch;
    const got2 = surf_feed_get_content(1, &content_buf, max_content_len);
    if (got2 != c2.len) return error.RoundtripContent1Len;
    if (!std.mem.eql(u8, content_buf[0..got2], c2))
        return error.RoundtripContent1Mismatch;
}

fn prove_get_event() !void {
    surf_init();
    var seed: [seed_len]u8 = undefined;
    for (&seed, 0..) |*b, i| b.* = @intCast(i);
    var pk: [pubkey_len]u8 = undefined;
    var sk: [sig_len]u8 = undefined;
    _ = surf_keypair_from_seed(&seed, &pk, &sk);

    const content = "get event test";
    const kind: u32 = 1;
    const ts: u64 = 1700000042;
    var id: [hex_len]u8 = undefined;
    surf_event_id(&pk, kind, ts, content.ptr, content.len, &id);
    var sig: [sig_len]u8 = undefined;
    _ = surf_sign_event(&id, &sk, &sig);
    _ = surf_feed_add(&pk, kind, ts, content.ptr, content.len, &sig, &id);

    // invariant: get_event returns all fields intact.
    var pk_out: [pubkey_len]u8 = undefined;
    var kind_out: u32 = 0;
    var ts_out: u64 = 0;
    var sig_out: [sig_len]u8 = undefined;
    var id_out: [hex_len]u8 = undefined;
    if (surf_feed_get_event(0, &pk_out, &kind_out, &ts_out, &sig_out, &id_out) != 0)
        return error.GetEventFailed;
    if (!std.mem.eql(u8, &pk_out, &pk))
        return error.GetEventPubkeyMismatch;
    if (kind_out != kind) return error.GetEventKindMismatch;
    if (ts_out != ts) return error.GetEventTimestampMismatch;
    if (!std.mem.eql(u8, &sig_out, &sig))
        return error.GetEventSigMismatch;
    if (!std.mem.eql(u8, &id_out, &id))
        return error.GetEventIdMismatch;
}

fn prove_follow_and_unfollow() !void {
    surf_init();
    var seed: [seed_len]u8 = undefined;
    for (&seed, 0..) |*b, i| b.* = @intCast(i);
    var pk: [pubkey_len]u8 = undefined;
    var sk: [sig_len]u8 = undefined;
    _ = surf_keypair_from_seed(&seed, &pk, &sk);

    // invariant: follow adds pubkey, is_following confirms.
    if (surf_follow(&pk) != 0) return error.FollowFailed;
    if (surf_follow_count() != 1) return error.FollowCountNotOne;
    if (!surf_follow_is_following(&pk))
        return error.NotFollowingAfterFollow;

    // invariant: duplicate follow returns -2.
    if (surf_follow(&pk) != -2)
        return error.DuplicateFollowAccepted;

    // invariant: unfollow removes, count drops.
    if (surf_unfollow(&pk) != 0) return error.UnfollowFailed;
    if (surf_follow_count() != 0)
        return error.FollowCountNotZeroAfterUnfollow;
    if (surf_follow_is_following(&pk))
        return error.StillFollowingAfterUnfollow;
}

fn prove_feed_filter_by_follow() !void {
    surf_init();

    // two identities: alice and bob.
    var seed_a: [seed_len]u8 = undefined;
    for (&seed_a, 0..) |*b, i| b.* = @intCast(i);
    var pk_a: [pubkey_len]u8 = undefined;
    var sk_a: [sig_len]u8 = undefined;
    _ = surf_keypair_from_seed(&seed_a, &pk_a, &sk_a);

    var seed_b: [seed_len]u8 = undefined;
    for (&seed_b, 0..) |*b, i| b.* = @intCast(i + 100);
    var pk_b: [pubkey_len]u8 = undefined;
    var sk_b: [sig_len]u8 = undefined;
    _ = surf_keypair_from_seed(&seed_b, &pk_b, &sk_b);

    // add one event from alice, one from bob.
    const ca = "alice says hello";
    var id_a: [hex_len]u8 = undefined;
    surf_event_id(&pk_a, 1, 1700000001, ca.ptr, ca.len, &id_a);
    var sig_a: [sig_len]u8 = undefined;
    _ = surf_sign_event(&id_a, &sk_a, &sig_a);
    _ = surf_feed_add(
        &pk_a, 1, 1700000001, ca.ptr, ca.len, &sig_a, &id_a,
    );

    const cb = "bob says hi";
    var id_b: [hex_len]u8 = undefined;
    surf_event_id(&pk_b, 1, 1700000002, cb.ptr, cb.len, &id_b);
    var sig_b: [sig_len]u8 = undefined;
    _ = surf_sign_event(&id_b, &sk_b, &sig_b);
    _ = surf_feed_add(
        &pk_b, 1, 1700000002, cb.ptr, cb.len, &sig_b, &id_b,
    );

    // invariant: with no follows, count_followed is 0.
    if (surf_feed_count_followed() != 0)
        return error.FollowedCountNotZeroEmpty;

    // follow alice only.
    _ = surf_follow(&pk_a);

    // invariant: count_followed is 1 (alice).
    if (surf_feed_count_followed() != 1)
        return error.FollowedCountNotOne;

    // invariant: get_content_followed(0) returns alice's content.
    var buf: [max_content_len]u8 = undefined;
    const got = surf_feed_get_content_followed(0, &buf, max_content_len);
    if (got != ca.len) return error.FollowedContentLenMismatch;
    if (!std.mem.eql(u8, buf[0..got], ca))
        return error.FollowedContentMismatch;

    // invariant: global index maps correctly.
    const gi = surf_feed_followed_global_index(0);
    if (gi != 0) return error.FollowedGlobalIndexWrong;
}

fn prove_follow_serialize_roundtrip() !void {
    surf_init();
    var seed_a: [seed_len]u8 = undefined;
    for (&seed_a, 0..) |*b, i| b.* = @intCast(i);
    var pk_a: [pubkey_len]u8 = undefined;
    var sk_a: [sig_len]u8 = undefined;
    _ = surf_keypair_from_seed(&seed_a, &pk_a, &sk_a);

    var seed_b: [seed_len]u8 = undefined;
    for (&seed_b, 0..) |*b, i| b.* = @intCast(i + 50);
    var pk_b: [pubkey_len]u8 = undefined;
    var sk_b: [sig_len]u8 = undefined;
    _ = surf_keypair_from_seed(&seed_b, &pk_b, &sk_b);

    _ = surf_follow(&pk_a);
    _ = surf_follow(&pk_b);

    // invariant: serialize captures both follows.
    var buf: [4096]u8 = undefined;
    const written = surf_follow_serialize(&buf, 4096);
    if (written == 0) return error.FollowSerializeFailed;

    // invariant: deserialize restores both follows intact.
    surf_init();
    if (surf_follow_deserialize(&buf, written) != 0)
        return error.FollowDeserializeFailed;
    if (surf_follow_count() != 2)
        return error.FollowRoundtripCountNotTwo;
    if (!surf_follow_is_following(&pk_a))
        return error.FollowRoundtripMissingA;
    if (!surf_follow_is_following(&pk_b))
        return error.FollowRoundtripMissingB;
}

// --- C exports: relay client -----------------------------------------------

const AF_INET: c_uint = 2;
const SOCK_DGRAM: c_uint = 2;
const sockaddr_in = c.sockaddr.in;

fn make_addr(addr_bytes: [4]u8, port: u16) sockaddr_in {
    return .{
        .port = std.mem.nativeToBig(u16, port),
        .addr = @bitCast(addr_bytes),
    };
}

// invariant: opens a UDP socket with a 2-second receive timeout.
// returns fd on success, -1 on failure.
fn open_client_socket() c.fd_t {
    const fd = c.socket(AF_INET, SOCK_DGRAM, 0);
    if (fd < 0) return -1;
    var tv = c.timeval{
        .sec = 2,
        .usec = 0,
    };
    _ = c.setsockopt(
        fd,
        c.SOL.SOCKET,
        c.SO.RCVTIMEO,
        &tv,
        @sizeOf(c.timeval),
    );
    return fd;
}

// invariant: publishes one signed event to a relay server.
// returns ack status (0=ok, 1=full, 2=invalid) or negative on
// network/protocol error.
export fn surf_relay_publish(
    pubkey_ptr: [*]const u8,
    kind: u32,
    created_at: u64,
    content_ptr: [*]const u8,
    content_len: u32,
    sig_ptr: [*]const u8,
    id_ptr: [*]const u8,
    addr_ptr: [*]const u8,
    port: u16,
) callconv(.c) i32 {
    if (content_len > rf.max_content_len) return -1;

    const pk: *const [rf.pubkey_len]u8 = pubkey_ptr[0..rf.pubkey_len];
    const sig: *const [rf.sig_len]u8 = sig_ptr[0..rf.sig_len];
    const id: *const [rf.hex_len]u8 = id_ptr[0..rf.hex_len];

    var send_buf: [rf.max_relay_frame]u8 = undefined;
    const frame_len = rf.encode_publish(
        pk,
        kind,
        created_at,
        content_ptr,
        content_len,
        sig,
        id,
        &send_buf,
        rf.max_relay_frame,
    ) catch return -2;

    var addr_bytes: [4]u8 = undefined;
    @memcpy(&addr_bytes, addr_ptr[0..4]);
    const dest = make_addr(addr_bytes, port);

    const fd = open_client_socket();
    if (fd < 0) return -3;
    defer _ = c.close(fd);

    const sent: isize = c.sendto(
        fd,
        &send_buf,
        frame_len,
        0,
        @ptrCast(&dest),
        @sizeOf(sockaddr_in),
    );
    if (sent < 0) return -4;

    var recv_buf: [rf.max_relay_frame]u8 = undefined;
    var from: sockaddr_in = undefined;
    var from_len: c.socklen_t = @sizeOf(sockaddr_in);
    const got: isize = c.recvfrom(
        fd,
        &recv_buf,
        rf.max_relay_frame,
        0,
        @ptrCast(&from),
        &from_len,
    );
    if (got < 0) return -5;

    var status: u8 = 0;
    rf.decode_ack(
        &recv_buf,
        @intCast(got),
        &status,
    ) catch return -6;

    return @intCast(status);
}

// invariant: fetches events for a pubkey from a relay server.
// adds each received event to the local feed. returns number of
// events added, or negative on error.
export fn surf_relay_fetch(
    pubkey_ptr: [*]const u8,
    since: u64,
    limit: u32,
    addr_ptr: [*]const u8,
    port: u16,
) callconv(.c) i32 {
    const pk: *const [rf.pubkey_len]u8 = pubkey_ptr[0..rf.pubkey_len];

    var send_buf: [rf.max_relay_frame]u8 = undefined;
    const frame_len = rf.encode_request(
        pk,
        since,
        limit,
        &send_buf,
        rf.max_relay_frame,
    ) catch return -2;

    var addr_bytes: [4]u8 = undefined;
    @memcpy(&addr_bytes, addr_ptr[0..4]);
    const dest = make_addr(addr_bytes, port);

    const fd = open_client_socket();
    if (fd < 0) return -3;
    defer _ = c.close(fd);

    const sent: isize = c.sendto(
        fd,
        &send_buf,
        frame_len,
        0,
        @ptrCast(&dest),
        @sizeOf(sockaddr_in),
    );
    if (sent < 0) return -4;

    var recv_buf: [rf.max_relay_frame]u8 = undefined;
    var from: sockaddr_in = undefined;
    var from_len: c.socklen_t = @sizeOf(sockaddr_in);
    const got: isize = c.recvfrom(
        fd,
        &recv_buf,
        rf.max_relay_frame,
        0,
        @ptrCast(&from),
        &from_len,
    );
    if (got < 0) return -5;

    var events: [rf.max_events_per_frame]rf.EventWire = undefined;
    var count: u32 = 0;
    rf.decode_events(
        &recv_buf,
        @intCast(got),
        &events,
        &count,
    ) catch return -6;

    var added: u32 = 0;
    var i: u32 = 0;
    while (i < count) : (i += 1) {
        const ev = &events[i];
        const rc = surf_feed_add(
            &ev.pubkey,
            ev.kind,
            ev.created_at,
            @as([*]const u8, &ev.content),
            ev.content_len,
            &ev.sig,
            &ev.id,
        );
        if (rc == 0) added += 1;
    }
    return @intCast(added);
}

// --- selftest: relay client encode/decode roundtrip --------

fn prove_relay_publish_encode() !void {
    // invariant: encode_publish produces a valid frame that
    // decode_publish reads back with matching fields.
    var seed: [seed_len]u8 = undefined;
    for (&seed, 0..) |*b, i| b.* = @intCast(i);
    var pk: [pubkey_len]u8 = undefined;
    var sk: [sig_len]u8 = undefined;
    _ = surf_keypair_from_seed(&seed, &pk, &sk);

    const content = "relay encode test";
    const kind: u32 = 1;
    const ts: u64 = 1700000099;
    var id: [hex_len]u8 = undefined;
    surf_event_id(&pk, kind, ts, content.ptr, content.len, &id);
    var sig: [sig_len]u8 = undefined;
    _ = surf_sign_event(&id, &sk, &sig);

    var buf: [rf.max_relay_frame]u8 = undefined;
    const frame_len = rf.encode_publish(
        &pk, kind, ts, content.ptr, content.len, &sig, &id,
        &buf, rf.max_relay_frame,
    ) catch return error.EncodePublishFailed;

    var pk_out: [rf.pubkey_len]u8 = undefined;
    var kind_out: u32 = 0;
    var ts_out: u64 = 0;
    var content_out: [rf.max_content_len]u8 = undefined;
    var clen_out: u32 = 0;
    var sig_out: [rf.sig_len]u8 = undefined;
    var id_out: [rf.hex_len]u8 = undefined;
    rf.decode_publish(
        &buf, frame_len,
        &pk_out, &kind_out, &ts_out,
        &content_out, &clen_out,
        &sig_out, &id_out,
    ) catch return error.DecodePublishFailed;

    if (!std.mem.eql(u8, &pk_out, &pk))
        return error.PublishPubkeyMismatch;
    if (kind_out != kind) return error.PublishKindMismatch;
    if (ts_out != ts) return error.PublishTimestampMismatch;
    if (clen_out != content.len)
        return error.PublishContentLenMismatch;
    if (!std.mem.eql(u8, content_out[0..clen_out], content))
        return error.PublishContentMismatch;
    if (!std.mem.eql(u8, &sig_out, &sig))
        return error.PublishSigMismatch;
    if (!std.mem.eql(u8, &id_out, &id))
        return error.PublishIdMismatch;
}

fn prove_relay_request_encode() !void {
    // invariant: encode_request roundtrips through decode_request.
    var pk: [rf.pubkey_len]u8 = undefined;
    for (&pk, 0..) |*b, i| b.* = @intCast(i);

    const since: u64 = 1700000001;
    const limit: u32 = 10;

    var buf: [rf.max_relay_frame]u8 = undefined;
    const frame_len = rf.encode_request(
        &pk, since, limit, &buf, rf.max_relay_frame,
    ) catch return error.EncodeRequestFailed;

    var pk_out: [rf.pubkey_len]u8 = undefined;
    var since_out: u64 = 0;
    var limit_out: u32 = 0;
    rf.decode_request(
        &buf, frame_len,
        &pk_out, &since_out, &limit_out,
    ) catch return error.DecodeRequestFailed;

    if (!std.mem.eql(u8, &pk_out, &pk))
        return error.RequestPubkeyMismatch;
    if (since_out != since)
        return error.RequestSinceMismatch;
    if (limit_out != limit)
        return error.RequestLimitMismatch;
}

fn prove_relay_events_encode() !void {
    // invariant: encode_events roundtrips through decode_events.
    var ev: rf.EventWire = undefined;
    for (&ev.pubkey, 0..) |*b, i| b.* = @intCast(i);
    ev.kind = 1;
    ev.created_at = 1700000050;
    const body = "events roundtrip";
    @memcpy(ev.content[0..body.len], body);
    ev.content_len = body.len;
    @memset(&ev.sig, 0xaa);
    @memset(&ev.id, 0x30);

    const events_in = [_]rf.EventWire{ev};
    var buf: [rf.max_relay_frame]u8 = undefined;
    const frame_len = rf.encode_events(
        &events_in, &buf, rf.max_relay_frame,
    ) catch return error.EncodeEventsFailed;

    var events_out: [rf.max_events_per_frame]rf.EventWire = undefined;
    var count: u32 = 0;
    rf.decode_events(
        &buf, frame_len, &events_out, &count,
    ) catch return error.DecodeEventsFailed;

    if (count != 1) return error.EventsCountMismatch;
    if (!std.mem.eql(u8, &events_out[0].pubkey, &ev.pubkey))
        return error.EventsPubkeyMismatch;
    if (events_out[0].kind != ev.kind)
        return error.EventsKindMismatch;
    if (events_out[0].created_at != ev.created_at)
        return error.EventsTimestampMismatch;
    if (events_out[0].content_len != ev.content_len)
        return error.EventsContentLenMismatch;
    const clen = events_out[0].content_len;
    if (!std.mem.eql(u8, events_out[0].content[0..clen], body))
        return error.EventsContentMismatch;
}

fn prove_relay_ack_encode() !void {
    // invariant: encode_ack roundtrips through decode_ack.
    var buf: [rf.max_relay_frame]u8 = undefined;
    const frame_len = rf.encode_ack(
        rf.ack_ok, &buf, rf.max_relay_frame,
    ) catch return error.EncodeAckFailed;

    var status: u8 = 0xff;
    rf.decode_ack(
        &buf, frame_len, &status,
    ) catch return error.DecodeAckFailed;

    if (status != rf.ack_ok) return error.AckStatusMismatch;

    // invariant: ack_full roundtrips too.
    _ = rf.encode_ack(
        rf.ack_full, &buf, rf.max_relay_frame,
    ) catch return error.EncodeAckFullFailed;
    rf.decode_ack(
        &buf, 2, &status,
    ) catch return error.DecodeAckFullFailed;
    if (status != rf.ack_full)
        return error.AckFullStatusMismatch;
}

fn prove_init_clears_feed() !void {
    surf_init();
    if (surf_feed_count() != 0) return error.InitCountNotZero;
    if (surf_follow_count() != 0) return error.InitFollowNotZero;
    if (!initialized) return error.NotInitialized;
}

fn run_selftest() u8 {
    prove_init_clears_feed() catch |e| {
        print("FAILED: {s}\n", .{@errorName(e)});
        return 1;
    };
    prove_keypair_deterministic() catch |e| {
        print("FAILED: {s}\n", .{@errorName(e)});
        return 1;
    };
    prove_event_id_deterministic() catch |e| {
        print("FAILED: {s}\n", .{@errorName(e)});
        return 1;
    };
    prove_sign_and_verify() catch |e| {
        print("FAILED: {s}\n", .{@errorName(e)});
        return 1;
    };
    prove_verify_rejects_tamper() catch |e| {
        print("FAILED: {s}\n", .{@errorName(e)});
        return 1;
    };
    prove_feed_add_and_count() catch |e| {
        print("FAILED: {s}\n", .{@errorName(e)});
        return 1;
    };
    prove_feed_list() catch |e| {
        print("FAILED: {s}\n", .{@errorName(e)});
        return 1;
    };
    prove_feed_get_content() catch |e| {
        print("FAILED: {s}\n", .{@errorName(e)});
        return 1;
    };
    prove_serialize_roundtrip() catch |e| {
        print("FAILED: {s}\n", .{@errorName(e)});
        return 1;
    };
    prove_get_event() catch |e| {
        print("FAILED: {s}\n", .{@errorName(e)});
        return 1;
    };
    prove_follow_and_unfollow() catch |e| {
        print("FAILED: {s}\n", .{@errorName(e)});
        return 1;
    };
    prove_feed_filter_by_follow() catch |e| {
        print("FAILED: {s}\n", .{@errorName(e)});
        return 1;
    };
    prove_follow_serialize_roundtrip() catch |e| {
        print("FAILED: {s}\n", .{@errorName(e)});
        return 1;
    };
    prove_relay_publish_encode() catch |e| {
        print("FAILED: {s}\n", .{@errorName(e)});
        return 1;
    };
    prove_relay_request_encode() catch |e| {
        print("FAILED: {s}\n", .{@errorName(e)});
        return 1;
    };
    prove_relay_events_encode() catch |e| {
        print("FAILED: {s}\n", .{@errorName(e)});
        return 1;
    };
    prove_relay_ack_encode() catch |e| {
        print("FAILED: {s}\n", .{@errorName(e)});
        return 1;
    };

    print("surf vantage: init clears -- feed and follows start at zero.\n", .{});
    print("surf vantage: keypair deterministic -- same seed, same Ed25519 keys.\n", .{});
    print("surf vantage: event id deterministic -- same inputs, same SHA3-256 id.\n", .{});
    print("surf vantage: sign and verify -- valid signature accepted.\n", .{});
    print("surf vantage: verify rejects tamper -- altered id refused.\n", .{});
    print("surf vantage: feed add and count -- event stored, count incremented.\n", .{});
    print("surf vantage: feed list -- two events, both present in output.\n", .{});
    print("surf vantage: feed get content -- stored content retrieved correctly.\n", .{});
    print("surf vantage: serialize roundtrip -- feed survives serialize and deserialize.\n", .{});
    print("surf vantage: get event -- all fields returned intact.\n", .{});
    print("surf vantage: follow and unfollow -- add, duplicate refused, remove.\n", .{});
    print("surf vantage: feed filter -- followed author events only.\n", .{});
    print("surf vantage: follow serialize roundtrip -- follow list survives persistence.\n", .{});
    print("surf vantage: relay publish encode -- PUBLISH frame roundtrips through decode.\n", .{});
    print("surf vantage: relay request encode -- REQUEST frame roundtrips through decode.\n", .{});
    print("surf vantage: relay events encode -- EVENTS frame roundtrips through decode.\n", .{});
    print("surf vantage: relay ack encode -- ACK frame roundtrips through decode.\n", .{});
    print("surf vantage: version {s}\n", .{bridge_version});
    print("GREEN: surf vantage -- FFI bridge: keypair, sign, verify, feed, follows, persistence, relay.\n", .{});
    return 0;
}

export fn surf_selftest() callconv(.c) i32 {
    return @intCast(run_selftest());
}

pub fn main(init: std.process.Init) !u8 {
    const allocator = init.arena.allocator();
    const args = try init.minimal.args.toSlice(allocator);
    if (args.len == 2 and std.mem.eql(u8, args[1], "selftest"))
        return run_selftest();
    if (args.len == 1) return run_selftest();
    print("usage: surf_vantage [selftest]\n", .{});
    return 1;
}
