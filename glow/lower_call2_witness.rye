//! glow/lower_call2_witness.rye -- proves `%+` lowers add/sub/mul to runnable `.rye`.
//!
//!   rye build glow/lower_call2_witness.rye -femit-bin=glow/bin/lower_call2_witness

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const lower = @import("lower_call2.rye");

const witness_version = "20261104.030000";

fn assert_contains(haystack: []const u8, needle: []const u8) void {
    assert(std.mem.indexOf(u8, haystack, needle) != null);
}

fn run_selftest(init: std.process.Init) !u8 {
    const io = init.io;
    const a = init.arena.allocator();
    const cwd = std.Io.Dir.cwd();
    var buf: [3072]u8 = undefined;

    // -- add gate --
    const n1 = try lower.lower_line_welcome("%+  add  from  amount", &buf);
    const rye1 = buf[0..n1];
    assert_contains(rye1, "fn add(left: u32, right: u32) u32");
    assert_contains(rye1, "return left +% right;");
    assert_contains(rye1, "const from: u32 = 5");
    assert_contains(rye1, "const amount: u32 = 3");
    assert_contains(rye1, "const called: u32 = add(from, amount)");
    assert_contains(rye1, "called == 8");
    print("lower: add welcome builds call -- GREEN\n", .{});

    const n2 = try lower.lower_line_unwelcome("%+  add  from  amount", &buf);
    assert(std.mem.indexOf(u8, buf[0..n2], "called == 9") != null);
    print("lower: add unwelcome expects mismatch -- GREEN\n", .{});

    // -- sub gate --
    const n3 = try lower.lower_line_welcome("%+  sub  from  amount", &buf);
    const rye3 = buf[0..n3];
    assert_contains(rye3, "fn sub(left: u32, right: u32) u32");
    assert_contains(rye3, "return left -% right;");
    assert_contains(rye3, "called == 2");
    print("lower: sub welcome builds call -- GREEN\n", .{});

    const n4 = try lower.lower_line_unwelcome("%+  sub  from  amount", &buf);
    assert(std.mem.indexOf(u8, buf[0..n4], "called == 3") != null);
    print("lower: sub unwelcome expects mismatch -- GREEN\n", .{});

    // -- mul gate --
    const n5 = try lower.lower_line_welcome("%+  mul  from  amount", &buf);
    const rye5 = buf[0..n5];
    assert_contains(rye5, "fn mul(left: u32, right: u32) u32");
    assert_contains(rye5, "return left *% right;");
    assert_contains(rye5, "called == 15");
    print("lower: mul welcome builds call -- GREEN\n", .{});

    const n6 = try lower.lower_line_unwelcome("%+  mul  from  amount", &buf);
    assert(std.mem.indexOf(u8, buf[0..n6], "called == 16") != null);
    print("lower: mul unwelcome expects mismatch -- GREEN\n", .{});

    // -- unknown gate refusal --
    if (lower.lower_line_welcome("%+  mystery  from  amount", &buf)) |_| {
        return error.UnknownGateNotCaught;
    } else |err| {
        if (err != lower.LowerError.UnknownGate) return err;
    }
    print("lower: unknown gate refused UnknownGate -- GREEN\n", .{});

    // -- write six .rye cache files --
    try cwd.createDirPath(io, "glow/.cache");

    const wa = try lower.lower_line_welcome("%+  add  from  amount", &buf);
    try cwd.writeFile(io, .{ .sub_path = "glow/.cache/call_two_add_welcome.rye", .data = buf[0..wa] });
    const ua = try lower.lower_line_unwelcome("%+  add  from  amount", &buf);
    try cwd.writeFile(io, .{ .sub_path = "glow/.cache/call_two_add_unwelcome.rye", .data = buf[0..ua] });

    const ws = try lower.lower_line_welcome("%+  sub  from  amount", &buf);
    try cwd.writeFile(io, .{ .sub_path = "glow/.cache/call_two_sub_welcome.rye", .data = buf[0..ws] });
    const us = try lower.lower_line_unwelcome("%+  sub  from  amount", &buf);
    try cwd.writeFile(io, .{ .sub_path = "glow/.cache/call_two_sub_unwelcome.rye", .data = buf[0..us] });

    const wm = try lower.lower_line_welcome("%+  mul  from  amount", &buf);
    try cwd.writeFile(io, .{ .sub_path = "glow/.cache/call_two_mul_welcome.rye", .data = buf[0..wm] });
    const um = try lower.lower_line_unwelcome("%+  mul  from  amount", &buf);
    try cwd.writeFile(io, .{ .sub_path = "glow/.cache/call_two_mul_unwelcome.rye", .data = buf[0..um] });
    print("lower: wrote six call2 .rye files under glow/.cache/ -- GREEN\n", .{});

    // -- read .glow gen programs --
    const gen_add = try cwd.readFileAlloc(io, "glow/gen/c/call-two.glow", a, .limited(4096));
    assert_contains(gen_add, "%+  add  from  amount");
    const gen_sub = try cwd.readFileAlloc(io, "glow/gen/c/call-two-sub.glow", a, .limited(4096));
    assert_contains(gen_sub, "%+  sub  from  amount");
    const gen_mul = try cwd.readFileAlloc(io, "glow/gen/c/call-two-mul.glow", a, .limited(4096));
    assert_contains(gen_mul, "%+  mul  from  amount");
    print("lower: .glow programs carry call faces -- GREEN\n", .{});

    print("lower: version {s}\n", .{witness_version});
    print("GREEN: `%+` lowers two-arg calls (add/sub/mul) to ordinary Rye (glow-language).\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    return run_selftest(init);
}
