//! glow/lower_call3.rye -- lower a parsed `%^` call to runnable `.rye`.
//!
//! Thin glow-language face: closed demo gates sum/sub/mul with demo atoms 5, 3,
//! 1. Gate dispatch is content-based; unknown gates refuse at lower time.

const std = @import("std");
const assert = std.debug.assert;
const r3 = @import("rune_call3.rye");
const refusal = @import("refusal.rye");
const zig_ident = @import("zig_ident.rye");

pub const LowerError = r3.ParseError || error{
    Overflow,
    EmptySource,
    BadIdent,
    UnknownGate,
};

pub const call3_demo_a: u32 = 5;
pub const call3_demo_b: u32 = 3;
pub const call3_demo_c: u32 = 1;

pub fn compute_expect(gate: []const u8, a: u32, b: u32, c: u32) LowerError!u32 {
    if (std.mem.eql(u8, gate, "sum")) return a +% b +% c;
    if (std.mem.eql(u8, gate, "sub")) return a -% b -% c;
    if (std.mem.eql(u8, gate, "mul")) return a *% b *% c;
    return error.UnknownGate;
}

fn gate_op(gate: []const u8) LowerError![]const u8 {
    if (std.mem.eql(u8, gate, "sum")) return "+%";
    if (std.mem.eql(u8, gate, "sub")) return "-%";
    if (std.mem.eql(u8, gate, "mul")) return "*%";
    return error.UnknownGate;
}

/// The one ident rule, reached through `glow/zig_ident.rye`. The ceiling is this module's
/// own `r3.max_name_len`; the rule -- hyphen to underscore, then Zig's own identifier bytes -- is
/// the room's, and stood in 29 copies before it moved.
fn zig_safe_ident(face: []const u8, out: *[r3.max_name_len]u8, field: []const u8) LowerError!u32 {
    var slot: refusal.Slot = null;
    // invariant: this entry keeps the parameters and the error name it always had, and it
    // answers the `u32` the rule itself answers rather than widening it to `usize` for the
    // caller -- a return width is authored API, where TAME asks a fixed width and leaves
    // `usize` at the seam; the record is dropped here because a caller wanting it reaches
    // `zig_ident.safe_ident` directly rather than through this module
    const n = try zig_ident.safe_ident(face, out[0..], r3.max_name_len, field, .refuse, &slot);
    // invariant: the rule wrote exactly the face it was handed, so the span below is the
    // caller's own length rather than a truncation the buffer would have hidden
    assert(n == face.len);
    return n;
}

fn emit_call3_program(
    glow_gate: []const u8,
    glow_a: []const u8,
    glow_b: []const u8,
    glow_c: []const u8,
    zig_gate: []const u8,
    zig_a: []const u8,
    zig_b: []const u8,
    zig_c: []const u8,
    expect: u32,
    out: []u8,
) LowerError!u32 {
    const op = gate_op(glow_gate) catch return error.UnknownGate;

    const written = std.fmt.bufPrint(out,
        \\const std = @import("std");
        \\
        \\/// Lowered from Glow `%^  {s}  {s}  {s}  {s}` -- three-arg call of demo gate.
        \\fn {s}(x: u32, y: u32, z: u32) u32 {{
        \\    return x {s} y {s} z;
        \\}}
        \\
        \\pub fn main(_: std.process.Init) !u8 {{
        \\    const {s}: u32 = {d};
        \\    const {s}: u32 = {d};
        \\    const {s}: u32 = {d};
        \\    const called: u32 = {s}({s}, {s}, {s});
        \\    return if (called == {d}) 0 else 1;
        \\}}
        \\
    , .{
        glow_gate,
        glow_a,
        glow_b,
        glow_c,
        zig_gate,
        op,
        op,
        zig_a,
        call3_demo_a,
        zig_b,
        call3_demo_b,
        zig_c,
        call3_demo_c,
        zig_gate,
        zig_a,
        zig_b,
        zig_c,
        expect,
    }) catch return error.Overflow;
    return @intCast(written.len);
}

fn lower_line(line: []const u8, welcome: bool, out: []u8) LowerError!u32 {
    const trimmed = std.mem.trim(u8, line, " \t\r\n");
    if (trimmed.len == 0) return error.EmptySource;
    const spec = try r3.parse(trimmed);
    const gate = r3.gate_slice(&spec);
    const a = r3.a_slice(&spec);
    const b = r3.b_slice(&spec);
    const c = r3.c_slice(&spec);
    var zg: [r3.max_name_len]u8 = undefined;
    var za: [r3.max_name_len]u8 = undefined;
    var zb: [r3.max_name_len]u8 = undefined;
    var zc: [r3.max_name_len]u8 = undefined;
    const gn = try zig_safe_ident(gate, &zg, "gate");
    const an = try zig_safe_ident(a, &za, "a");
    const bn = try zig_safe_ident(b, &zb, "b");
    const cn = try zig_safe_ident(c, &zc, "c");
    const base = compute_expect(gate, call3_demo_a, call3_demo_b, call3_demo_c) catch return error.UnknownGate;
    const expect: u32 = if (welcome) base else base +% 1;
    return emit_call3_program(
        gate,
        a,
        b,
        c,
        zg[0..gn],
        za[0..an],
        zb[0..bn],
        zc[0..cn],
        expect,
        out,
    );
}

pub fn lower_line_welcome(line: []const u8, out: []u8) LowerError!u32 {
    return lower_line(line, true, out);
}

pub fn lower_line_unwelcome(line: []const u8, out: []u8) LowerError!u32 {
    return lower_line(line, false, out);
}
